      const blob=new Blob([buffer],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
      const link=document.createElement('a');
      link.href=URL.createObjectURL(blob); link.download=`Report_${ctnType}_${Date.now()}.xlsx`; link.click();
      URL.revokeObjectURL(link.href);
      setReportProgress(100);
    } catch(err) {
      console.error(err);
      alert(lang==='zh'?'產生報告書時發生錯誤！':'エラーが発生しました！');
    } finally {
      setTimeout(()=>setIsReporting(false), 500);
    }
  };

  const doCalc = useCallback((deep) => {
    clearResult();
    setLoading(true);
    if (deep) { setGraspOn(true); setProgress(0); }
    const c = CONTAINERS[ctnType];
    const maxX = Math.max(0, c.w - rightGap);
    const maxY = Math.max(0, c.h - topGap);
    const maxZ = Math.max(0, c.d - doorGap);
    const thr  = suppPct / 100;
    if (workerRef.current) { workerRef.current.terminate(); }
    const blob = new Blob([WORKER_CODE], { type: 'application/javascript' });
    const url  = URL.createObjectURL(blob);
    const worker = new Worker(url);
    workerRef.current = worker;
    worker.onmessage = (e) => {
      if (e.data.type === 'progress') { setProgress(e.data.pct); }
      else if (e.data.type === 'done') {
