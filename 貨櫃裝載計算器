            <button onClick={()=>setTab(t=>Math.max(0,t-1))} disabled={tab===0} className="btn btn-ghost" style={{padding:'6px 12px'}}>◀ {zh?'上一頁':'前へ'}</button>
            <button onClick={()=>setTab(t=>Math.min(tabs.length-1,t+1))} disabled={tab===tabs.length-1} className="btn btn-ghost" style={{padding:'6px 12px'}}>{zh?'下一頁':'次へ'} ▶</button>
          </div>
          <span style={{fontSize:14,color:'var(--ink-ghost)'}}>{tab+1} / {tabs.length}</span>
          <button onClick={onClose} className="btn btn-ink">{zh?'關閉':'閉じる'}</button>
        </div>
      </div>
    </div>
