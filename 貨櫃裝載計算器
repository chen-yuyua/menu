// ── Pallet Preview Component (3D + dim lines) ────────
function PalletPreview({ palletDetail, t, lang }) {
  const [showDim, setShowDim] = useState(false);
  const mountRef = useRef(null);
  const rendererRef2 = useRef(null);
  const sceneRef2 = useRef(null);
  const camRef2 = useRef(null);
  const ctrlRef2 = useRef(null);
  const animRef2 = useRef(null);
  const dimGrpRef = useRef(null);

  if (!palletDetail || !palletDetail.layout) return null;

  const { layout, actualW, actualD, cornerPadThick, isSheet, boxColor, boxH, layers } = palletDetail;
  const pad = cornerPadThick || 0;
  // For 1030 pallet (pad=0), use 1030 as total size; for sheet pallet use actualW+pad*2
  const palletSize = (!isSheet && pad === 0) ? 1030 : 0;
  const totalW = palletSize > 0 ? palletSize : actualW + pad * 2;
  const totalD = palletSize > 0 ? palletSize : actualD + pad * 2;
  // Box offset within pallet (centred for 1030)
  const boxOffX = palletSize > 0 ? (1030 - actualW) / 2 : pad;
  const boxOffZ = palletSize > 0 ? (1030 - actualD) / 2 : pad;
  const boxHeight = boxH || 280;
  const numLayers = layers || 1;
  const totalH = boxHeight * numLayers;
  const basePalletH = isSheet ? 1.5 : 120;
  const fullH = totalH + basePalletH;
  const SIZE = 440;
  // first box dims
  const fb = layout && layout[0] ? layout[0] : null;

  const buildDimGroup = (THREE, showD) => {
    const grp = new THREE.Group();
    if (!showD) return grp;

    const addExtLine = (p1, p2, color) => {
      grp.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([p1.clone(), p2.clone()]),
        new THREE.LineBasicMaterial({ color: color, transparent: true, opacity: 0.45 })
      ));
    };

    // axis: 'W' labels go +Y above line, 'D' labels go +X beside line, 'H' labels go -X beside line
    const addDimLine = (p1, p2, label, color, axis) => {
      grp.add(new THREE.Line(
        new THREE.BufferGeometry().setFromPoints([p1.clone(), p2.clone()]),
        new THREE.LineBasicMaterial({ color: color, linewidth: 2 })
      ));
      const perp = (axis === 'H')
        ? new THREE.Vector3(0, 0, totalD * 0.025)
        : new THREE.Vector3(0, totalH * 0.025, 0);
      [p1, p2].forEach(function(pt) {
        grp.add(new THREE.Line(
          new THREE.BufferGeometry().setFromPoints([pt.clone().add(perp), pt.clone().sub(perp)]),
          new THREE.LineBasicMaterial({ color: color, linewidth: 1.5 })
        ));
      });
      const mid = new THREE.Vector3().addVectors(p1, p2).multiplyScalar(0.5);
      if (axis === 'W')      mid.y += totalH * 0.07;
      else if (axis === 'D') mid.x += totalW * 0.07;
      else if (axis === 'H') mid.x -= totalW * 0.14;
      const cv = document.createElement('canvas'); cv.width = 640; cv.height = 72;
      const ctx = cv.getContext('2d');
      ctx.font = 'bold 32px "Microsoft YaHei UI",sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      const tw = ctx.measureText(label).width;
      const px = 320-tw/2-10, py = 36-18, pw = tw+20, ph = 36, r = 6;
      ctx.fillStyle = 'rgba(250,250,248,0.94)';
      ctx.beginPath(); ctx.moveTo(px+r,py); ctx.lineTo(px+pw-r,py); ctx.quadraticCurveTo(px+pw,py,px+pw,py+r); ctx.lineTo(px+pw,py+ph-r); ctx.quadraticCurveTo(px+pw,py+ph,px+pw-r,py+ph); ctx.lineTo(px+r,py+ph); ctx.quadraticCurveTo(px,py+ph,px,py+ph-r); ctx.lineTo(px,py+r); ctx.quadraticCurveTo(px,py,px+r,py); ctx.closePath(); ctx.fill();
      const hexStr = '#' + color.toString(16).padStart(6, '0');
      ctx.lineWidth = 1.5; ctx.strokeStyle = hexStr; ctx.stroke();
      ctx.fillStyle = hexStr; ctx.fillText(label, 320, 36);
      const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(cv), transparent: true }));
      sp.scale.set(totalW * 0.85, totalW * 0.85 * (72/640), 1);
      sp.position.copy(mid);
      grp.add(sp);
    };

    const bx0 = boxOffX, bz0 = boxOffZ;
    const bx1 = boxOffX + actualW, bz1 = boxOffZ + actualD;
    const y0 = 0;
    const gapW1 = totalD * 0.14, gapW2 = totalD * 0.28, gapW3 = totalD * 0.42;
    const gapD1 = totalW * 0.14, gapD2 = totalW * 0.28, gapD3 = totalW * 0.42;

    // ── Width (X): innermost=single, mid=box group, outer=pallet ──
    const fbW = layout.reduce(function(best,b){return(b.z+b.d>best.z+best.d)?b:best;},layout[0]);
    if (fbW) {
      const zw1 = totalD + gapW1;
      addExtLine(new THREE.Vector3(bx0+fbW.x,y0,totalD), new THREE.Vector3(bx0+fbW.x,y0,zw1), 0x9a4a20);
      addExtLine(new THREE.Vector3(bx0+fbW.x+fbW.w,y0,totalD), new THREE.Vector3(bx0+fbW.x+fbW.w,y0,zw1), 0x9a4a20);
      addDimLine(new THREE.Vector3(bx0+fbW.x,y0,zw1), new THREE.Vector3(bx0+fbW.x+fbW.w,y0,zw1),
        (lang==='zh'?'單箱: ':'単箱: ')+Math.round(fbW.w)+'mm', 0x9a4a20, 'W');
    }
    const zw2 = totalD + gapW2;
    addExtLine(new THREE.Vector3(bx0,y0,totalD), new THREE.Vector3(bx0,y0,zw2), 0x3a6ea5);
    addExtLine(new THREE.Vector3(bx1,y0,totalD), new THREE.Vector3(bx1,y0,zw2), 0x3a6ea5);
    addDimLine(new THREE.Vector3(bx0,y0,zw2), new THREE.Vector3(bx1,y0,zw2),
      (lang==='zh'?'箱組: ':'箱組: ')+Math.round(actualW)+'mm', 0x3a6ea5, 'W');
    const zw3 = totalD + gapW3;
    addExtLine(new THREE.Vector3(0,y0,totalD), new THREE.Vector3(0,y0,zw3), 0xe06030);
    addExtLine(new THREE.Vector3(totalW,y0,totalD), new THREE.Vector3(totalW,y0,zw3), 0xe06030);
    addDimLine(new THREE.Vector3(0,y0,zw3), new THREE.Vector3(totalW,y0,zw3),
      (lang==='zh'?'棧板: ':'パレット: ')+Math.round(totalW)+'mm', 0xe06030, 'W');

    // ── Depth (Z): innermost=single, mid=box group, outer=pallet ──
    const fbD = layout.reduce(function(best,b){return(b.x+b.w>best.x+best.w)?b:best;},layout[0]);
    if (fbD) {
      const xd1 = totalW + gapD1;
      addExtLine(new THREE.Vector3(totalW,y0,bz0+fbD.z), new THREE.Vector3(xd1,y0,bz0+fbD.z), 0x9a4a20);
      addExtLine(new THREE.Vector3(totalW,y0,bz0+fbD.z+fbD.d), new THREE.Vector3(xd1,y0,bz0+fbD.z+fbD.d), 0x9a4a20);
      addDimLine(new THREE.Vector3(xd1,y0,bz0+fbD.z), new THREE.Vector3(xd1,y0,bz0+fbD.z+fbD.d),
        (lang==='zh'?'單箱: ':'単箱: ')+Math.round(fbD.d)+'mm', 0x9a4a20, 'D');
    }
    const xd2 = totalW + gapD2;
    addExtLine(new THREE.Vector3(totalW,y0,bz0), new THREE.Vector3(xd2,y0,bz0), 0x3a6ea5);
    addExtLine(new THREE.Vector3(totalW,y0,bz1), new THREE.Vector3(xd2,y0,bz1), 0x3a6ea5);
    addDimLine(new THREE.Vector3(xd2,y0,bz0), new THREE.Vector3(xd2,y0,bz1),
      (lang==='zh'?'箱組: ':'箱組: ')+Math.round(actualD)+'mm', 0x3a6ea5, 'D');
    const xd3 = totalW + gapD3;
    addExtLine(new THREE.Vector3(totalW,y0,0), new THREE.Vector3(xd3,y0,0), 0xe06030);
    addExtLine(new THREE.Vector3(totalW,y0,totalD), new THREE.Vector3(xd3,y0,totalD), 0xe06030);
    addDimLine(new THREE.Vector3(xd3,y0,0), new THREE.Vector3(xd3,y0,totalD),
      (lang==='zh'?'棧板: ':'パレット: ')+Math.round(totalD)+'mm', 0xe06030, 'D');

    // ── Height (Y): innermost=single box, mid=box stack, outer=full ──
    const xh0=-totalW*0.08, zh0=-totalD*0.08;
    const xh1=-totalW*0.18, zh1=-totalD*0.18;
    const xh2=-totalW*0.28, zh2=-totalD*0.28;
    addExtLine(new THREE.Vector3(0,basePalletH,0), new THREE.Vector3(xh0,basePalletH,zh0), 0x9a4a20);
    addExtLine(new THREE.Vector3(0,basePalletH+boxHeight,0), new THREE.Vector3(xh0,basePalletH+boxHeight,zh0), 0x9a4a20);
    addDimLine(new THREE.Vector3(xh0,basePalletH,zh0), new THREE.Vector3(xh0,basePalletH+boxHeight,zh0),
      (lang==='zh'?'單箱H: ':'単箱H: ')+Math.round(boxHeight)+'mm', 0x9a4a20, 'H');
    addExtLine(new THREE.Vector3(0,basePalletH,0), new THREE.Vector3(xh1,basePalletH,zh1), 0x3a6ea5);
    addExtLine(new THREE.Vector3(0,fullH,0), new THREE.Vector3(xh1,fullH,zh1), 0x3a6ea5);
    addDimLine(new THREE.Vector3(xh1,basePalletH,zh1), new THREE.Vector3(xh1,fullH,zh1),
      (lang==='zh'?'箱組H: ':'箱組H: ')+Math.round(totalH)+'mm', 0x3a6ea5, 'H');
    addExtLine(new THREE.Vector3(0,0,0), new THREE.Vector3(xh2,0,zh2), 0xe06030);
    addExtLine(new THREE.Vector3(0,fullH,0), new THREE.Vector3(xh2,fullH,zh2), 0xe06030);
    addDimLine(new THREE.Vector3(xh2,0,zh2), new THREE.Vector3(xh2,fullH,zh2),
      (lang==='zh'?'總高: ':'総高: ')+Math.round(fullH)+'mm', 0xe06030, 'H');

    return grp;
  };

