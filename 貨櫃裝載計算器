    controls.target.set(totalW / 2, fullH / 2, totalD / 2);
    controls.update();
    ctrlRef2.current = controls;

    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const dl = new THREE.DirectionalLight(0xffffff, 0.5);
    dl.position.set(totalW * 2, fullH * 3, totalD * 2);
    scene.add(dl);

    // Pallet base
    if (!isSheet) {
      const palMesh = new THREE.Mesh(
        new THREE.BoxGeometry(totalW, basePalletH, totalD),
        new THREE.MeshLambertMaterial({ color: 0xb08050 })
      );
      palMesh.position.set(totalW/2, basePalletH/2, totalD/2);
      scene.add(palMesh);
      palMesh.add(new THREE.LineSegments(
        new THREE.EdgesGeometry(palMesh.geometry),
        new THREE.LineBasicMaterial({ color: 0x6b4020, transparent: true, opacity: 0.6 })
      ));
    } else if (pad > 0) {
      const padColor = 0xa8a8a0;
      const padLen = 30;
      const bx0 = boxOffX, bz0 = boxOffZ;
      const bx1 = boxOffX + actualW, bz1 = boxOffZ + actualD;
      const corners = [
        [bx0-pad,0,bz0-pad,padLen,totalH,pad],[bx0-pad,0,bz0-pad,pad,totalH,padLen],
        [bx1+pad-padLen,0,bz0-pad,padLen,totalH,pad],[bx1,0,bz0-pad,pad,totalH,padLen],
        [bx0-pad,0,bz1,padLen,totalH,pad],[bx0-pad,0,bz1+pad-padLen,pad,totalH,padLen],
        [bx1+pad-padLen,0,bz1,padLen,totalH,pad],[bx1,0,bz1+pad-padLen,pad,totalH,padLen],
      ];
      corners.forEach(function(c) {
        const m = new THREE.Mesh(new THREE.BoxGeometry(c[3],c[4],c[5]), new THREE.MeshLambertMaterial({color:padColor}));
        m.position.set(c[0]+c[3]/2, basePalletH+c[4]/2, c[2]+c[5]/2);
        scene.add(m);
