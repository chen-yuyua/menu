  const [interlockFirst, setInterlockFirst] = useState(PS?.interlockFirst ?? false);
  const [interlockType,  setInterlockType]  = useState(PS?.interlockType || 'auto');
  const [xAlign, setXAlign] = useState(PS?.xAlign || 'center');
  const [boxes, setBoxes]   = useState(PS?.boxes?.map(b => b.calcMode === 'nominal' ? {...b, calcMode: 'mid'} : b) || [{id:uid(),name:'紙箱 A',cbType:'none',L:600,W:400,H:400,color:COLORS[0],qty:0,tolPlus:0,tolMinus:0,calcMode:'mid'}]);
  const [result, setResult] = useState({packed:[],stats:null});
  const [loading, setLoading]   = useState(false);
  const [graspOn, setGraspOn]   = useState(false);
  const [isReporting, setIsReporting] = useState(false);
  const [reportProgress, setReportProgress] = useState(0);
  const [progress, setProgress] = useState(0);
  const [step, setStep]         = useState(0);
  const [xray, setXray]         = useState(false);
  const [isPerspective, setIsPerspective] = useState(true);
  const [helpOpen, setHelpOpen]   = useState(false);
  const [fixOpen,  setFixOpen]    = useState(false);
  const [saveOpen, setSaveOpen]   = useState(false);
  const [showPreloadBanner, setShowPreloadBanner] = useState(!!PS);
  const [interlockWarn, setInterlockWarn] = useState(false);

  const workerRef = useRef(null);

  const clearResult = useCallback(() => { setResult({packed:[],stats:null}); setStep(0); }, []);

  const canvasRef    = useRef(null);
  const meshesRef    = useRef([]);
  const dimRef       = useRef(null);
  const camRef       = useRef(null);
  const ctrlRef      = useRef(null);
  const sceneRef     = useRef(null);
  const rendererRef  = useRef(null);
  const meshGroupRef = useRef(null);

  const compassRef = useRef(null);
  const compassRendererRef = useRef(null);
  const compassSceneRef = useRef(null);
  const compassCameraRef = useRef(null);

  const doSaveHtml = useCallback(() => {
    const state = { lang, ctnType, doorGap, innerGap, rightGap, topGap, suppPct, strat, boxes, isJapanBound, palletType, interlockFirst, interlockType, xAlign };
    const stateJson = JSON.stringify(state);
    const htmlSource = document.documentElement.outerHTML;
    const newScript = `<script id="preloaded-state">\n  window.PRELOADED_STATE = ${stateJson};\n  <\/script>`;
    const updatedHtml = htmlSource.replace(/<script id="preloaded-state">[\s\S]*?<\/script>/, newScript);
    const blob = new Blob(['<!DOCTYPE html>\n' + updatedHtml], {type:'text/html;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `Container_Settings_${ctnType}_${new Date().toISOString().slice(0,10).replace(/-/g,'')}.html`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
  }, [lang, ctnType, doorGap, innerGap, rightGap, topGap, suppPct, strat, boxes, isJapanBound, palletType, interlockFirst, interlockType, xAlign]);

  const doShot = () => {
    const el=document.getElementById('app-root');
    if(window.htmlToImage) window.htmlToImage.toJpeg(el,{quality:.95,backgroundColor:'#ffffff',pixelRatio:2}).then(url=>{const a=document.createElement('a');a.download='Container_'+Date.now()+'.jpg';a.href=url;a.click();});
  };

  const doReport = async () => {
    if (!window.ExcelJS) { alert(lang==='zh'?'尚未載入 Excel 套件！':'Excelモジュール未読み込み'); return; }
    setIsReporting(true); setReportProgress(0);
    await new Promise(r=>setTimeout(r, 50));
    try {
      const c = CONTAINERS[ctnType];
      const maxX = Math.max(0,c.w-rightGap), maxY = Math.max(0,c.h-topGap), maxZ = Math.max(0,c.d-doorGap);
      const thr = suppPct/100;
      setReportProgress(10);

      let imgBase64=null, rawImgW=800, rawImgH=500;
      if(rendererRef.current && sceneRef.current && camRef.current){
        rendererRef.current.render(sceneRef.current, camRef.current);
        const canvasEl = rendererRef.current.domElement;
        imgBase64 = canvasEl.toDataURL("image/jpeg",0.95);
        rawImgW = canvasEl.width; rawImgH = canvasEl.height;
      }
      setReportProgress(20);
      await new Promise(r=>setTimeout(r,10));

      const runWorkerSim = (testBoxes) => {
        return new Promise((resolve, reject) => {
          const blob = new Blob([WORKER_CODE], { type: 'application/javascript' });
          const url  = URL.createObjectURL(blob);
          const worker = new Worker(url);
          worker.onmessage = (e) => {
            if (e.data.type === 'done') {
              worker.terminate(); URL.revokeObjectURL(url);
              resolve(e.data);
            }
          };
          worker.onerror = (err) => {
            worker.terminate(); URL.revokeObjectURL(url);
            reject(err);
          };
          worker.postMessage({ boxes: testBoxes, innerGap, maxX, maxY, maxZ, strat, thresh: thr, isJapanBound, palletType, interlockFirst, interlockType, xAlign, ITER: 1 });
        });
      };

      const runModeForReport = async (mode) => {
        const testBoxes = boxes.map(b=>Object.assign({},b,{calcMode:mode}));
        const res = await runWorkerSim(testBoxes);
        const best = res.packed || [];
        let vol=0; const counts={};
        best.forEach(p=>{if(p.isPallet||p.isPad) return; vol+=p.w*p.h*p.d; counts[p.typeId]=(counts[p.typeId]||0)+1;});
        const rem={w:getGaps(best,c,'X',maxX),h:getGaps(best,c,'Y',maxY),d:getGaps(best,c,'Z',maxZ)};
        return {total:Object.values(counts).reduce((a,b)=>a+b,0),counts,rem};
      };

      const resMax = await runModeForReport('max'); setReportProgress(40); await new Promise(r=>setTimeout(r,10));
      const resMid = await runModeForReport('mid'); setReportProgress(60); await new Promise(r=>setTimeout(r,10));
      const resMin = await runModeForReport('min'); setReportProgress(75); await new Promise(r=>setTimeout(r,10));

      const wb = new window.ExcelJS.Workbook();
      const ws = wb.addWorksheet('分析レポート');
      const fontBase={name:'BIZ UDPゴシック',size:11}, fontBold={name:'BIZ UDPゴシック',size:11,bold:true}, fontTitle={name:'BIZ UDPゴシック',size:14,bold:true,color:{argb:'FFFFFFFF'}};
      const setCell=(cell,value,font,fill,align,border)=>{cell.value=value;if(font)cell.font=font;if(fill)cell.fill={type:'pattern',pattern:'solid',fgColor:{argb:fill}};cell.alignment=align||{vertical:'middle',horizontal:'center'};if(border)cell.border={top:{style:'thin'},left:{style:'thin'},bottom:{style:'thin'},right:{style:'thin'}};};
      ws.mergeCells('A1:G1'); setCell(ws.getCell('A1'),'コンテナ積載分析レポート',fontTitle,'FF2563EB',{vertical:'middle',horizontal:'center'},false); ws.getRow(1).height=30; ws.addRow([]);
      ws.getCell('A3').value='【コンテナ設定】'; ws.getCell('A3').font=fontBold;
      const rowCtnHead=ws.addRow(['コンテナ種類','支持面積しきい値','最奥部余白','ドア側余白','右側余白','上部余白']);
      rowCtnHead.eachCell(c=>setCell(c,c.value,fontBold,'FFE2EFDA',null,true));
      let ctnName=ctnType==='20GP'?"20フィート標準（20' GP）":(ctnType==='40GP'?"40フィート標準（40' GP）":"40フィートHQ（40' HQ）");
      const rowCtnVal=ws.addRow([ctnName,suppPct+'%',innerGap+' mm',doorGap+' mm',rightGap+' mm',topGap+' mm']);
      rowCtnVal.eachCell(c=>setCell(c,c.value,fontBase,null,null,true));
      ws.addRow([]);
      const boxStartRow=ws.rowCount+1;
      ws.getCell(`A${boxStartRow}`).value='【箱寸法設定 (mm)】'; ws.getCell(`A${boxStartRow}`).font=fontBold;
      const rowBoxHead=ws.addRow(['箱の名称','ダンボール種類','内寸（L × W × H）','外寸：最大','外寸：中間値','外寸：最小']);
      rowBoxHead.eachCell(c=>setCell(c,c.value,fontBold,'FFE2EFDA',null,true));
      boxes.forEach(b=>{
        const cb=CARDBOARD_TYPES[b.cbType||'none']||CARDBOARD_TYPES['none'];
        const bL=b.L+cb.L,bW=b.W+cb.W,bH=b.H+cb.H;
        const calcSz=(mode)=>{let l=bL,w=bW,h=bH;if(mode==='max'){l+=b.tolPlus;w+=b.tolPlus;h+=b.tolPlus;}else if(mode==='min'){l-=b.tolMinus;w-=b.tolMinus;h-=b.tolMinus;}else if(mode==='mid'){const d=(b.tolPlus-b.tolMinus)/2;l+=d;w+=d;h+=d;}return`${l} × ${w} × ${h}`;};
        const r=ws.addRow([b.name,(b.cbType==='none'?'なし':b.cbType+'段'),`${b.L} × ${b.W} × ${b.H}`,calcSz('max'),calcSz('mid'),calcSz('min')]);
        r.eachCell(c=>setCell(c,c.value,fontBase,null,null,true));
      });
      ws.addRow([]);
      const resultStartRow=ws.rowCount+1;
      ws.getCell(`A${resultStartRow}`).value='【積載と残りスペース比較】'; ws.getCell(`A${resultStartRow}`).font=fontBold;
      const header=['計算基準',...boxes.map(b=>b.name+'\n(積載数量)'),'総積載箱数','奥行(Z)\n(実隙間/余白含)','幅(X)\n(実隙間/余白含)','高さ(Y)\n(実隙間/余白含)'];
      const rowResHead=ws.addRow(header);
      rowResHead.eachCell(c=>setCell(c,c.value,fontBold,'FFD9E1F2',{vertical:'middle',horizontal:'center',wrapText:true},true)); rowResHead.height=30;
      const fmtGaps=(gaps,gv)=>(!gaps||!gaps.length)?'0 mm\n(0 mm)':gaps.map(g=>`${g} mm\n(${g+gv} mm)`).join('\n');
      const modes=[{key:'max',text:'最大（正公差）',data:resMax,color:'FFFFE6E6'},{key:'mid',text:'中間値',data:resMid,color:'FFFFF9E6'},{key:'min',text:'最小（負公差）',data:resMin,color:'FFE6F9EE'}];
      modes.forEach(m=>{
        const row=ws.addRow([m.text,...boxes.map(b=>(m.data.counts[b.id]||0)+' 箱'),m.data.total+' 箱',fmtGaps(m.data.rem.d,doorGap),fmtGaps(m.data.rem.w,rightGap),fmtGaps(m.data.rem.h,topGap)]);
        row.eachCell(c=>setCell(c,c.value,fontBase,m.color,{vertical:'middle',horizontal:'center',wrapText:true},true));
        const maxLines=Math.max(m.data.rem.d.length*2,m.data.rem.w.length*2,m.data.rem.h.length*2,2);
        row.height=maxLines*15+10;
      });
      const skipRows=new Set([1,3,boxStartRow,resultStartRow]);
      let imgStartRow=-1;
      if(imgBase64){
        const imgId=wb.addImage({base64:imgBase64,extension:'jpeg'});
        imgStartRow=ws.rowCount+2;
        skipRows.add(imgStartRow);
        ws.getCell(`A${imgStartRow}`).value='【3D 積載参考図（現在の視点）】'; ws.getCell(`A${imgStartRow}`).font=fontBold;
        const targetWidth=800, targetHeight=targetWidth*(rawImgH/rawImgW);
        ws.addImage(imgId,{tl:{col:0,row:imgStartRow},ext:{width:targetWidth,height:targetHeight}});
      }
      ws.columns.forEach((col)=>{
        let maxLen=0;
        col.eachCell({includeEmpty:true},cell=>{
          if(skipRows.has(cell.row)) return;
          const val=cell.value?cell.value.toString():'';
          val.split('\n').forEach(l=>{let len=0;for(let j=0;j<l.length;j++)len+=l.charCodeAt(j)>255?2.2:1.2;if(len>maxLen)maxLen=len;});
        });
