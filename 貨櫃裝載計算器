<script type="text/babel">
const { useState, useEffect, useRef, useCallback, useMemo } = React;

let _uidCounter = 1;
const uid = () => 'box_' + (_uidCounter++).toString(36).padStart(4,'0');
const EPS = 0.5;

const CONTAINERS = {
  '20GP': {id:'20GP', w:2330, h:2350, d:5867},
  '40GP': {id:'40GP', w:2330, h:2350, d:11998},
  '40HQ': {id:'40HQ', w:2330, h:2655, d:11998}
};

const CARDBOARD_TYPES = {
  'none': { L:0, W:0, H:0 },
  'AB':   { L:15, W:15, H:30 },
  'A':    { L:10, W:10, H:20 },
  'B':    { L:6,  W:6,  H:12 },
  'EB':   { L:9,  W:9,  H:18 },
  'E':    { L:3,  W:3,  H:6  }
};

const COLORS = ['#3b82f6','#ef4444','#10b981','#f59e0b','#8b5cf6','#ec4899','#06b6d4'];
const APP_VER = '2.3';
const APP_DATE = '2026/03/28';

const WORKER_CODE = `
const EPS = 0.5;
const CARDBOARD_TYPES = {
  'none':{L:0,W:0,H:0},'AB':{L:15,W:15,H:30},'A':{L:10,W:10,H:20},
  'B':{L:6,W:6,H:12},'EB':{L:9,W:9,H:18},'E':{L:3,W:3,H:6}
};

function isColliding(x,y,z,w,h,d,packed){
  for(const b of packed){if(!(x>=b.x+b.w-EPS||x+w<=b.x+EPS||y>=b.y+b.h-EPS||y+h<=b.y+EPS||z>=b.z+b.d-EPS||z+d<=b.z+EPS))return true;}return false;
}
function isSupported(x,y,z,w,h,d,packed,thresh){
  if(y<EPS)return true;let area=0;
  for(const b of packed){if(Math.abs((b.y+b.h)-y)<EPS){const ix1=Math.max(x,b.x),iz1=Math.max(z,b.z),ix2=Math.min(x+w,b.x+b.w),iz2=Math.min(z+d,b.z+b.d);if(ix1<ix2-EPS&&iz1<iz2-EPS)area+=(ix2-ix1)*(iz2-iz1);}}
  return area/(w*d)>=thresh;
}
function getOrientations(b,strat){
  const u=new Set(),res=[];
  for(const p of [[b.w,b.h,b.d],[b.d,b.h,b.w]]){const k=Math.round(p[0])+','+Math.round(p[1])+','+Math.round(p[2]);if(!u.has(k)){u.add(k);let pref=true;if(strat==='length'&&Math.abs(p[2]-b.d)>EPS)pref=false;if(strat==='width'&&Math.abs(p[2]-b.w)>EPS)pref=false;res.push({w:p[0],h:p[1],d:p[2],pref});}}return res;
}
function dedupPoints(pts){const s=new Set(),r=[];for(const p of pts){const k=Math.round(p.x)+','+Math.round(p.y)+','+Math.round(p.z);if(!s.has(k)){s.add(k);r.push(p);}}return r;}
function ptInsideBox(p,b){return p.x>b.x+EPS&&p.x<b.x+b.w-EPS&&p.y>b.y+EPS&&p.y<b.y+b.h-EPS&&p.z>b.z+EPS&&p.z<b.z+b.d-EPS;}

function simulate(boxTypes,innerGap,maxX,maxY,maxZ,strat,thresh,randomize){
  let pts=[{x:0,y:0,z:innerGap}],packed=[];
  const finInv=[],infInv=[];
  boxTypes.forEach(b=>{
    const cb=CARDBOARD_TYPES[b.cbType||'none']||CARDBOARD_TYPES['none'];
    let aL=b.L+cb.L,aW=b.W+cb.W,aH=b.H+cb.H;
    if(b.calcMode==='max'){aL+=b.tolPlus;aW+=b.tolPlus;aH+=b.tolPlus;}
    else if(b.calcMode==='min'){aL-=b.tolMinus;aW-=b.tolMinus;aH-=b.tolMinus;}
    else if(b.calcMode==='mid'){const d=(b.tolPlus-b.tolMinus)/2;aL+=d;aW+=d;aH+=d;}
    const item=Object.assign({},b,{w:aW,h:aH,d:aL});
    if(b.qty>0){item.remaining=b.qty;finInv.push(item);}else{item.remaining=Infinity;infInv.push(item);}
  });
  let count=0;
  for(const inv of [finInv,infInv]){
    if(!inv.length)continue;let canPack=true;
    while(canPack&&count<3000){
      canPack=false;
      pts.sort((a,b)=>{if(Math.abs(a.z-b.z)>1)return a.z-b.z;if(randomize&&Math.random()<0.45)return Math.random()<0.5?(Math.abs(a.x-b.x)>1?a.x-b.x:a.y-b.y):(Math.abs(a.y-b.y)>1?a.y-b.y:a.x-b.x);return Math.abs(a.y-b.y)>1?a.y-b.y:a.x-b.x;});
      for(const pt of pts){
        let bIdx=-1,bOri=null,bVol=-1,bFit=-1,bD=-1,bPref=false;
        let idx=inv.map((_,i)=>i);
        if(randomize){for(let i=idx.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));let tmp=idx[i];idx[i]=idx[j];idx[j]=tmp;}}
        for(const i of idx){
          const box=inv[i];if(box.remaining<=0)continue;
          let cs=strat;if(randomize&&Math.random()>0.65)cs=Math.random()>0.5?'length':'width';
          for(const ori of getOrientations(box,cs)){
            if(pt.x+ori.w>maxX+EPS||pt.y+ori.h>maxY+EPS||pt.z+ori.d>maxZ+EPS)continue;
            if(!isColliding(pt.x,pt.y,pt.z,ori.w,ori.h,ori.d,packed)&&isSupported(pt.x,pt.y,pt.z,ori.w,ori.h,ori.d,packed,thresh)){
              const vol=ori.w*ori.h*ori.d,fit=Math.floor((maxX-pt.x)/ori.w)*Math.floor((maxY-pt.y)/ori.h)*Math.floor((maxZ-pt.z)/ori.d);
              let ev=randomize?vol*(1+(Math.random()*0.16-0.08)):vol,better=false;
              if(bIdx===-1)better=true;
              else if(ori.pref&&!bPref)better=true;
              else if(!ori.pref&&bPref)better=false;
              else if(ev>bVol)better=true;
              else if(ev===bVol&&fit>bFit)better=true;
              else if(ev===bVol&&fit===bFit&&ori.d>bD)better=true;
              if(better){bVol=ev;bFit=fit;bD=ori.d;bIdx=i;bOri=ori;bPref=ori.pref;}
            }
          }
        }
        if(bIdx!==-1){
          const bb=inv[bIdx];
          packed.push({x:pt.x,y:pt.y,z:pt.z,w:bOri.w,h:bOri.h,d:bOri.d,color:bb.color,typeId:bb.id,name:bb.name});
          bb.remaining--;count++;canPack=true;
          pts.push({x:pt.x+bOri.w,y:pt.y,z:pt.z},{x:pt.x,y:pt.y+bOri.h,z:pt.z},{x:pt.x,y:pt.y,z:pt.z+bOri.d});
          pts=pts.filter(p=>p!==pt&&p.x<maxX-EPS&&p.y<maxY-EPS&&p.z<maxZ-EPS&&!packed.some(b=>ptInsideBox(p,b)));
          pts=dedupPoints(pts);break;
        }
      }
    }
  }
  return packed;
}

function simulateJapanPallet(boxTypes, innerGap, maxX, maxY, maxZ, palletType, interlockFirst) {
    let box = null;
    for (let b of boxTypes) {
        const cb = CARDBOARD_TYPES[b.cbType || 'none'] || CARDBOARD_TYPES['none'];
        let aL = b.L + cb.L, aW = b.W + cb.W, aH = b.H + cb.H;
        if(b.calcMode==='max'){aL+=b.tolPlus;aW+=b.tolPlus;aH+=b.tolPlus;}
        else if(b.calcMode==='min'){aL-=b.tolMinus;aW-=b.tolMinus;aH-=b.tolMinus;}
        else if(b.calcMode==='mid'){const d=(b.tolPlus-b.tolMinus)/2;aL+=d;aW+=d;aH+=d;}
        box = Object.assign({},b,{ w: aW, h: aH, d: aL, remaining: b.qty > 0 ? b.qty : Infinity });
        break;
    }
    if (!box) return [];

    const availZ = maxZ - innerGap;
    const isSheet = palletType === 'sheet';
    const basePalletH = isSheet ? 15 : 120;
    const cornerPadThick = isSheet ? 5 : 0;

    let sheetMaxW = 1160;
    let numZ = Math.max(1, Math.floor(availZ / sheetMaxW));
    let sheetMaxD = Math.floor(availZ / numZ);

    let maxPatW = isSheet ? sheetMaxW - cornerPadThick*2 : 1030;
    let maxPatD = isSheet ? sheetMaxD - cornerPadThick*2 : 1030;

    const effectiveH = maxY - basePalletH;
    if (effectiveH < box.h) return []; 

    let layersPerUnit = 1;
    if (isSheet) {
        let halfH = Math.floor(maxY / 2);
        let calcLayers = Math.floor((halfH - basePalletH) / box.h);
        layersPerUnit = Math.max(1, calcLayers);
    } else {
        let calcLayers = Math.floor((maxY - basePalletH) / box.h);
        layersPerUnit = Math.max(1, calcLayers);
    }

    let unitH_boxes = layersPerUnit * box.h;
    let unitH_total = unitH_boxes + basePalletH;

    function generateAllPatterns(L, W, maxW, maxD) {
      if (L <= 0 || W <= 0) return [];
      const maxArea = maxW * maxD;
      let patterns = [];

      const addPat = (layout, uW, uD, isInterlock) => {
          if (uW <= maxW + EPS && uD <= maxD + EPS) patterns.push({layout: layout, uW: uW, uD: uD, isInterlock: isInterlock||false});
      };

      const fill = (w, d, ox, oz, boxL, boxW) => {
          let nx = Math.floor((w + EPS) / boxL);
          let nz = Math.floor((d + EPS) / boxW);
          let arr = [];
          for(let i=0; i<nx; i++)
              for(let j=0; j<nz; j++)
                  arr.push({x: ox + i*boxL, z: oz + j*boxW, w: boxL, d: boxW});
          return arr;
      };

      const maxNX = Math.floor(maxW / Math.min(L, W)) + 1;
      const maxNZ = Math.floor(maxD / Math.min(L, W)) + 1;

      for(let nx=1; nx<=maxNX && nx*L<=maxW+EPS; nx++) {
          for(let nz=1; nz<=maxNZ && nz*W<=maxD+EPS; nz++) {
              if(nx*L * nz*W > maxArea * 1.1) break; 
              addPat(fill(nx*L, nz*W, 0, 0, L, W), nx*L, nz*W, false);
          }
      }
      for(let nx=1; nx<=maxNX && nx*W<=maxW+EPS; nx++) {
          for(let nz=1; nz<=maxNZ && nz*L<=maxD+EPS; nz++) {
              if(nx*W * nz*L > maxArea * 1.1) break;
              addPat(fill(nx*W, nz*L, 0, 0, W, L), nx*W, nz*L, false);
          }
      }

      for(let nz1=1; nz1<=maxNZ && nz1*L<=maxD+EPS; nz1++) {
          for(let nz2=1; nz2<=maxNZ && nz2*W<=maxD+EPS; nz2++) {
              if (Math.abs(nz1*L - nz2*W) < EPS) {
                  let depth = nz1*L;
                  for(let nx1=1; nx1*W<=maxW+EPS; nx1++) {
                      for(let nx2=1; nx1*W + nx2*L<=maxW+EPS; nx2++) {
                          if(depth * (nx1*W + nx2*L) > maxArea * 1.1) break;
                          let p = fill(nx1*W, depth, 0, 0, W, L).concat(fill(nx2*L, depth, nx1*W, 0, L, W));
                          addPat(p, nx1*W + nx2*L, depth, true);
                      }
                  }
              }
          }
      }

      for(let nx1=1; nx1*W<=maxW+EPS; nx1++) {
          for(let nx2=1; nx2*L<=maxW+EPS; nx2++) {
              if (Math.abs(nx1*W - nx2*L) < EPS) {
                  let width = nx1*W;
                  for(let nz1=1; nz1*L<=maxD+EPS; nz1++) {
                      for(let nz2=1; nz1*L + nz2*W<=maxD+EPS; nz2++) {
                          if(width * (nz1*L + nz2*W) > maxArea * 1.1) break;
                          let p = fill(width, nz1*L, 0, 0, W, L).concat(fill(width, nz2*W, 0, nz1*L, L, W));
                          addPat(p, width, nz1*L + nz2*W, true);
                      }
                  }
              }
          }
      }

      for (let k = 1; k <= 4; k++) {
          let L1 = L, W1 = k * W;
          if (L1 + W1 <= Math.min(maxW, maxD) + EPS) {
              const pwSize = L1 + W1;
              for(let nx=1; nx*pwSize<=maxW+EPS; nx++) {
                  for(let nz=1; nz*pwSize<=maxD+EPS; nz++) {
                      if(nx*pwSize * nz*pwSize > maxArea * 1.1) break;
                      let p = [];
                      for(let i=0;i<nx;i++) {
                          for(let j=0;j<nz;j++) {
                              let ox = i*pwSize, oz = j*pwSize;
                              p.push(...fill(W1, L1, ox, oz, W, L));
                              p.push(...fill(L1, W1, ox, oz+L1, L, W));
                              p.push(...fill(W1, L1, ox+L1, oz+W1, W, L));
                              p.push(...fill(L1, W1, ox+W1, oz, L, W));
                          }
                      }
                      addPat(p, nx*pwSize, nz*pwSize, true);
                  }
              }
          }
          let L2 = k * L, W2 = W;
          if (L2 + W2 <= Math.min(maxW, maxD) + EPS) {
              const pwSize = L2 + W2;
              for(let nx=1; nx*pwSize<=maxW+EPS; nx++) {
                  for(let nz=1; nz*pwSize<=maxD+EPS; nz++) {
                      if(nx*pwSize * nz*pwSize > maxArea * 1.1) break;
                      let p = [];
                      for(let i=0;i<nx;i++) {
                          for(let j=0;j<nz;j++) {
                              let ox = i*pwSize, oz = j*pwSize;
                              p.push(...fill(W2, L2, ox, oz, W, L));
                              p.push(...fill(L2, W2, ox, oz+L2, L, W));
                              p.push(...fill(W2, L2, ox+L2, oz+W2, W, L));
                              p.push(...fill(L2, W2, ox+W2, oz, L, W));
                          }
                      }
                      addPat(p, nx*pwSize, nz*pwSize, true);
                  }
              }
          }
      }

      let rotated = [];
      for (let pat of patterns) {
          if (pat.uD <= maxW + EPS && pat.uW <= maxD + EPS) {
              rotated.push({
                  layout: pat.layout.map(p=>{ return {x:p.z,z:p.x,w:p.d,d:p.w}; }),
                  uW: pat.uD, uD: pat.uW,
                  isInterlock: pat.isInterlock
              });
          }
      }
      patterns = patterns.concat(rotated);

      let uniquePats = [];
      let sigs = new Set();
      for(let pat of patterns) {
          const layoutSig = pat.layout.map(b=> Math.round(b.x)+','+Math.round(b.z)+','+Math.round(b.w)+','+Math.round(b.d) ).sort().join('|');
          const sig = Math.round(pat.uW)+'_'+Math.round(pat.uD)+'_'+layoutSig;
          if (!sigs.has(sig)) {
              sigs.add(sig);
              uniquePats.push(pat);
          }
      }
      return uniquePats;
    }

    let patterns = generateAllPatterns(box.d, box.w, maxPatW, maxPatD);
    if (!patterns.length) return [];

    let hasInterlock = false;
    for(let p of patterns) if(p.isInterlock) hasInterlock = true;
    let requireInterlock = interlockFirst && hasInterlock;

    let maxBoxesPerLayer = 0;
    for (let pat of patterns) {
        if (requireInterlock && !pat.isInterlock) continue;
        if (pat.layout.length > maxBoxesPerLayer) maxBoxesPerLayer = pat.layout.length;
    }

    let bestPat = null;
    let bestIsInterlock = false;
    let maxTotalBoxes = -1;
    let bestShortSideCount = -1;

    let unitTotalW = isSheet ? sheetMaxW : 1030;
    let unitTotalD = isSheet ? sheetMaxD : 1030;

    let maxUnitsX = Math.floor((maxX + EPS) / unitTotalW);
    let maxUnitsZ = Math.floor((availZ + EPS) / unitTotalD);
    let maxUnitsY = Math.floor((maxY + EPS) / unitH_total);

    if (maxUnitsX <= 0 || maxUnitsZ <= 0 || maxUnitsY <= 0) return [];

    for (let pat of patterns) {
        if (requireInterlock && !pat.isInterlock) continue;
        if (pat.layout.length < maxBoxesPerLayer) continue;
        
        let totalUnits = maxUnitsX * maxUnitsZ * maxUnitsY;
        let boxesPerUnit = pat.layout.length * layersPerUnit;
        let totalBoxes = totalUnits * boxesPerUnit;
        if (box.remaining !== Infinity && totalBoxes > box.remaining) totalBoxes = box.remaining;
        
        let shortSides = 0;
        for(let b of pat.layout) if(b.w < b.d) shortSides++;
        shortSides = shortSides * layersPerUnit * totalUnits;
        
        let replace = false;
        if (!bestPat) {
            replace = true;
        } else {
            if (interlockFirst) {
                if (pat.isInterlock && !bestIsInterlock) replace = true;
                else if (pat.isInterlock === bestIsInterlock) {
                    if (totalBoxes > maxTotalBoxes) replace = true;
                    else if (totalBoxes === maxTotalBoxes && shortSides > bestShortSideCount) replace = true;
                }
            } else {
                if (totalBoxes > maxTotalBoxes) replace = true;
                else if (totalBoxes === maxTotalBoxes && shortSides > bestShortSideCount) replace = true;
            }
        }

        if (replace) {
            maxTotalBoxes = totalBoxes;
            bestShortSideCount = shortSides;
            bestIsInterlock = pat.isInterlock;
            bestPat = pat;
        }
    }

    if (!bestPat) return [];

    const palletDetail = {
        boxesPerLayer: bestPat.layout.length,
        layers: layersPerUnit,
        totalPallets: maxUnitsX * maxUnitsZ * maxUnitsY
    };

    let finalPacked = [];
    finalPacked._palletDetail = palletDetail;

    let boxesLeft = box.remaining;

    for (let y = 0; y < maxUnitsY; y++) {
        for (let z = 0; z < maxUnitsZ; z++) {
            for (let x = 0; x < maxUnitsX; x++) {
                if (boxesLeft <= 0) break;

                let px = maxUnitsX > 1 ? x * ((maxX - unitTotalW) / (maxUnitsX - 1)) : (maxX - unitTotalW) / 2;
                let pz = innerGap + z * unitTotalD;
                let py = y * unitH_total;

                let packMinX=Infinity, packMinZ=Infinity, packMaxX=0, packMaxZ=0;
                for (let b of bestPat.layout) {
                    if (b.x < packMinX) packMinX = b.x;
                    if (b.z < packMinZ) packMinZ = b.z;
                    if (b.x + b.w > packMaxX) packMaxX = b.x + b.w;
                    if (b.z + b.d > packMaxZ) packMaxZ = b.z + b.d;
                }
                let actualW = packMaxX - packMinX;
                let actualD = packMaxZ - packMinZ;
                let innerOffsetX = (unitTotalW - actualW) / 2 - packMinX;
                let innerOffsetZ = (unitTotalD - actualD) / 2 - packMinZ;
                let bx0 = px + innerOffsetX + packMinX;
                let bz0 = pz + innerOffsetZ + packMinZ;
                let bx1 = bx0 + actualW;
                let bz1 = bz0 + actualD;

                if (isSheet) {
                    finalPacked.push({isPallet:true,x:bx0-cornerPadThick,y:py,z:bz0-cornerPadThick,w:actualW+cornerPadThick*2,h:basePalletH,d:actualD+cornerPadThick*2,color:'#cbd5e1',typeId:'pallet',name:'Sheet Pallet'});
                    let padH=unitH_boxes, padC='#94a3b8', pN='Corner Pad', th=cornerPadThick, len=30;
                    [[bx0-th,py+basePalletH,bz0-th,len,padH,th],[bx0-th,py+basePalletH,bz0-th,th,padH,len],
                     [bx1+th-len,py+basePalletH,bz0-th,len,padH,th],[bx1,py+basePalletH,bz0-th,th,padH,len],
                     [bx0-th,py+basePalletH,bz1,len,padH,th],[bx0-th,py+basePalletH,bz1+th-len,th,padH,len],
                     [bx1+th-len,py+basePalletH,bz1,len,padH,th],[bx1,py+basePalletH,bz1+th-len,th,padH,len]
                    ].forEach(arr=>finalPacked.push({isPallet:true,isPad:true,x:arr[0],y:arr[1],z:arr[2],w:arr[3],h:arr[4],d:arr[5],color:padC,typeId:'pad',name:pN}));
                } else {
                    finalPacked.push({isPallet:true,x:px,y:py,z:pz,w:1030,h:basePalletH,d:1030,color:'#b45309',typeId:'pallet',name:'Pallet 1030x1030'});
                }

                for (let l = 0; l < layersPerUnit; l++) {
                    for (let pos of bestPat.layout) {
                        if (boxesLeft <= 0) break;
                        finalPacked.push({x:px+innerOffsetX+pos.x,y:py+basePalletH+l*box.h,z:pz+innerOffsetZ+pos.z,w:pos.w,h:box.h,d:pos.d,color:box.color,typeId:box.id,name:box.name});
                        boxesLeft--;
                    }
                }
            }
        }
    }
    return finalPacked;
}

self.onmessage = function(e) {
  const {boxes,innerGap,maxX,maxY,maxZ,strat,thresh,isJapanBound,palletType,interlockFirst,ITER} = e.data;
  let best=[], bestVol=-1;
  const tryIt=(arr)=>{const v=arr.reduce((s,p)=>s+(p.isPallet||p.isPad?0:p.w*p.h*p.d),0);if(v>bestVol){bestVol=v;best=arr;}};
  const runSim = (arr,s,rand) => isJapanBound?simulateJapanPallet(arr,innerGap,maxX,maxY,maxZ,palletType,interlockFirst):simulate(arr,innerGap,maxX,maxY,maxZ,s,thresh,rand);
  
  if(!isJapanBound){
    if(strat==='auto'){tryIt(runSim(boxes,'length',false));tryIt(runSim(boxes,'width',false));}
    else tryIt(runSim(boxes,strat,false));
  } else {
    tryIt(runSim(boxes,strat,false));
  }
  
  for(let cur=0;cur<ITER;cur++){
    if(!isJapanBound){
      let s2=strat==='auto'?(Math.random()>0.5?'length':'width'):strat;
      tryIt(runSim(boxes,s2,true));
      if(cur%10===0){tryIt(runSim(boxes,'length',true));tryIt(runSim(boxes,'width',true));}
    }
    if(cur%5===4) self.postMessage({type:'progress',pct:Math.round((cur+1)/ITER*100)});
  }
  self.postMessage({type:'done',packed:best});
};
