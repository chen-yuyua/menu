      </div>
    </div>
  );
}

// ── [v2.2] getGaps: multi-region gap detection ──
// For X axis: use interval-merge approach to detect ALL gap regions
//   (left gap, between-pallet gaps, right gap) for distributed/center xAlign modes.
// For Y/Z axes: keep original grid scan (single gap direction).
// isPad objects retained (not filtered) for correct boundary detection.
function getGaps(packed, container, axis, limit){
  const realPacked = packed.filter(p => !p.isPallet || p.isPad);
  if(!realPacked.length) return [0];

  if(axis==='X'){
    // Project all objects onto X axis → find all occupied [x, x+w] intervals
    const intervals = realPacked.map(p=>[p.x, p.x+p.w]);
    intervals.sort((a,b)=>a[0]-b[0]);
    // Merge overlapping/touching intervals (6mm tolerance)
    const merged=[[...intervals[0]]];
    for(const [s,e] of intervals.slice(1)){
      if(s<=merged[merged.length-1][1]+6) merged[merged.length-1][1]=Math.max(merged[merged.length-1][1],e);
      else merged.push([s,e]);
    }
    const gaps=[];
    if(merged[0][0]>6) gaps.push(Math.round(merged[0][0])); // left gap
    for(let i=0;i<merged.length-1;i++){
      const g=merged[i+1][0]-merged[i][1];
      if(g>6) gaps.push(Math.round(g)); // between-object gaps
    }
    const rg=limit-merged[merged.length-1][1];
    if(rg>6) gaps.push(Math.round(rg)); // right gap
    const deduped=[]; for(const g of [...new Set(gaps)].sort((a,b)=>a-b)){ if(!deduped.length||g-deduped[deduped.length-1]>6) deduped.push(g); }
    return deduped.length?deduped:[0];
  }

  // Y and Z axes: original grid scan (single gap)
  const step=50, vis=new Set();
  if(axis==='Y'){
    const dX=Math.ceil(container.w/step),dZ=Math.ceil(container.d/step),g=new Float32Array(dX*dZ).fill(-1);
    realPacked.forEach(p=>{const lim=p.y+p.h,sx=Math.floor(p.x/step),ex=Math.ceil((p.x+p.w)/step),sz=Math.floor(p.z/step),ez=Math.ceil((p.z+p.d)/step);for(let x=sx;x<ex&&x<dX;x++)for(let z=sz;z<ez&&z<dZ;z++){const i=x*dZ+z;if(lim>g[i])g[i]=lim;}});
    g.forEach(v=>{if(v>=0)vis.add(Math.round(v));});
  }else{
    const dX=Math.ceil(container.w/step),dY=Math.ceil(container.h/step),g=new Float32Array(dX*dY).fill(-1);
    realPacked.forEach(p=>{const lim=p.z+p.d,sx=Math.floor(p.x/step),ex=Math.ceil((p.x+p.w)/step),sy=Math.floor(p.y/step),ey=Math.ceil((p.y+p.h)/step);for(let x=sx;x<ex&&x<dX;x++)for(let y=sy;y<ey&&y<dY;y++){const i=x*dY+y;if(lim>g[i])g[i]=lim;}});
    g.forEach(v=>{if(v>=0)vis.add(Math.round(v));});
  }
  const lims=Array.from(vis).sort((a,b)=>b-a);
  const rawGaps=lims.map(l=>Math.max(0,limit-l)).filter((g,i,a)=>g>=0&&a.indexOf(g)===i).sort((a,b)=>a-b);
  const deduped=[]; for(const g of rawGaps){ if(!deduped.length||g-deduped[deduped.length-1]>6) deduped.push(g); }
  return deduped.length?deduped:[0];
}

