                        <div className="grid grid-cols-4 gap-2 text-sm">
                          {[['L', 'L'], ['W', 'W'], ['H', 'H'], ['qty', 'QTY']].map(([f, lbl]) => (
                            <div key={f}><label className="block text-xs text-slate-500 mb-1">{t[lbl]}</label><input type="number" min={f==='qty'?0:1} value={box[f]} onChange={(e) => handleBoxChange(box.id, f, Number(e.target.value))} className="w-full p-1.5 border border-slate-300 rounded bg-white" /></div>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>

                  <div className="mt-4 mb-2 p-3 bg-slate-50 border border-slate-200 rounded-lg">
                    <label className="block text-sm font-semibold text-slate-700 mb-2">{t.strategyTitle}</label>
                    <select 
                      value={packingStrategy} 
                      onChange={e => setPackingStrategy(e.target.value)}
                      className="w-full p-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-blue-500 outline-none"
                    >
                      <option value="auto">{t.strategyAuto}</option>
                      <option value="length">{t.strategyLength}</option>
                      <option value="width">{t.strategyWidth}</option>
                    </select>
                  </div>

                  <button onClick={() => runPacking()} disabled={isCalculating} className="w-full mt-4 bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-lg flex items-center justify-center disabled:opacity-50">
                    {isCalculating ? <RefreshCw className="w-5 h-5 animate-spin mr-2" /> : <Play className="w-5 h-5 mr-2" />}
                    {isCalculating ? t.calculating : t.calcBtn}
                  </button>
                </div>
              </div>

              <div className="lg:col-span-7 flex flex-col space-y-4">
                <div className="bg-white p-2 rounded-xl shadow-sm border border-slate-200 relative flex-grow min-h-[450px]">
                  {!threeLoaded && <div className="absolute inset-0 flex items-center justify-center bg-slate-50 z-10 rounded-xl"><div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div></div>}
                  
                  <div className="absolute top-4 left-4 z-10 pointer-events-none flex flex-col space-y-1.5">
                    {boxTypes.map(b => (
                      <div key={b.id} className="bg-white/80 backdrop-blur px-2 py-1 rounded-md border border-slate-200 shadow-sm flex items-center text-[10px] w-max">
                        <span className="w-2.5 h-2.5 rounded-full mr-1.5" style={{backgroundColor: b.color}}></span>
                        <span className="font-medium text-slate-700 truncate">{b.name}</span>
                      </div>
                    ))}
                    
                    {packingResult.stats?.remainingGaps && packingResult.packed.length > 0 && (
                      <div className="bg-white/80 backdrop-blur p-2.5 rounded-md border border-slate-200 shadow-sm mt-2 pointer-events-auto w-max">
                        <div className="flex items-center text-slate-700 font-bold text-[11px] mb-1.5">
                          <Ruler className="w-3.5 h-3.5 mr-1 text-blue-600" /> {t.remainingGapsTitle}
                        </div>
                        <div className="flex gap-3 text-[10px]">
                          {[['remainL', 'd', doorGap, 'text-orange-600'], ['remainW', 'w', rightGap, 'text-blue-600'], ['remainH', 'h', topGap, 'text-green-600']].map(([lbl, key, gVal, tCls], index) => (
                            <div key={key} className={`flex flex-col ${index > 0 ? 'border-l border-slate-300 pl-3' : ''}`}>
                              <span className="text-slate-500 font-bold mb-0.5">{t[lbl]}</span>
                              {packingResult.stats.remainingGaps[key].map((g, idx) => (
                                <div key={idx} className="flex items-baseline space-x-1 leading-tight mb-0.5 last:mb-0">
                                  <span className={`font-bold ${tCls}`}>{g}mm</span>
                                  <span className="text-slate-400 scale-90 origin-left whitespace-nowrap">({t.actualGap} {g+gVal})</span>
                                </div>
                              ))}
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                  
                  <div className="absolute top-4 right-4 z-10 flex space-x-1.5">
                    {['iso', 'top', 'front', 'side'].map(v => <button key={v} onClick={() => changeView(v)} className="bg-white/90 backdrop-blur text-slate-700 hover:text-blue-600 px-2.5 py-1 rounded-md border border-slate-200 text-[11px] font-medium shadow-sm">{t['view'+v.charAt(0).toUpperCase()+v.slice(1)]}</button>)}
                  </div>

                  <div ref={canvasRef} className="w-full h-full rounded-lg overflow-hidden cursor-move touch-none bg-slate-100"></div>
                  
                  {packingResult.packed.length > 0 && (
                    <div className="absolute bottom-4 left-4 right-4 bg-white/90 backdrop-blur border border-slate-200 p-2.5 rounded-lg shadow-sm flex flex-col sm:flex-row items-center gap-3 sm:gap-6 pointer-events-auto z-20">
                      <div className="flex items-center space-x-3 w-full sm:w-auto flex-shrink-0">
                        <span className="flex items-center text-blue-700 font-bold text-xs bg-blue-50 px-2 py-1 rounded">
                          <Play className="w-3.5 h-3.5 mr-1.5" /> {t.playbackPrefix} {renderStep} / {packingResult.packed.length}
                        </span>
                        <label className="flex items-center space-x-1.5 cursor-pointer bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded transition-colors text-xs">
                          <input type="checkbox" checked={isTransparent} onChange={e => setIsTransparent(e.target.checked)} className="w-3.5 h-3.5 text-blue-600 rounded border-slate-300" />
                          <Eye className="w-3.5 h-3.5 text-slate-600" />
                          <span className="text-slate-700">{t.xrayLabel}</span>
                        </label>
                      </div>
                      <div className="flex-grow flex items-center space-x-2 w-full">
                        <span className="text-[10px] text-slate-400 font-medium whitespace-nowrap">{t.innerLayer}</span>
                        <input type="range" min="0" max={packingResult.packed.length} value={renderStep} onChange={e => setRenderStep(Number(e.target.value))} className="w-full h-1.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
                        <span className="text-[10px] text-slate-400 font-medium whitespace-nowrap">{t.doorLayer}</span>
                      </div>
                    </div>
                  )}
                </div>

                {packingResult.stats && (
                  <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200 space-y-5">
                    <div className="flex justify-between items-center border-b border-slate-100 pb-3">
                      <h3 className="text-lg font-semibold text-slate-800 flex items-center"><CheckCircle2 className="w-5 h-5 mr-2 text-green-500" /> {t.summaryTitle}</h3>
                      <button onClick={exportToDXF} className="flex items-center bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded-lg text-sm transition-colors shadow-sm"><DownloadIcon className="w-4 h-4 mr-1.5" /> {t.exportDXF}</button>
                    </div>

                    <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                      {[ ['totalBoxes', packingResult.stats.totalBoxes, 'text-slate-800'], ['utilization', packingResult.stats.utilization+'%', 'text-blue-600'], ['effectiveVol', (packingResult.stats.totalBoxVolume/1000000000).toFixed(2)+' m³', 'text-slate-800', `${t.totalVol} ${((c.w*c.h*c.d)/1000000000).toFixed(2)}m³`] ].map(([lbl, val, cls, sub], i) => (
                        <div key={i} className={`bg-slate-50 p-3 rounded-lg border border-slate-100 ${i===2?'col-span-2':''}`}>
                          <p className="text-xs text-slate-500 mb-1">{t[lbl]}</p>
                          <p className={`text-xl font-bold ${cls}`}>{val} {sub && <span className="text-xs font-normal text-slate-400 ml-1">/ {sub}</span>}</p>
                        </div>
                      ))}
                    </div>
                    
                    <div className="border-t border-slate-100 pt-4">
                      <p className="text-sm font-medium text-slate-700 mb-3">{t.detailTitle}</p>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        {boxTypes.map(b => {
                          const count = packingResult.stats.counts[b.id] || 0;
                          if (count === 0 && b.qty === 0) return null; 
                          return (
                            <div key={b.id} className="flex justify-between items-center p-2 bg-white border border-slate-200 rounded-lg shadow-sm text-sm">
                              <span className="flex items-center font-medium text-slate-700"><span className="w-3 h-3 rounded-full mr-2" style={{backgroundColor: b.color}}></span>{b.name}</span>
                              <span className={`font-bold px-2 py-0.5 rounded ${b.qty > 0 && count < b.qty ? 'bg-red-100 text-red-700' : 'bg-slate-100 text-slate-800'}`}>{count} {b.qty > 0 ? `/ ${b.qty}` : ''} {t.boxUnit}</span>
                            </div>
                          )
                        })}
                      </div>
                    </div>

                    {packingResult.stats.warnings?.length > 0 && (
                      <div className="mt-5 bg-orange-50 border border-orange-200 rounded-xl p-4">
                        <h4 className="flex items-center text-orange-800 font-bold mb-3"><AlertTriangle className="w-5 h-5 mr-2" /> {t.warningTitle}</h4>
                        <ul className="space-y-2 mb-4">
                          {packingResult.stats.warnings.map((w, idx) => (
                            <li key={idx} className="flex items-center justify-between bg-white px-3 py-2 rounded-lg border border-orange-100 text-sm">
                              <span className="flex items-center font-medium"><span className="w-3 h-3 rounded-full mr-2" style={{backgroundColor: w.color}}></span>{w.name}</span>
                              <span className="text-orange-700 font-semibold">{t.shortfall} {w.shortfall} {t.boxUnit} <span className="text-slate-400 text-xs font-normal">({t.req} {w.requested} / {t.packed} {w.packed})</span></span>
                            </li>
                          ))}
                        </ul>
                        <div className="text-sm text-slate-700 space-y-3">
                          <div><span className="font-bold text-slate-800">{t.analysisTitle}</span><br/>{t.analysis1}<span className="font-semibold text-orange-700">{t.analysis2}</span>{t.analysis3}</div>
                          <div><span className="font-bold text-slate-800">{t.suggestionTitle}</span><ul className="list-disc pl-5 mt-1 text-slate-600"><li>{t.sug1}</li><li>{t.sug2}</li><li>{t.sug4}</li></ul></div>
                        </div>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      );
    }
    const root = ReactDOM.createRoot(document.getElementById('root')); root.render(<App />);
  </script>
</body>
</html>
