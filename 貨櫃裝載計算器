// ── 裝載演算法核心 ────────────────────────────────────────────────────────
function isColliding(x,y,z,w,h,d,packed){
  for(const b of packed){
    if(!(x>=b.x+b.w-EPS||x+w<=b.x+EPS||y>=b.y+b.h-EPS||y+h<=b.y+EPS||z>=b.z+b.d-EPS||z+d<=b.z+EPS)) return true;
  }
  return false;
}

function isSupported(x,y,z,w,h,d,packed,thresh){
  if(y<EPS) return true;
  let area=0;
  for(const b of packed){
    if(Math.abs((b.y+b.h)-y)<EPS){
      const ix1=Math.max(x,b.x), iz1=Math.max(z,b.z);
      const ix2=Math.min(x+w,b.x+b.w), iz2=Math.min(z+d,b.z+b.d);
      if(ix1<ix2-EPS&&iz1<iz2-EPS) area+=(ix2-ix1)*(iz2-iz1);
    }
  }
  return area/(w*d)>=thresh;
}

function getOrientations(b, strat){
  const u=new Set(), res=[];
  const perms=[[b.w,b.h,b.d],[b.d,b.h,b.w]];
  for(const p of perms){
    const k=`${Math.round(p[0])},${Math.round(p[1])},${Math.round(p[2])}`;
    if(!u.has(k)){
      u.add(k);
      let pref=true;
      if(strat==='length'&&Math.abs(p[2]-b.d)>EPS) pref=false;
      if(strat==='width' &&Math.abs(p[2]-b.w)>EPS) pref=false;
      res.push({w:p[0],h:p[1],d:p[2],pref});
    }
  }
  return res;
}

function dedupPoints(pts){
  const s=new Set(), r=[];
  for(const p of pts){
    const k=`${Math.round(p.x)},${Math.round(p.y)},${Math.round(p.z)}`;
    if(!s.has(k)){s.add(k);r.push(p);}
  }
  return r;
}

function ptInsideBox(p,b){
  return p.x>b.x+EPS&&p.x<b.x+b.w-EPS&&p.y>b.y+EPS&&p.y<b.y+b.h-EPS&&p.z>b.z+EPS&&p.z<b.z+b.d-EPS;
}

function simulate(boxTypes, innerGap, maxX, maxY, maxZ, strat, thresh, randomize){
  let pts=[{x:0,y:0,z:innerGap}], packed=[];
  const finInv=[], infInv=[];
  boxTypes.forEach(b=>{
    let aL=b.L, aW=b.W, aH=b.H;
    if(b.calcMode==='max'){aL+=b.tolPlus;aW+=b.tolPlus;aH+=b.tolPlus;}
    else if(b.calcMode==='min'){aL-=b.tolMinus;aW-=b.tolMinus;aH-=b.tolMinus;}
    else if(b.calcMode==='mid'){const d=(b.tolPlus-b.tolMinus)/2;aL+=d;aW+=d;aH+=d;}
    const item={...b,w:aW,h:aH,d:aL};
    if(b.qty>0){item.remaining=b.qty;finInv.push(item);}
    else{item.remaining=Infinity;infInv.push(item);}
  });
  let count=0;
  for(const inv of [finInv,infInv]){
    if(!inv.length) continue;
    let canPack=true;
    while(canPack&&count<3000){
      canPack=false;
      pts.sort((a,b)=>{
        if(Math.abs(a.z-b.z)>1) return a.z-b.z;
        if(randomize&&Math.random()<0.45) return Math.random()<0.5?(Math.abs(a.x-b.x)>1?a.x-b.x:a.y-b.y):(Math.abs(a.y-b.y)>1?a.y-b.y:a.x-b.x);
        return Math.abs(a.y-b.y)>1?a.y-b.y:a.x-b.x;
      });
      for(const pt of pts){
        let bIdx=-1, bOri=null, bVol=-1, bFit=-1, bD=-1, bPref=false;
        let idx=inv.map((_,i)=>i);
        if(randomize){for(let i=idx.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[idx[i],idx[j]]=[idx[j],idx[i]];}}
        for(const i of idx){
          const box=inv[i];
          if(box.remaining<=0) continue;
          let cs=strat;
          if(randomize&&Math.random()>0.65) cs=Math.random()>0.5?'length':'width';
          for(const ori of getOrientations(box,cs)){
            if(pt.x+ori.w>maxX+EPS||pt.y+ori.h>maxY+EPS||pt.z+ori.d>maxZ+EPS) continue;
            if(!isColliding(pt.x,pt.y,pt.z,ori.w,ori.h,ori.d,packed)&&isSupported(pt.x,pt.y,pt.z,ori.w,ori.h,ori.d,packed,thresh)){
              const vol=ori.w*ori.h*ori.d;
              const fit=Math.floor((maxX-pt.x)/ori.w)*Math.floor((maxY-pt.y)/ori.h)*Math.floor((maxZ-pt.z)/ori.d);
              let ev=randomize?vol*(1+(Math.random()*0.16-0.08)):vol;
              let better=false;
              if(bIdx===-1) better=true;
              else if(ori.pref&&!bPref) better=true;
              else if(!ori.pref&&bPref) better=false;
              else if(ev>bVol) better=true;
              else if(ev===bVol&&fit>bFit) better=true;
              else if(ev===bVol&&fit===bFit&&ori.d>bD) better=true;
              if(better){bVol=ev;bFit=fit;bD=ori.d;bIdx=i;bOri=ori;bPref=ori.pref;}
            }
          }
        }
        if(bIdx!==-1){
          const bb=inv[bIdx];
          packed.push({x:pt.x,y:pt.y,z:pt.z,w:bOri.w,h:bOri.h,d:bOri.d,color:bb.color,typeId:bb.id,name:bb.name});
          bb.remaining--;count++;canPack=true;
          pts.push({x:pt.x+bOri.w,y:pt.y,z:pt.z},{x:pt.x,y:pt.y+bOri.h,z:pt.z},{x:pt.x,y:pt.y,z:pt.z+bOri.d});
          pts=pts.filter(p=>p!==pt&&p.x<maxX-EPS&&p.y<maxY-EPS&&p.z<maxZ-EPS&&!packed.some(b=>ptInsideBox(p,b)));
          pts=dedupPoints(pts);
          break;
        }
      }
    }
  }
  return packed;
}

function getGaps(packed, container, axis, limit){
  if(!packed.length) return [limit];
  const step=50, vis=new Set();
  if(axis==='X'){
    const dY=Math.ceil(container.h/step),dZ=Math.ceil(container.d/step),g=new Float32Array(dY*dZ).fill(-1);
    packed.forEach(p=>{const lim=p.x+p.w,sy=Math.floor(p.y/step),ey=Math.ceil((p.y+p.h)/step),sz=Math.floor(p.z/step),ez=Math.ceil((p.z+p.d)/step);for(let y=sy;y<ey&&y<dY;y++)for(let z=sz;z<ez&&z<dZ;z++){const i=y*dZ+z;if(lim>g[i])g[i]=lim;}});
    g.forEach(v=>{if(v>=0)vis.add(Math.round(v));});
  }else if(axis==='Y'){
    const dX=Math.ceil(container.w/step),dZ=Math.ceil(container.d/step),g=new Float32Array(dX*dZ).fill(-1);
    packed.forEach(p=>{const lim=p.y+p.h,sx=Math.floor(p.x/step),ex=Math.ceil((p.x+p.w)/step),sz=Math.floor(p.z/step),ez=Math.ceil((p.z+p.d)/step);for(let x=sx;x<ex&&x<dX;x++)for(let z=sz;z<ez&&z<dZ;z++){const i=x*dZ+z;if(lim>g[i])g[i]=lim;}});
    g.forEach(v=>{if(v>=0)vis.add(Math.round(v));});
  }else{
    const dX=Math.ceil(container.w/step),dY=Math.ceil(container.h/step),g=new Float32Array(dX*dY).fill(-1);
    packed.forEach(p=>{const lim=p.z+p.d,sx=Math.floor(p.x/step),ex=Math.ceil((p.x+p.w)/step),sy=Math.floor(p.y/step),ey=Math.ceil((p.y+p.h)/step);for(let x=sx;x<ex&&x<dX;x++)for(let y=sy;y<ey&&y<dY;y++){const i=x*dY+y;if(lim>g[i])g[i]=lim;}});
    g.forEach(v=>{if(v>=0)vis.add(Math.round(v));});
  }
  const lims=Array.from(vis).sort((a,b)=>b-a);
  const gaps=lims.map(l=>Math.max(0,limit-l)).filter((g,i,a)=>g>=0&&a.indexOf(g)===i);
  return gaps.length?gaps.slice(0,3):[0];
}

