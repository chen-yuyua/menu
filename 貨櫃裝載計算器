    }

    // Boxes - render all layers
    for (let l = 0; l < numLayers; l++) {
      layout.forEach(function(b) {
        const mesh = new THREE.Mesh(
          new THREE.BoxGeometry(b.w, boxHeight, b.d),
          new THREE.MeshLambertMaterial({ color: boxColor || '#fb9660' })
