                )
              )}

              <div style={{position:'absolute',top:12,left:12,zIndex:10,display:'flex',flexDirection:'column',gap:4,pointerEvents:'none'}}>
                <LabelStrip/>
                {result.stats?.rem && hasPacked && (
                  <div style={{marginTop:6,pointerEvents:'auto'}}><GapStrip/></div>
                )}
              </div>

              <div style={{position:'absolute',top:12,right:12,zIndex:30, display:'flex', flexDirection:'column', alignItems:'flex-end', gap:4}}>
                <button onClick={()=>changeView('iso')} className="view-btn" style={{padding: '4px 8px', display:'flex', alignItems:'center', gap:4, boxShadow:'0 2px 8px rgba(0,0,0,0.1)'}} title={lang==='zh'?'等角視圖':'等角投影'}>
                  <Ico.Home s={14}/> {lang==='zh'?'等角':'等角'}
                </button>
                <div ref={compassRef} style={{width: 90, height: 90, background:'rgba(255,255,255,0.7)', borderRadius: '8px', border: '1px solid var(--line)', boxShadow:'0 2px 8px rgba(0,0,0,0.05)'}}></div>
              </div>

              <div ref={canvasRef} className="touch-none" id="canvas-wrap" style={{background:'var(--paper-warm)'}}></div>

              {/* Pallet Preview - Japan mode only */}
              {isJapanBound && result.stats?.palletDetail && hasPacked && (
                <PalletPreview palletDetail={result.stats.palletDetail} t={t} lang={lang}/>
              )}

              {hasPacked && (
                <div style={{position:'absolute',bottom:10,left:10,right:10,zIndex:20,background:'rgba(255,255,255,.9)',backdropFilter:'blur(8px)',border:'1px solid var(--line)',borderRadius:10,padding:'9px 12px',display:'flex',alignItems:'center',gap:10,flexWrap:'wrap',boxShadow:'0 4px 16px rgba(0,0,0,0.05)'}}>
                  <span style={{fontSize:14,fontWeight:700,color:'var(--brand)',background:'var(--tertiary-soft)',padding:'3px 8px',borderRadius:5,whiteSpace:'nowrap',display:'flex',alignItems:'center',gap:4}}>
                    <Ico.Play s={11}/>{t.play} {isGrouped ? `${currentSliderVal}/${groupSteps.length - 1} ${t.groupUnit}` : `${step}/${result.packed.length}`}
                  </span>
                  <label style={{display:'flex',alignItems:'center',gap:5,cursor:'pointer',fontSize:14,fontWeight:700,color:'var(--ink-mid)',whiteSpace:'nowrap'}}>
                    <input type="checkbox" checked={xray} onChange={e=>setXray(e.target.checked)}/>
                    <Ico.Eye s={12}/>{t.xray}
                  </label>
                  <label style={{display:'flex',alignItems:'center',gap:5,cursor:'pointer',fontSize:14,fontWeight:700,color:'var(--ink-mid)',whiteSpace:'nowrap'}}>
                    <input type="checkbox" checked={isPerspective} onChange={e=>setIsPerspective(e.target.checked)}/>
                    <Ico.Cam s={12}/>{t.perspective}
                  </label>
                  <div style={{flex:1,display:'flex',alignItems:'center',gap:6,minWidth:100}}>
                    <span style={{fontSize:12,fontWeight:700,color:'var(--ink-ghost)',whiteSpace:'nowrap'}}>{t.inner}</span>
                    <input type="range" 
                      min="0" 
                      max={isGrouped ? groupSteps.length - 1 : result.packed.length} 
                      value={isGrouped ? currentSliderVal : step} 
                      onChange={e=>setStep(isGrouped ? groupSteps[Number(e.target.value)] : Number(e.target.value))} 
                      style={{flex:1,accentColor:'var(--brand)'}}
                    />
                    <span style={{fontSize:12,fontWeight:700,color:'var(--ink-ghost)',whiteSpace:'nowrap'}}>{t.door}</span>
                  </div>
                </div>
              )}
            </div>

            {result.stats && (
              <div className="card" style={{padding:16}} key="result">
                <div className="sec-header">
                  <div className="sec-dot"></div>
                  <span style={{fontWeight:700,fontSize:16}}>{t.sumTitle}</span>
                </div>

                <div style={{display:'grid',gridTemplateColumns:'repeat(auto-fit,minmax(120px,1fr))',gap:8,marginBottom:14}}>
                  <div className="stat-box">
                    <div className="text-caption">{t.totBox}</div>
                    <div className="stat-num" style={{color:'var(--ink)'}}>{result.stats.total}</div>
                  </div>
                  <div className="stat-box">
                    <div className="text-caption">{t.util}</div>
                    <div className="stat-num" style={{color:'var(--brand)',fontWeight:800}}>{result.stats.util}%</div>
                  </div>
                  {result.stats.palletCount>0 && (
                    <div className="stat-box">
                      <div className="text-caption">{t.palletUsage}</div>
                      <div className="stat-num" style={{color:'var(--highlight)'}}>{result.stats.palletCount}</div>
                    </div>
                  )}
                  <div className="stat-box" style={{gridColumn: result.stats.palletCount>0?'span 1':'span 1'}}>
                    <div className="text-caption">{t.effVol}</div>
                    <div style={{fontWeight:700,fontSize:19,color:'var(--ink)',marginTop:3}}>
                      {(result.stats.vol/1e9).toFixed(2)} <span style={{fontSize:14,fontWeight:400,color:'var(--ink-ghost)'}}>m³</span>
                    </div>
                    <div style={{fontSize:13,color:'var(--ink-ghost)',marginTop:1}}>{t.totVol} {((c.w*c.h*c.d)/1e9).toFixed(2)} m³</div>
                  </div>
                </div>

                {result.stats.palletDetail && (
                  <div style={{display:'flex',alignItems:'center',gap:8,padding:'9px 12px',background:'var(--warn-pale)',border:'1px solid var(--warn)',borderRadius:8,marginBottom:12}}>
                    <Ico.Layers s={14}/><span style={{fontSize:15,fontWeight:700,color:'var(--ink-mid)'}}>{t.palletDetail}：</span>
                    <span style={{fontSize:15,color:'var(--ink-soft)'}}>
                      {t.palletLayerFmt.replace('{n}',result.stats.palletDetail.boxesPerLayer).replace('{l}',result.stats.palletDetail.layers)}
                      {' · '}
                      {t.palletCountFmt.replace('{c}',result.stats.palletCount)}
                    </span>
                  </div>
                )}

                <div>
                  <div style={{fontSize:14,fontWeight:700,color:'var(--ink-mid)',marginBottom:8}}>{t.detail}</div>
                  <div style={{display:'grid',gridTemplateColumns:'1fr 1fr',gap:6}}>
                    {boxes.map(b=>{
                      const cnt=result.stats.counts[b.id]||0;
                      if(cnt===0&&b.qty===0) return null;
                      const short = b.qty>0 && cnt<b.qty;
                      return (
                        <div key={b.id} style={{display:'flex',justifyContent:'space-between',alignItems:'center',padding:'7px 10px',background:'var(--paper-warm)',border:'1px solid var(--line)',borderRadius:7,fontSize:15}}>
                          <span style={{display:'flex',alignItems:'center',gap:6,fontWeight:700,color:'var(--ink-mid)'}}>
                            <span style={{width:8,height:8,borderRadius:'50%',background:b.color,flexShrink:0,display:'inline-block'}}></span>
                            <span style={{maxWidth:120,overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}}>{b.name}</span>
                          </span>
                          <span className={"tag "+(short?'tag-danger':'tag-ink')} style={{fontWeight:700}}>
                            {cnt}{b.qty>0?' / '+b.qty:''} {t.boxU}
                          </span>
                        </div>
                      );
                    })}
                  </div>
                </div>

                {result.stats.warns?.length>0 && (
                  <div style={{marginTop:12,background:'var(--danger-soft)',border:'1px solid rgba(234, 43, 31, 0.4)',borderRadius:10,padding:14}}>
                    <div style={{display:'flex',alignItems:'center',gap:6,fontWeight:700,fontSize:15,color:'var(--danger)',marginBottom:10}}>
                      <Ico.Warn s={14}/>{t.warnTitle}
                    </div>
                    <div style={{display:'flex',flexDirection:'column',gap:5,marginBottom:10}}>
                      {result.stats.warns.map((w,i)=>(
                        <div key={i} style={{display:'flex',justifyContent:'space-between',alignItems:'center',background:'var(--paper-card)',padding:'7px 10px',borderRadius:8,border:'1px solid var(--danger)',fontSize:15}}>
                          <span style={{display:'flex',alignItems:'center',gap:5,fontWeight:700}}>
                            <span style={{width:7,height:7,borderRadius:'50%',background:w.color,flexShrink:0,display:'inline-block'}}></span>
                            {w.name}
                          </span>
                          <span style={{color:'var(--danger)',fontWeight:700,fontSize:14}}>{t.wShort} {w.lack} {t.boxU} ({t.wReq} {w.req} / {t.wPack} {w.pk})</span>
                        </div>
                      ))}
                    </div>
                    <p style={{fontSize:14,color:'var(--danger)',lineHeight:1.7}}>{t.wAnal}</p>
                    <p style={{fontSize:14,color:'var(--danger)',lineHeight:1.7,marginTop:4}}>{t.wSug}</p>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
</script>
</body>
</html>
