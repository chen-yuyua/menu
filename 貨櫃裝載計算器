    // --- 應用程式版本與更新日期 ---
    const APP_VERSION = "1.31";
    const APP_UPDATED_DATE = "2026/02/25";

    // --- 常數與工具函數 ---
    const CONTAINERS = {
      '20GP': { id: '20GP', w: 2330, h: 2350, d: 5867, maxWeight: 28200 },
      '40GP': { id: '40GP', w: 2330, h: 2350, d: 11998, maxWeight: 28800 },
      '40HQ': { id: '40HQ', w: 2330, h: 2655, d: 11998, maxWeight: 28600 }
    };
    const DEFAULT_COLORS = ['#3b82f6', '#ef4444', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4'];
    const generateId = () => Math.random().toString(36).substr(2, 9);
    
    const isColliding = (x, y, z, w, h, d, packed) => {
      for (let b of packed) {
        if (!(x >= b.x + b.w || x + w <= b.x || y >= b.y + b.h || y + h <= b.y || z >= b.z + b.d || z + d <= b.z)) return true;
      }
      return false;
    };
    
    const isSupported = (x, y, z, w, h, d, packed) => {
      if (y === 0) return true; 
      let supportedArea = 0;
      for (let b of packed) {
        if (Math.abs((b.y + b.h) - y) < 1.0) {
          let ix1 = Math.max(x, b.x), iz1 = Math.max(z, b.z), ix2 = Math.min(x + w, b.x + b.w), iz2 = Math.min(z + d, b.z + b.d);
          if (ix1 < ix2 && iz1 < iz2) supportedArea += (ix2 - ix1) * (iz2 - iz1);
        }
      }
      return (supportedArea / (w * d)) >= 0.8; 
    };
    
    const getOrientations = (b, strategy = 'length') => {
      const unique = new Set(), orientations = [];
      const perms = [[b.w, b.h, b.d], [b.d, b.h, b.w]]; 
      for (let p of perms) {
        const key = p.join(',');
        if (!unique.has(key)) { 
          unique.add(key); 
          let isPreferred = true; 
          if (strategy === 'length' && p[2] !== b.d) isPreferred = false; 
          if (strategy === 'width' && p[2] !== b.w) isPreferred = false;  
          orientations.push({ w: p[0], h: p[1], d: p[2], isPreferred }); 
        }
      }
      return orientations;
    };

    // --- 主程式組件 ---
    function App() {
      const [lang, setLang] = useState('zh');
      const t = translations[lang];
      const [threeLoaded, setThreeLoaded] = useState(true);
      const [containerType, setContainerType] = useState('20GP');
      const [doorGap, setDoorGap] = useState(248);
      const [innerGap, setInnerGap] = useState(20);
      const [rightGap, setRightGap] = useState(10); 
      const [topGap, setTopGap] = useState(50); 
      const [boxTypes, setBoxTypes] = useState([
        { id: generateId(), name: `${translations.zh.defaultBoxPrefix} A`, L: 600, W: 400, H: 400, color: DEFAULT_COLORS[0], qty: 0 }
      ]);
      const [packingResult, setPackingResult] = useState({ packed: [], error: null, stats: null });
      const [isCalculating, setIsCalculating] = useState(false);
      const [packingStrategy, setPackingStrategy] = useState('auto');
      const [renderStep, setRenderStep] = useState(0);
      const [isTransparent, setIsTransparent] = useState(false);
      
      const meshesRef = useRef([]); 
      const dimGroupRef = useRef(null);
      const canvasRef = useRef(null);
      const sceneRef = useRef(null);
      const cameraRef = useRef(null);
      const controlsRef = useRef(null);

      const runPacking = () => {
        setIsCalculating(true);
        setTimeout(() => {
          const c = CONTAINERS[containerType];
          const maxZ_limit = Math.max(0, c.d - doorGap);
          const maxX_limit = Math.max(0, c.w - rightGap);
          const maxY_limit = Math.max(0, c.h - topGap);

          const simulatePacking = (simStrategy) => {
            let points = [{ x: 0, y: 0, z: innerGap }], packed = [];
            let finiteInventory = [], infiniteInventory = [];
            
            boxTypes.forEach(b => {
              let item = { ...b, w: b.W, h: b.H, d: b.L };
              if (b.qty > 0) { item.remaining = b.qty; finiteInventory.push(item); }
              else { item.remaining = Infinity; infiniteInventory.push(item); }
            });

            let phases = [finiteInventory, infiniteInventory], packedCount = 0;
            const MAX_BOXES = 3000;
            
            for (let currentInventory of phases) {
              if (currentInventory.length === 0) continue; 
              let canPack = true;
              while (canPack && packedCount < MAX_BOXES) {
                canPack = false;
                points.sort((a, b) => (Math.abs(a.z - b.z) > 1.0) ? a.z - b.z : (Math.abs(a.y - b.y) > 1.0 ? a.y - b.y : a.x - b.x));
                for (let pt of points) {
                  let bestBoxIdx = -1, bestOri = null, maxVol = -1, maxFitCount = -1, maxDepth = -1, bestIsPreferred = false;
                  
                  for (let i = 0; i < currentInventory.length; i++) {
                    let box = currentInventory[i];
                    if (box.remaining <= 0) continue;
                    for (let ori of getOrientations(box, simStrategy)) {
                      if (pt.x + ori.w > maxX_limit || pt.y + ori.h > maxY_limit || pt.z + ori.d > maxZ_limit) continue;
                      if (!isColliding(pt.x, pt.y, pt.z, ori.w, ori.h, ori.d, packed) && isSupported(pt.x, pt.y, pt.z, ori.w, ori.h, ori.d, packed)) {
                        let vol = ori.w * ori.h * ori.d;
                        let fitCount = Math.floor((maxX_limit - pt.x) / ori.w) * Math.floor((maxY_limit - pt.y) / ori.h) * Math.floor((maxZ_limit - pt.z) / ori.d);
                        
                        let isBetter = false;
                        
                        if (bestBoxIdx === -1) {
                          isBetter = true;
                        } else if (ori.isPreferred && !bestIsPreferred) {
                          isBetter = true; 
                        } else if (!ori.isPreferred && bestIsPreferred) {
                          isBetter = false; 
                        } else {
                          if (vol > maxVol) isBetter = true;
                          else if (vol === maxVol && fitCount > maxFitCount) isBetter = true;
                          else if (vol === maxVol && fitCount === maxFitCount && ori.d > maxDepth) isBetter = true;
                        }

                        if (isBetter) { maxVol = vol; maxFitCount = fitCount; maxDepth = ori.d; bestBoxIdx = i; bestOri = ori; bestIsPreferred = ori.isPreferred; }
                      }
                    }
                  }
                  if (bestBoxIdx !== -1) {
                    let bestBox = currentInventory[bestBoxIdx];
                    packed.push({ x: pt.x, y: pt.y, z: pt.z, w: bestOri.w, h: bestOri.h, d: bestOri.d, color: bestBox.color, typeId: bestBox.id, name: bestBox.name });
                    bestBox.remaining--; packedCount++; canPack = true;
                    points.push({ x: pt.x + bestOri.w, y: pt.y, z: pt.z }, { x: pt.x, y: pt.y + bestOri.h, z: pt.z }, { x: pt.x, y: pt.y, z: pt.z + bestOri.d });
                    points = points.filter(p => p !== pt && p.x < maxX_limit && p.y < maxY_limit && p.z < maxZ_limit && !packed.some(b => p.x > b.x && p.x < b.x + b.w && p.y > b.y && p.y < b.y + b.h && p.z > b.z && p.z < b.z + b.d));
                    const pSet = new Set(), uniquePoints = [];
                    for (let p of points) { let key = `${Math.round(p.x*10)},${Math.round(p.y*10)},${Math.round(p.z*10)}`; if (!pSet.has(key)) { pSet.add(key); uniquePoints.push(p); } }
                    points = uniquePoints; break;
                  }
                }
              }
            }
            return packed;
          };

          let finalPacked = [];

