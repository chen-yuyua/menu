/* ─── packing ─── */
function autoPack(oL,oW,oH,bts){
  const q=[];
  bts.forEach(bt=>{
    const[d,w,h]=ORI[bt._ori??0](effD(bt.L,bt.tP,bt.tM,bt.tS||'nominal'),effD(bt.W,bt.tP,bt.tM,bt.tS||'nominal'),effD(bt.H,bt.tP,bt.tM,bt.tS||'nominal'));
    for(let i=0;i<bt.qty;i++)q.push({typeId:bt.id,d,w,h,color:bt.color,name:bt.name});
  });
  if(!q.length)return[];
  const pl=[];let cy=0,idx=0;
  while(idx<q.length&&cy<oH){
    const it=q[idx];if(cy+it.h>oH+.1)break;
    let cz=0;
    while(cz<oL&&idx<q.length){
      const it2=q[idx];if(cz+it2.d>oL+.1)break;
      let cx=0;const rs=idx;
      while(cx<oW&&idx<q.length){
        const it3=q[idx];if(cx+it3.w>oW+.1)break;
        pl.push({id:uid(),typeId:it3.typeId,name:it3.name,color:it3.color,x:cx,y:cy,z:cz,w:it3.w,h:it3.h,d:it3.d});
        cx+=it3.w;idx++;
      }
      if(idx===rs)break;cz+=it2.d;
    }
    cy+=it.h;if(idx===q.length)break;
  }
  return pl;
}
function findPos(oL,oW,oH,ex,d,w,h){
  for(let y=0;y+h<=oH+.1;y++)for(let z=0;z+d<=oL+.1;z++)for(let x=0;x+w<=oW+.1;x++){
    if(!ex.some(p=>x<p.x+p.w-.1&&x+w>p.x+.1&&y<p.y+p.h-.1&&y+h>p.y+.1&&z<p.z+p.d-.1&&z+d>p.z+.1))return{x,y,z};
  }
  return null;
}

