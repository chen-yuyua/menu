<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&family=Noto+Sans+TC:wght@400;700;900&display=swap');
:root{
  --bg:#f5f4f0;--panel:#fdfcf9;--panel2:#f0ede6;
  --border:#d8d2c8;--border2:#c4bdb2;
  --accent:#3d7aba;--accent2:#2a9d7c;
  --warn:#c07830;--err:#b03030;--ok:#2a7a4a;
  --text:#2c2820;--text2:#6a5f52;--text3:#a89e92;
  --shadow:rgba(80,60,40,.10);
  --tok:#e8f5ed;--twarn:#fdf3e3;--terr:#fce8e8;--tinfo:#e8f0fb;
  /* Dial theme: slate-glass */
  --dial-bg:rgba(22,28,36,.88);
  --dial-border:rgba(255,255,255,.14);
  --dial-center-bg:rgba(248,250,253,.97);
  --dial-shadow:0 10px 40px rgba(0,0,0,.55);
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Noto Sans TC',sans-serif;min-height:100vh}
.mono{font-family:'IBM Plex Mono',monospace}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-track{background:var(--panel2)}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.inp{background:#fff;border:1px solid var(--border);color:var(--text);border-radius:6px;padding:5px 9px;font-size:12px;width:100%;outline:none;transition:border-color .2s;font-family:inherit}
.inp:focus{border-color:var(--accent);box-shadow:0 0 0 2px rgba(61,122,186,.13)}
.inp-sm{padding:4px 8px;font-size:12px}
.btn{border:none;border-radius:7px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .15s;display:inline-flex;align-items:center;justify-content:center;gap:5px}
.btn-primary{background:var(--accent);color:#fff;padding:8px 16px;font-size:12px;box-shadow:0 2px 6px rgba(61,122,186,.25)}
.btn-primary:hover{background:#2d6aaa}
.btn-sm{padding:5px 11px;font-size:11px}
.btn-xs{padding:3px 8px;font-size:10px}
.btn-danger{background:#fce8e8;color:var(--err);border:1px solid #e8c4c4}
.btn-danger:hover{background:#f8d0d0}
.btn-ghost{background:#fff;color:var(--text2);border:1px solid var(--border)}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent);background:var(--tinfo)}
.btn-success{background:#e8f5ed;color:var(--ok);border:1px solid #b8ddc8}
.btn-success:hover{background:#d4ecdd}
.btn-help{background:#fff8e8;color:var(--warn);border:1px solid #e8d8a0}
.btn-jp{background:#fff0f5;color:#a0306a;border:1px solid #e8b8cc}
.btn-jp:hover{background:#ffe0ec}
.swatch{width:18px;height:18px;border-radius:4px;border:2px solid rgba(0,0,0,.12);cursor:pointer;display:inline-block;flex-shrink:0}
.panel-label{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--text3);margin-bottom:7px}
.mini-canvas-wrap{border-radius:6px;overflow:hidden;background:#f0ede6;border:1px solid var(--border)}
.tag{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:999px;font-size:10px;font-weight:700}
.tag-ok{background:var(--tok);color:var(--ok);border:1px solid #b8ddc8}
.tag-warn{background:var(--twarn);color:var(--warn);border:1px solid #e8c890}
.tag-err{background:var(--terr);color:var(--err);border:1px solid #e8c4c4}
.tag-info{background:var(--tinfo);color:var(--accent);border:1px solid #b8d0f0}
.placed-chip{display:flex;align-items:center;gap:5px;padding:6px 9px;background:var(--panel2);border:1px solid var(--border);border-radius:7px;font-size:12px;cursor:pointer;transition:all .15s}
.placed-chip:hover{border-color:var(--accent)}
.placed-chip.sel{border-color:var(--accent);background:var(--tinfo)}
/* [改善4] 左側紙箱欄位自適應：填滿剩餘高度 */
.box-item{border:1px solid var(--border);border-radius:10px;padding:10px 11px;background:var(--panel);cursor:default;user-select:none;box-shadow:0 1px 3px var(--shadow)}
.box-item:hover{border-color:var(--accent);box-shadow:0 2px 8px var(--shadow)}
.divider{border:none;border-top:1px solid var(--border);margin:10px 0}
.header-accent{background:linear-gradient(90deg,var(--accent),var(--accent2));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
@keyframes fadeIn{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}
@keyframes dialIn{from{opacity:0;transform:scale(.72) translateY(6px)}to{opacity:1;transform:scale(1) translateY(0)}}
@keyframes bounceUp{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}

/* ══ [改善1] Radial Dial — 重新配色：slate-glass 主題 ══ */
/* Dial 現在嵌在 3D 視窗右上角 overlay */
.dial-overlay{
  position:absolute;
  top:10px;right:10px;
  z-index:30;
  pointer-events:all;
}
.rdial-wrap{
  position:relative;
  pointer-events:all;
  animation:dialIn .2s cubic-bezier(.34,1.56,.64,1) forwards;
}
/* 外圈背景：深石板色，半透明玻璃感 */
.rdial-bg{
  position:absolute;
  border-radius:50%;
  background:var(--dial-bg);
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  border:1.5px solid var(--dial-border);
  box-shadow:var(--dial-shadow);
  transform-origin:center;
}
/* 中心圓：白色卡片感 */
.rdial-center{
  position:absolute;
  border-radius:50%;
  background:var(--dial-center-bg);
  border:1.5px solid rgba(61,122,186,.25);
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  box-shadow:0 2px 12px rgba(0,0,0,.18);
  cursor:default;
}
/* 切換標籤：accent 主題 */
.rdial-tab{
  display:flex;border-radius:6px;overflow:hidden;
  margin-bottom:2px;
  border:1px solid rgba(61,122,186,.22);
  background:rgba(61,122,186,.07);
}
.rdial-tab-btn{
  border:none;padding:3px 9px;font-size:10px;font-weight:700;
  cursor:pointer;font-family:inherit;transition:all .13s;
  color:var(--text2);background:transparent;
}
.rdial-tab-btn.active{
  background:var(--accent);color:#fff;
  box-shadow:0 1px 4px rgba(61,122,186,.35);
}
/* 關閉鈕 */
.rdial-close{
  position:absolute;
  width:22px;height:22px;border-radius:50%;
  border:1px solid rgba(255,255,255,.2);
  background:rgba(255,255,255,.1);
  color:rgba(255,255,255,.75);
  font-size:12px;font-weight:900;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  top:3px;right:3px;
  transition:all .12s;
  z-index:2;
}
.rdial-close:hover{background:rgba(176,48,48,.8);color:#fff;}
/* 方向鈕：統一使用深色基底 + accent 色相環 */
.rdial-btn{
  position:absolute;width:38px;height:38px;border-radius:50%;
  border:1.5px solid rgba(255,255,255,.22);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  font-size:17px;font-weight:900;
  box-shadow:0 2px 8px rgba(0,0,0,.32);
  user-select:none;pointer-events:all;
  transition:transform .12s,box-shadow .12s,filter .12s;
}
.rdial-btn:hover{transform:scale(1.28)!important;box-shadow:0 5px 18px rgba(0,0,0,.45)!important;filter:brightness(1.18);}
.rdial-btn:active{transform:scale(.88)!important;}
/* 移動模式：深色 + 亮色文字，色相對應軸向 */
.mv-pz{background:#1a6e54;color:#7fffd4;}   /* 前+Z  teal */
.mv-nz{background:#1a4878;color:#90caf9;}   /* 後-Z  blue */
.mv-px{background:#7a4510;color:#ffcc80;}   /* 右+X  amber */
.mv-nx{background:#5a2878;color:#ce93d8;}   /* 左-X  purple */
.mv-py{background:#7a1a1a;color:#ef9a9a;}   /* 上+Y  red */
.mv-ny{background:#0d5448;color:#80cbc4;}   /* 下-Y  teal-dark */
/* 旋轉模式：同色相但更飽和 */
.rv-zp{background:#1a5c44;color:#a7ffeb;}
.rv-zn{background:#153d6a;color:#bbdefb;}
.rv-yp{background:#6a1a1a;color:#ffcdd2;}
.rv-yn{background:#4a1060;color:#e1bee7;}
.rv-xp{background:#14527a;color:#b3e5fc;}
.rv-xn{background:#0d3d5e;color:#81d4fa;}

/* ── 版面 ── */
.app-root{display:flex;flex-direction:column;height:100vh;overflow:hidden;background:var(--bg);}
.app-body{display:flex;flex:1;overflow:hidden;min-height:0;min-width:0;}
/* [改善4] 左側 app-left：完全填滿高度，內部滾動 */
.app-left{
  flex-shrink:0;
  border-right:1px solid var(--border);
  display:flex;flex-direction:column;
  background:var(--panel);
  overflow:hidden;
}
.app-left-inner{
  padding:12px 10px;
  overflow-y:auto;
  flex:1;           /* 填滿剩餘高度 */
  display:flex;flex-direction:column;gap:10px;
  /* 讓紙箱列表可以延伸到頁面底部 */
  min-height:0;
}
/* 紙箱列表本身也使用 flex 自動撐高 */
.box-list-wrap{
  display:flex;flex-direction:column;gap:8px;
  flex:1;
  overflow-y:auto;
  min-height:0;
}
.app-mid{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;}
.app-right{flex-shrink:0;border-left:1px solid var(--border);display:flex;flex-direction:column;background:var(--panel);overflow:hidden;}
.app-right-inner{padding:12px 10px;overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:10px;}
@media(max-width:1100px){
  .app-left{width:clamp(190px,20vw,240px)!important;}
  .app-right{width:clamp(185px,19vw,230px)!important;}
}
@media(max-width:820px){
  .app-body{flex-direction:column;overflow-y:auto;}
  .app-left{width:100%!important;max-height:42vh;border-right:none;border-bottom:1px solid var(--border);}
  .app-mid{min-height:45vh;}
  .app-right{width:100%!important;border-left:none;border-top:1px solid var(--border);max-height:45vh;}
}
.fade-in{animation:fadeIn .2s ease forwards}
.qty-inp{width:52px;text-align:center;background:#fff;border:1px solid var(--border);color:var(--text);border-radius:5px;padding:4px 6px;font-size:13px;font-family:'IBM Plex Mono',monospace;outline:none}
.name-inp{background:transparent;border:none;border-bottom:1px dashed var(--border2);color:var(--text);font-size:12px;font-weight:700;width:100%;outline:none;padding:0 2px;font-family:inherit}
.name-inp:focus{border-bottom-color:var(--accent)}
.rot-btn{background:#fff;border:1px solid var(--border);color:var(--text2);border-radius:5px;padding:4px 9px;font-size:12px;cursor:pointer;font-weight:700;transition:all .12s}
.rot-btn:hover{border-color:var(--accent);color:var(--accent);background:var(--tinfo)}
.tol-btn{
  padding:5px 12px;font-size:11px;font-weight:700;border-radius:6px;
  border:1.5px solid var(--border);
  background:var(--panel2);color:var(--text3);
  cursor:pointer;font-family:inherit;transition:all .15s;
  flex:1;text-align:center;
}
.tol-btn:hover{border-color:var(--border2);color:var(--text2);}
/* Active states: each with distinct vivid color — nom=blue, max=green, min=red */
.tol-btn.act-nom{
  background:#2563a8;color:#fff;border-color:#1a4f8e;
  box-shadow:0 2px 8px rgba(37,99,168,.45);
  transform:translateY(-1px);
}
.tol-btn.act-max{
  background:#1e7a45;color:#fff;border-color:#185f35;
  box-shadow:0 2px 8px rgba(30,122,69,.45);
  transform:translateY(-1px);
}
.tol-btn.act-min{
  background:#b82c2c;color:#fff;border-color:#942020;
  box-shadow:0 2px 8px rgba(184,44,44,.45);
  transform:translateY(-1px);
}
.btn-save{background:#fff8e8;color:#8a6010;border:1px solid #e0c870;}
.btn-save:hover{background:#fff0c0;border-color:#c8a830;color:#6a4800;}
@keyframes savePop{0%{transform:scale(1)}40%{transform:scale(1.15)}100%{transform:scale(1)}}
.save-pop{animation:savePop .28s ease;}

/* [改善3] 吸附/自由 模式切換區：移至 3D 視窗左上角 */
.move-mode-overlay{
  position:absolute;
  top:10px;left:10px;
  z-index:28;
  background:rgba(253,252,249,.97);
  border:1px solid var(--border);
  border-radius:10px;
  padding:7px 9px;
  box-shadow:0 2px 10px var(--shadow);
  display:flex;flex-direction:column;gap:5px;
  min-width:120px;
}
.move-mode-overlay .mmo-title{
  font-size:9px;font-weight:700;color:var(--text3);
  letter-spacing:.06em;text-align:center;margin-bottom:1px;
}
.move-mode-seg{
  display:flex;border-radius:6px;overflow:hidden;
  border:1px solid var(--border);
}
.move-mode-seg button{
  flex:1;padding:4px 6px;font-size:11px;font-weight:700;
  border:none;cursor:pointer;font-family:inherit;
  transition:all .14s;
}
.move-mode-step{
  display:flex;align-items:center;gap:5px;
}
.move-mode-step span{font-size:11px;color:var(--text2);white-space:nowrap;}
.move-mode-step input{
  width:46px;text-align:center;
  background:#fff;border:1px solid var(--border);
  color:var(--text);border-radius:4px;padding:2px 4px;
  font-size:11px;font-family:'IBM Plex Mono',monospace;outline:none;
}
/* 視圖切換欄 */
.sel-badge{position:absolute;top:44px;left:50%;transform:translateX(-50%);background:var(--accent);color:#fff;border-radius:20px;padding:5px 16px;font-size:13px;font-weight:700;z-index:20;pointer-events:none;box-shadow:0 2px 8px rgba(61,122,186,.35);white-space:nowrap;}
.view-bar{position:absolute;top:8px;left:50%;transform:translateX(-50%);display:flex;gap:3px;z-index:18;background:rgba(253,252,249,.96);border:1px solid var(--border);border-radius:10px;padding:4px 6px;box-shadow:0 2px 8px var(--shadow);}
.vbtn{border:none;border-radius:6px;background:transparent;color:var(--text2);font-size:12px;font-weight:700;padding:3px 8px;cursor:pointer;font-family:inherit;transition:all .12s;white-space:nowrap;}
.vbtn:hover{background:var(--tinfo);color:var(--accent)}
/* VIEW + 間隙顯示 合併左下角 panel */
.side-bottom-left{position:absolute;left:8px;bottom:14px;display:flex;flex-direction:column;gap:5px;z-index:18;background:rgba(253,252,249,.96);border:1px solid var(--border);border-radius:10px;padding:8px 9px;box-shadow:0 2px 8px var(--shadow);min-width:90px;}
.side-panel-title{font-size:9px;font-weight:700;color:var(--text3);letter-spacing:.05em;text-align:center;margin-bottom:3px;}
.side-opt{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text2);cursor:pointer;user-select:none;white-space:nowrap;line-height:1.7;}
.side-opt input{accent-color:var(--accent);cursor:pointer;}
/* 間隙設定 right-bottom panel */
.side-bottom-right{position:absolute;right:8px;bottom:14px;display:flex;flex-direction:column;gap:5px;z-index:18;background:rgba(253,252,249,.96);border:1px solid var(--border);border-radius:10px;padding:8px 8px;box-shadow:0 2px 8px var(--shadow);min-width:88px;}
.modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(44,40,32,.45);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:16px}
.modal-box{background:var(--panel);border:1px solid var(--border);border-radius:16px;box-shadow:0 8px 40px rgba(80,60,40,.22);width:100%;max-width:680px;max-height:90vh;overflow-y:auto;display:flex;flex-direction:column}
.modal-header{padding:16px 20px 12px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:var(--panel);z-index:2}
.modal-body{padding:16px 20px;flex:1}
.modal-footer{padding:12px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;position:sticky;bottom:0;background:var(--panel);z-index:2}
.help-sec-title{font-size:14px;font-weight:900;color:var(--accent);margin-bottom:8px;padding:4px 10px;background:var(--tinfo);border-radius:7px;border-left:3px solid var(--accent)}
.help-row{display:flex;gap:8px;margin-bottom:7px;font-size:13px;line-height:1.6}
.help-key{background:var(--panel2);border:1px solid var(--border);border-radius:4px;padding:2px 8px;font-size:11px;font-weight:700;white-space:nowrap;color:var(--text);flex-shrink:0;align-self:flex-start;margin-top:2px}
.help-desc{color:var(--text2)}
#dim-labels-wrap{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
.dim-lbl{position:absolute;pointer-events:none;font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:700;color:#cc1111;white-space:nowrap;transform:translate(-50%,-50%);background:rgba(253,252,249,.88);padding:3px 9px;border-radius:6px;border:2px solid #dd3333;}
</style>
