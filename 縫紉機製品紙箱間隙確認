let _uid=1; const uid=()=>`b${_uid++}`;
const clamp=(v,lo,hi)=>Math.max(lo,Math.min(hi,v));
const effD=(nom,tp,tm,s)=>s==='max'?Math.max(.1,nom+(tp||0)):s==='min'?Math.max(.1,nom-(tm||0)):nom;
const ORI=[(L,W,H)=>[L,W,H],(L,W,H)=>[L,H,W],(L,W,H)=>[W,L,H],(L,W,H)=>[W,H,L],(L,W,H)=>[H,L,W],(L,W,H)=>[H,W,L]];

const FLUTE_ADD={AB:{L:15,W:15,H:30},A:{L:10,W:10,H:20},B:{L:6,W:6,H:12},EB:{L:9,W:9,H:18},E:{L:3,W:3,H:6}};
const innerToOuter=(L,W,H,flute)=>{
  if(!flute||!FLUTE_ADD[flute])return{oL:L,oW:W,oH:H};
  const a=FLUTE_ADD[flute];return{oL:L+a.L,oW:W+a.W,oH:H+a.H};
};
const btEffOuter=(bt)=>{
  const{oL,oW,oH}=innerToOuter(bt.L,bt.W,bt.H,bt.flute||'');
  return{L:effD(oL,bt.tP,bt.tM,bt.tS||'nominal'),W:effD(oW,bt.tP,bt.tM,bt.tS||'nominal'),H:effD(oH,bt.tP,bt.tM,bt.tS||'nominal')};
