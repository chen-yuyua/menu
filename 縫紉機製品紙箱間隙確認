      st.current={r,sc,cam};
    }
    const{r,sc,cam}=st.current;
    while(sc.children.length>2)sc.remove(sc.children[sc.children.length-1]);
    const mx=Math.max(vL,vW,vH,1);
    const g=new T.BoxGeometry(vW/mx,vH/mx,vL/mx);
    sc.add(new T.Mesh(g,new T.MeshLambertMaterial({color:color||'#3d7aba',transparent:true,opacity:.82})));
    sc.add(new T.LineSegments(new T.EdgesGeometry(g),new T.LineBasicMaterial({color:0x555555,transparent:true,opacity:.25})));
    cam.position.set(2.1,1.575,2.1);cam.lookAt(0,0,0);cam.aspect=w/h;cam.updateProjectionMatrix();
