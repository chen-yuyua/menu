/* ─── Scene3D ─── */
function Scene3D({outer,placed,hlId,selId,onDrop,hovering,gaps,lang,onSelect,onSnap,onRotateBox,moveMode,freeStep,gapMode,showLines,ortho,onOrthoChange,onGapModeChange,onShowLinesChange}){
  const mountRef=useRef(null);
  const stRef=useRef(null);
  const camInited=useRef(false);
  const [viewStep,setViewStep]=useState(100);
  const [xray,setXray]=useState(false);
  const [toolMode,setToolMode]=useState('move'); /* v1.7: move | rotate */
  const [btnPos,setBtnPos]=useState([]);  /* unified 6-button ring */
  const [dimLabels,setDimLabels]=useState([]);  /* FIX#2#3: projected dim labels */
  const T2=I[lang];

  /* ── init Three.js ── */
  useEffect(()=>{
    const el=mountRef.current;if(!el||!window.THREE)return;
    const T=window.THREE,w=el.clientWidth||600,h=el.clientHeight||400;
    const renderer=new T.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});
    renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.setSize(w,h);
    renderer.setClearColor(0xf5f2ea,1);el.appendChild(renderer.domElement);
    const scene=new T.Scene();
    const camP=new T.PerspectiveCamera(42,w/h,1,5e4);
    const s2=w/h;
    const camO=new T.OrthographicCamera(-300*s2,300*s2,300,-300,1,5e4);
    scene.add(new T.AmbientLight(0xffffff,.78));
    const dl=new T.DirectionalLight(0xfff8f0,.6);dl.position.set(1000,2000,1000);scene.add(dl);
    const dl2=new T.DirectionalLight(0xd0e8ff,.2);dl2.position.set(-500,-500,-500);scene.add(dl2);
    const controls=new THREE.OrbitControls(camP,renderer.domElement);
    controls.enableDamping=true;controls.dampingFactor=.08;
    const grid=new T.GridHelper(2000,20,0xd8d2c8,0xe8e2d8);scene.add(grid);
    const boxGrp=new T.Group();scene.add(boxGrp);
    const itmGrp=new T.Group();scene.add(itmGrp);
    const dimGrp=new T.Group();scene.add(dimGrp);
    /* dim label anchor points (invisible) stored as userData on dimGrp */
    const selOutline=new T.LineSegments(
      new T.EdgesGeometry(new T.BoxGeometry(1,1,1)),
      new T.LineBasicMaterial({color:0xffffff,linewidth:2})
    );
    selOutline.visible=false;scene.add(selOutline);

    let animId;
    const loop=()=>{
      animId=requestAnimationFrame(loop);
      controls.update();
      const s=stRef.current;if(!s)return;
      const cam=s.useOrtho?s.camO:s.camP;
      if(s.useOrtho){s.camO.position.copy(s.camP.position);s.camO.quaternion.copy(s.camP.quaternion);s.camO.updateProjectionMatrix();}
      renderer.render(scene,cam);
      const cv=renderer.domElement;
      const W=cv.width/devicePixelRatio, H=cv.height/devicePixelRatio;
      const proj=(v3)=>{const v=v3.clone().project(s.camP);return{x:(v.x*.5+.5)*W,y:(-v.y*.5+.5)*H};};

      /* v1.7: unified 6-button ring (move OR rotate) around selected box */
      if(selOutline.visible){
        const p=selOutline.position.clone(),sc2=selOutline.scale.clone();
        const T3=window.THREE;
        const R=sc2.clone().multiplyScalar(.5);
        const OFF=20;
        // 6 directional offsets (same for both modes, orbit around box face centres)
        const offs=[
          new T3.Vector3(0,0,R.z+OFF),    // 0: +Z front
          new T3.Vector3(0,0,-R.z-OFF),   // 1: -Z back
          new T3.Vector3(R.x+OFF,0,0),    // 2: +X right
          new T3.Vector3(-R.x-OFF,0,0),   // 3: -X left
          new T3.Vector3(0,R.y+OFF,0),    // 4: +Y up
          new T3.Vector3(0,-R.y-OFF,0),   // 5: -Y down
        ];
        const mode=stRef.current.toolMode||'move';
        if(mode==='move'){
          const dirs=[0,1,2,3,4,5];
          const icons=['↑','↓','→','←','↑','↓'];
          const cls=['mv-pz','mv-nz','mv-px','mv-nx','mv-py','mv-ny'];
          setBtnPos(offs.map((off,i)=>{
            const r2d=proj(p.clone().add(off));
            return{i,x:r2d.x,y:r2d.y,mode:'move',dir:dirs[i],icon:icons[i],cls:cls[i]};
          }));
        } else {
          // rotate mode: same 6 positions but different meaning
          const axes=[{a:'z',s:1},{a:'z',s:-1},{a:'y',s:1},{a:'y',s:-1},{a:'x',s:1},{a:'x',s:-1}];
          const icons=['↻','↺','↻','↺','↻','↺'];
          const cls=['rv-zp','rv-zn','rv-yp','rv-yn','rv-xp','rv-xn'];
          setBtnPos(offs.map((off,i)=>{
            const r2d=proj(p.clone().add(off));
            return{i,x:r2d.x,y:r2d.y,mode:'rotate',axis:axes[i].a,sign:axes[i].s,icon:icons[i],cls:cls[i]};
          }));
        }
      } else {setBtnPos([]);}

      /* FIX#2#3: project dimension label anchor points */
      if(s.dimAnchors&&s.dimAnchors.length>0){
        setDimLabels(s.dimAnchors.map(a=>{
          const r=proj(a.pos);return{x:r.x,y:r.y,text:a.text,color:a.color||'#cc1111'};
        }));
      } else setDimLabels([]);
    };
    loop();
    stRef.current={renderer,scene,camP,camO,controls,boxGrp,itmGrp,dimGrp,grid,selOutline,useOrtho:false,dimAnchors:[]};
    const resize=()=>{
      if(!el)return;
      const rw=el.clientWidth,rh=el.clientHeight;
      renderer.setSize(rw,rh);camP.aspect=rw/rh;camP.updateProjectionMatrix();
      const ra=rw/rh;camO.left=-300*ra;camO.right=300*ra;camO.top=300;camO.bottom=-300;camO.updateProjectionMatrix();
    };
    const ro=new ResizeObserver(resize);ro.observe(el);
    return()=>{cancelAnimationFrame(animId);ro.disconnect();renderer.dispose();el.innerHTML='';stRef.current=null;camInited.current=false;};
  },[]);

  useEffect(()=>{if(stRef.current)stRef.current.useOrtho=ortho;},[ortho]);
  useEffect(()=>{if(stRef.current)stRef.current.toolMode=toolMode;},[toolMode]);

  /* ── rebuild scene ── */
  useEffect(()=>{
    const s=stRef.current;if(!s||!window.THREE)return;
    const T=window.THREE,{renderer,scene,camP,camO,controls,boxGrp,itmGrp,dimGrp,grid,selOutline}=s;
    [boxGrp,itmGrp,dimGrp].forEach(g=>{while(g.children.length){const c=g.children[0];c.geometry?.dispose();c.material?.dispose?.();g.remove(c);}});
    s.dimAnchors=[];

    const oL=outer.L||400,oW=outer.W||300,oH=outer.H||200;
    grid.position.y=-oH/2;
    const bGeo=new T.BoxGeometry(oW,oH,oL);
    boxGrp.add(new T.LineSegments(new T.EdgesGeometry(bGeo),new T.LineBasicMaterial({color:0x7090b8})));
    boxGrp.add(new T.Mesh(bGeo,new T.MeshLambertMaterial({color:0xd8e8f8,transparent:true,opacity:.07,side:T.BackSide})));

    if(!camInited.current){
      const md=Math.max(oL,oW,oH);
      camP.position.set(md*1.3,md*.9,md*1.3);controls.target.set(0,0,0);controls.update();
      camInited.current=true;
    }

    const vis=Math.round(placed.length*clamp(viewStep,0,100)/100);
    const visSlice=placed.slice(0,vis);
    // Detect overlaps: set of box ids that overlap with any other
    const overlapSet=new Set();
    for(let i=0;i<visSlice.length;i++){
      for(let j=i+1;j<visSlice.length;j++){
        const a=visSlice[i],b=visSlice[j];
        if(a.x<b.x+b.w-.5&&a.x+a.w>b.x+.5&&a.y<b.y+b.h-.5&&a.y+a.h>b.y+.5&&a.z<b.z+b.d-.5&&a.z+a.d>b.z+.5){
          overlapSet.add(a.id);overlapSet.add(b.id);
        }
      }
    }
    const meshMap={};
    visSlice.forEach(pb=>{
      const isHL=pb.id===hlId||pb.id===selId;
      const isOut=pb.x+pb.w>oW+.5||pb.y+pb.h>oH+.5||pb.z+pb.d>oL+.5;
      const isOverlap=overlapSet.has(pb.id);
      const geo=new T.BoxGeometry(pb.w,pb.h,pb.d);
      const col=new T.Color(pb.color||'#3d7aba');
      if(isOut||isOverlap)col.set(0xcc3030);
      const mat=new T.MeshLambertMaterial({color:col,transparent:true,opacity:xray?.28:isHL?.92:.78});
      const mesh=new T.Mesh(geo,mat);
      mesh.position.set(pb.x+pb.w/2-oW/2,pb.y+pb.h/2-oH/2,pb.z+pb.d/2-oL/2);
      mesh.userData.pbId=pb.id;itmGrp.add(mesh);
      const edgeColor=(isOut||isOverlap)?0xcc1111:isHL?0x222222:0x888888;
      mesh.add(new T.LineSegments(new T.EdgesGeometry(geo),new T.LineBasicMaterial({color:edgeColor,transparent:true,opacity:isHL||isOverlap?.6:.17})));
      meshMap[pb.id]=mesh;
    });
    s.meshMap=meshMap;

    const sel=placed.find(p=>p.id===selId);
    if(sel&&meshMap[sel.id]){
      const m=meshMap[sel.id];
      selOutline.geometry.dispose();
      selOutline.geometry=new T.EdgesGeometry(new T.BoxGeometry(sel.w+4,sel.h+4,sel.d+4));
      selOutline.position.copy(m.position);selOutline.scale.set(sel.w,sel.h,sel.d);selOutline.visible=true;
    } else selOutline.visible=false;

    /* ─ dimension lines (FIX#2 #3) ─ */
    // Always rebuild dimAnchors so labels project correctly even without lines
    s.dimAnchors=[];
    if(showLines&&placed.length>0){
      const hw=oW/2,hh=oH/2,hl=oL/2;
      const RED=new T.LineBasicMaterial({color:0xdd1111});
      const DGRAY=new T.LineBasicMaterial({color:0xdd1111,transparent:true,opacity:.5});

      const addSeg=(p1,p2,mat)=>{
        dimGrp.add(new T.Line(new T.BufferGeometry().setFromPoints([p1,p2]),mat||RED));
      };
      // Arrow head tick: cross mark at endpoint, perpendicular to dim line direction
      const addArrowHead=(pt,dir,len=7)=>{
        // two perpendicular axes to dim direction
        const up=new T.Vector3(0,1,0);
        const perp1=new T.Vector3().crossVectors(dir,up).normalize();
        if(perp1.lengthSq()<.01){perp1.set(1,0,0);}
        const perp2=new T.Vector3().crossVectors(dir,perp1).normalize();
        addSeg(pt.clone().addScaledVector(perp1,-len),pt.clone().addScaledVector(perp1,len),RED);
        addSeg(pt.clone().addScaledVector(perp2,-len),pt.clone().addScaledVector(perp2,len),RED);
      };
      // Extension line from box face/wall to dim line point
      const extLine=(from,to)=>addSeg(from,to,DGRAY);
      // Label at midpoint (color optional, for each-box mode)
      const addLbl=(p1,p2,text,color)=>{s.dimAnchors.push({pos:p1.clone().lerp(p2,.5),text,color:color||null});};

      if(gapMode==='total'){
        // Max extents of all placed boxes (local coords, origin bottom-left-back)
        const mz=Math.max(...placed.map(p=>p.z+p.d));
        const mx2=Math.max(...placed.map(p=>p.x+p.w));
        const my2=Math.max(...placed.map(p=>p.y+p.h));
        const gapL=+(oL-mz).toFixed(1);
        const gapW=+(oW-mx2).toFixed(1);
        const gapH=+(oH-my2).toFixed(1);
        const OFF=28; // offset of dim line beyond outer box face

        /* ── L gap (Z axis): from box max-Z face (mz) to outer +Z wall (oL) ──
           Dim line: outside -X face, runs Z from mz to oL (world: mz-hl to +hl)
           Extension lines: from box face point IN to dim line start; from outer wall IN to dim line end */
        if(gapL>0.5){
          const dlx=-hw-OFF, dly=hh*0.55;
          const dimA=new T.Vector3(dlx,dly,mz-hl);   // at box face level
          const dimB=new T.Vector3(dlx,dly,hl);       // at outer wall
          addSeg(dimA,dimB);
          const dimDir=new T.Vector3(0,0,1);
          addArrowHead(dimA,dimDir);addArrowHead(dimB,dimDir);
          // Extension A: from box max-Z face (inside box, at box x=0 midpoint) → out to dim line
          extLine(new T.Vector3(0,    dly, mz-hl), dimA);   // starts at box face
          // Extension B: from outer +Z wall → dim line end
          extLine(new T.Vector3(-hw,  dly, hl),    dimB);
          addLbl(dimA,dimB,`L間隙 ${gapL>=0?'+':''}${gapL}mm`);
        }

        /* ── W gap (X axis): from box max-X face (mx2) to outer +X wall (oW) ──
           Dim line: outside +Z face, runs X from mx2 to oW */
        if(gapW>0.5){
          const dlz=hl+OFF, dly=hh*0.55;
          const dimA=new T.Vector3(mx2-hw,dly,dlz);
          const dimB=new T.Vector3(hw,     dly,dlz);
          addSeg(dimA,dimB);
          const dimDir=new T.Vector3(1,0,0);
          addArrowHead(dimA,dimDir);addArrowHead(dimB,dimDir);
          // Extension A: from box max-X face (inside, at z midpoint)
          extLine(new T.Vector3(mx2-hw, dly, 0),   dimA);
          // Extension B: from outer +X wall
          extLine(new T.Vector3(hw,     dly, hl),  dimB);
          addLbl(dimA,dimB,`W間隙 ${gapW>=0?'+':''}${gapW}mm`);
        }

        /* ── H gap (Y axis): from box max-Y face (my2) to outer +Y wall (oH) ──
           Dim line: outside +X face, runs Y from my2 to oH */
        if(gapH>0.5){
          const dlx=hw+OFF, dlz=0;
          const dimA=new T.Vector3(dlx,my2-hh,dlz);
          const dimB=new T.Vector3(dlx,hh,     dlz);
          addSeg(dimA,dimB);
          const dimDir=new T.Vector3(0,1,0);
          addArrowHead(dimA,dimDir);addArrowHead(dimB,dimDir);
          // Extension A: from box max-Y face (inside, at x midpoint)
          extLine(new T.Vector3(0,   my2-hh, dlz), dimA);
          // Extension B: from outer +Y wall
          extLine(new T.Vector3(hw,  hh,     dlz), dimB);
          addLbl(dimA,dimB,`H間隙 ${gapH>=0?'+':''}${gapH}mm`);
        }

      } else {
        /* FIX#2 each-box mode: draw gap lines from EACH box face to outer wall, with labels */
        const targets=selId?placed.filter(p=>p.id===selId):placed.slice(0,vis);
        targets.forEach(pb=>{
          const pbColor=pb.color||'#3d7aba';
          // World-space face coordinates
          const xMin=pb.x-hw,     xMax=pb.x+pb.w-hw;
          const yMin=pb.y-hh,     yMax=pb.y+pb.h-hh;
          const zMin=pb.z-hl,     zMax=pb.z+pb.d-hl;
          const cx=(xMin+xMax)/2, cy=(yMin+yMax)/2, cz=(zMin+zMax)/2;
          const OFF2=pb.h/2+14; // raise dim lines above box top

          const dimDir_Z=new T.Vector3(0,0,1);
          const dimDir_X=new T.Vector3(1,0,0);
          const dimDir_Y=new T.Vector3(0,1,0);

          /* +Z (front gap): box zMax face → outer +Z wall */
          const gZp=+(oL-(pb.z+pb.d)).toFixed(1);
          if(gZp>0.5){
            const dly=yMax+OFF2;
            const pA=new T.Vector3(cx,dly,zMax), pB=new T.Vector3(cx,dly,hl);
            addSeg(pA,pB); addArrowHead(pA,dimDir_Z); addArrowHead(pB,dimDir_Z);
            extLine(new T.Vector3(cx,yMax,zMax),pA); extLine(new T.Vector3(cx,yMax,hl),pB);
            addLbl(pA,pB,`+Z ${gZp}mm`,pbColor);
          }
          /* -Z (back gap): outer -Z wall → box zMin face */
          const gZn=+(pb.z).toFixed(1);
          if(gZn>0.5){
            const dly=yMax+OFF2;
            const pA=new T.Vector3(cx,dly,-hl), pB=new T.Vector3(cx,dly,zMin);
            addSeg(pA,pB); addArrowHead(pA,dimDir_Z); addArrowHead(pB,dimDir_Z);
            extLine(new T.Vector3(cx,yMax,-hl),pA); extLine(new T.Vector3(cx,yMax,zMin),pB);
            addLbl(pA,pB,`-Z ${gZn}mm`,pbColor);
          }
          /* +X (right gap): box xMax face → outer +X wall */
          const gXp=+(oW-(pb.x+pb.w)).toFixed(1);
          if(gXp>0.5){
            const dly=yMax+OFF2;
            const pA=new T.Vector3(xMax,dly,cz), pB=new T.Vector3(hw,dly,cz);
            addSeg(pA,pB); addArrowHead(pA,dimDir_X); addArrowHead(pB,dimDir_X);
            extLine(new T.Vector3(xMax,yMax,cz),pA); extLine(new T.Vector3(hw,yMax,cz),pB);
            addLbl(pA,pB,`+X ${gXp}mm`,pbColor);
          }
          /* -X (left gap): outer -X wall → box xMin face */
          const gXn=+(pb.x).toFixed(1);
          if(gXn>0.5){
            const dly=yMax+OFF2;
            const pA=new T.Vector3(-hw,dly,cz), pB=new T.Vector3(xMin,dly,cz);
            addSeg(pA,pB); addArrowHead(pA,dimDir_X); addArrowHead(pB,dimDir_X);
            extLine(new T.Vector3(-hw,yMax,cz),pA); extLine(new T.Vector3(xMin,yMax,cz),pB);
            addLbl(pA,pB,`-X ${gXn}mm`,pbColor);
          }
          /* +Y (top gap): box yMax face → outer +Y wall */
          const gYp=+(oH-(pb.y+pb.h)).toFixed(1);
          if(gYp>0.5){
            const dlz=zMax+14;
            const pA=new T.Vector3(cx,yMax,dlz), pB=new T.Vector3(cx,hh,dlz);
            addSeg(pA,pB); addArrowHead(pA,dimDir_Y); addArrowHead(pB,dimDir_Y);
            extLine(new T.Vector3(cx,yMax,zMax),pA); extLine(new T.Vector3(cx,hh,zMax),pB);
            addLbl(pA,pB,`+Y ${gYp}mm`,pbColor);
          }
          /* -Y (bottom gap): outer -Y wall → box yMin face */
          const gYn=+(pb.y).toFixed(1);
          if(gYn>0.5){
            const dlz=zMax+14;
            const pA=new T.Vector3(cx,-hh,dlz), pB=new T.Vector3(cx,yMin,dlz);
            addSeg(pA,pB); addArrowHead(pA,dimDir_Y); addArrowHead(pB,dimDir_Y);
            extLine(new T.Vector3(cx,-hh,zMax),pA); extLine(new T.Vector3(cx,yMin,zMax),pB);
            addLbl(pA,pB,`-Y ${gYn}mm`,pbColor);
          }
        });
      }
    }
  },[outer,placed,viewStep,xray,hlId,selId,gapMode,showLines]);

  /* view presets */
  const setView=useCallback((preset)=>{
    const s=stRef.current;if(!s)return;
    const{camP,controls}=s;
    const oL=outer.L||400,oW=outer.W||300,oH=outer.H||200;
    const md=Math.max(oL,oW,oH)*1.6;
    const map={front:[0,0,md],back:[0,0,-md],left:[-md,0,0],right:[md,0,0],top:[0,md,.001],iso:[md*.85,md*.65,md*.85]};
    const pos=map[preset];
    if(pos){camP.position.set(...pos);controls.target.set(0,0,0);controls.update();}
  },[outer]);

  /* raycasting – no camera reset */
