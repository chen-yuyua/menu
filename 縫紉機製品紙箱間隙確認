const clamp=(v,lo,hi)=>Math.max(lo,Math.min(hi,v));
const effD=(nom,tp,tm,s)=>s==='max'?Math.max(.1,nom+(tp||0)):s==='min'?Math.max(.1,nom-(tm||0)):nom;
const ORI=[(L,W,H)=>[L,W,H],(L,W,H)=>[L,H,W],(L,W,H)=>[W,L,H],(L,W,H)=>[W,H,L],(L,W,H)=>[H,L,W],(L,W,H)=>[H,W,L]];

/* FIX#1: rotate a placed box 90deg around axis, clamp to outer dims */
function rotatePlaced(pb, axis, sign, oL, oW, oH){
  // swap dims depending on axis of rotation
  let nw=pb.w, nh=pb.h, nd=pb.d;
  if(axis==='y'){ // horizontal: swap w and d
    nw=pb.d; nd=pb.w;
  } else if(axis==='x'){ // vertical around X: swap h and d
    nh=pb.d; nd=pb.h;
  } else if(axis==='z'){ // vertical around Z: swap w and h
    nw=pb.h; nh=pb.w;
  }
  // clamp position so box stays inside outer
  const nx=clamp(pb.x,0,Math.max(0,oW-nw));
  const ny=clamp(pb.y,0,Math.max(0,oH-nh));
  const nz=clamp(pb.z,0,Math.max(0,oL-nd));
  return {...pb, w:nw, h:nh, d:nd, x:nx, y:ny, z:nz};
}

function snapNearest(pb,others,oL,oW,oH,dir){
  const configs=[
    {axis:'z',sign:+1,pbFront:p=>p.z+p.d,pbBack:p=>p.z,otherFace:p=>p.z,wall:oL-pb.d},
    {axis:'z',sign:-1,pbFront:p=>p.z,pbBack:p=>p.z+p.d,otherFace:p=>p.z+p.d,wall:0},
    {axis:'x',sign:+1,pbFront:p=>p.x+p.w,pbBack:p=>p.x,otherFace:p=>p.x,wall:oW-pb.w},
    {axis:'x',sign:-1,pbFront:p=>p.x,pbBack:p=>p.x+p.w,otherFace:p=>p.x+p.w,wall:0},
    {axis:'y',sign:+1,pbFront:p=>p.y+p.h,pbBack:p=>p.y,otherFace:p=>p.y,wall:oH-pb.h},
    {axis:'y',sign:-1,pbFront:p=>p.y,pbBack:p=>p.y+p.h,otherFace:p=>p.y+p.h,wall:0},
  ];
  const c=configs[dir];const{axis,sign,pbFront,pbBack,otherFace,wall}=c;
  const op=(a,b)=>{
    if(axis==='z')return a.x<b.x+b.w-.1&&a.x+a.w>b.x+.1&&a.y<b.y+b.h-.1&&a.y+a.h>b.y+.1;
    if(axis==='x')return a.z<b.z+b.d-.1&&a.z+a.d>b.z+.1&&a.y<b.y+b.h-.1&&a.y+a.h>b.y+.1;
    if(axis==='y')return a.x<b.x+b.w-.1&&a.x+a.w>b.x+.1&&a.z<b.z+b.d-.1&&a.z+a.d>b.z+.1;
  };
  let target=wall;
  others.forEach(o=>{
    if(!op(pb,o))return;
    const face=otherFace(o),pbLead=pbFront(pb);
    if(sign>0&&face>=pbLead-.1){const cand=face-(pbFront(pb)-pbBack(pb));if(cand<target)target=cand;}
    else if(sign<0&&face<=pbLead+.1){if(face>target)target=face;}
  });
  const np={...pb};np[axis]=clamp(target,0,wall);return np;
}

function freeMove(pb,oL,oW,oH,dir,step){
  const np={...pb};const s=Math.max(1,step);
  if(dir===0)np.z=clamp(np.z+s,0,oL-np.d);
  if(dir===1)np.z=clamp(np.z-s,0,oL-np.d);
  if(dir===2)np.x=clamp(np.x+s,0,oW-np.w);
  if(dir===3)np.x=clamp(np.x-s,0,oW-np.w);
  if(dir===4)np.y=clamp(np.y+s,0,oH-np.h);
  if(dir===5)np.y=clamp(np.y-s,0,oH-np.h);
  return np;
}

/* ─── MiniBoxView ─── */
function MiniBoxView({L,W,H,oriIdx=0,color}){
