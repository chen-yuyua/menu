          React.createElement('div',{style:{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:5}},
            React.createElement('div',{className:'panel-label',style:{margin:0}},T.placedTitle(placed.length)),
            React.createElement('span',{style:{fontSize:13,color:'var(--text3)'}},T.placedHint)
          ),
          selBox&&React.createElement('div',{style:{background:'var(--tinfo)',border:'1.5px solid var(--accent)',borderRadius:9,padding:'8px 10px',marginBottom:7,display:'flex',flexDirection:'column',gap:7}},
            React.createElement('div',{style:{display:'flex',alignItems:'center',justifyContent:'space-between'}},
              React.createElement('span',{style:{fontSize:13,fontWeight:900,color:'var(--accent)'}},`✦ ${selBox.name}`),
              React.createElement('button',{className:'btn btn-xs btn-ghost',style:{fontSize:9},onClick:()=>setSelId(null)},T.deselect)
            ),
            /* size display of selected box */
            React.createElement('div',{style:{fontSize:13,color:'var(--text3)',fontFamily:'IBM Plex Mono'}},
              `${selBox.w}×${selBox.h}×${selBox.d} mm`
            ),
            React.createElement('div',{style:{display:'flex',gap:0,borderRadius:7,overflow:'hidden',border:'1px solid var(--border)'}},
              React.createElement('button',{style:{flex:1,padding:'5px 4px',fontSize:12,fontWeight:700,border:'none',cursor:'pointer',fontFamily:'inherit',background:moveMode==='snap'?'var(--accent)':'var(--panel2)',color:moveMode==='snap'?'#fff':'var(--text2)',transition:'all .15s'},onClick:()=>setMoveMode('snap')},T.modeSnap),
              React.createElement('button',{style:{flex:1,padding:'5px 4px',fontSize:12,fontWeight:700,border:'none',borderLeft:'1px solid var(--border)',cursor:'pointer',fontFamily:'inherit',background:moveMode==='free'?'var(--accent2)':'var(--panel2)',color:moveMode==='free'?'#fff':'var(--text2)',transition:'all .15s'},onClick:()=>setMoveMode('free')},T.modeFree)
            ),
            moveMode==='free'&&React.createElement('div',{style:{display:'flex',alignItems:'center',gap:6}},
              React.createElement('span',{style:{fontSize:12,color:'var(--text2)',whiteSpace:'nowrap'}},T.stepLabel),
              React.createElement('input',{type:'number',min:1,max:500,className:'qty-inp',style:{width:54},value:freeStep,onChange:e=>setFreeStep(Math.max(1,+e.target.value))})
            ),
            React.createElement('div',{style:{fontSize:13,color:'var(--text2)',lineHeight:1.5}},moveMode==='snap'?T.snapHint:T.freeHint),
            React.createElement('div',{style:{fontSize:13,color:'var(--text3)',lineHeight:1.5}},lang==='zh'?'⌨ 方向鍵移動（Shift+↑↓=Z軸）':'⌨ 矢印キー移動（Shift+↑↓=Z軸）'),
            /* FIX#4: rotation hint in right panel */
            React.createElement('div',{style:{fontSize:13,color:'var(--text3)',lineHeight:1.5,borderTop:'1px dashed var(--border)',paddingTop:5}},
              lang==='zh'?'🔀移動 / 🔄旋轉：點標籤切換功能':'🔀移動 / 🔄回転：タブで機能切替'
            ),
            React.createElement('button',{className:'btn btn-danger btn-xs',style:{width:'100%',fontSize:10},onClick:()=>{removeP(selId);setSelId(null);}},T.removeBtn)
          ),
          React.createElement('div',{style:{maxHeight:160,overflowY:'auto',display:'flex',flexDirection:'column',gap:4}},
            placed.map((pb,i)=>React.createElement('div',{
              key:pb.id,className:`placed-chip${pb.id===selId?' sel':''}`,
              onMouseEnter:()=>setHlId(pb.id),onMouseLeave:()=>setHlId(null),
              onClick:()=>setSelId(id=>id===pb.id?null:pb.id)
            },
              React.createElement('div',{style:{width:9,height:9,borderRadius:2,background:pb.color,flexShrink:0}}),
              React.createElement('span',{style:{color:pb.id===selId?'var(--accent)':'var(--text2)',fontSize:12,flex:1,fontWeight:pb.id===selId?700:400,overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}},`#${i+1} ${pb.name}`),
              React.createElement('span',{className:'mono',style:{fontSize:8,color:'var(--text3)',flexShrink:0}},`${pb.x},${pb.y},${pb.z}`),
              React.createElement('span',{style:{fontSize:12,color:'var(--err)',opacity:.6,cursor:'pointer',paddingLeft:3,flexShrink:0},onClick:e=>{e.stopPropagation();removeP(pb.id);}},'✕')
            ))
          )
        )
      )
    ),
    showHelp&&React.createElement(HelpModal,{onClose:()=>setShowHelp(false),lang})
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
</script>
</body>
