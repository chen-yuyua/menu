    setPlaced(prev=>prev.map(p=>{
      if(p.typeId!==u.id)return p;
      const upd={...p};
      if(u.name)upd.name=u.name;
      // Recalculate effective dims with new tolerance/orientation
      const[nd,nw,nh]=ORI[u._ori??0](
        effD(u.L,u.tP,u.tM,u.tS||'nominal'),
        effD(u.W,u.tP,u.tM,u.tS||'nominal'),
        effD(u.H,u.tP,u.tM,u.tS||'nominal')
