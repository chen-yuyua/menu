  /* auto-place trigger – use apRef queue to prevent duplication */
  const apRef=useRef(null);
  useEffect(()=>{
    const bt=bts.find(b=>b._ap);if(!bt)return;
    if(apRef.current===bt.id)return; // guard: already processing
    apRef.current=bt.id;
    setBts(prev=>prev.map(b=>b._ap?{...b,_ap:false}:b));
