  const[lang,setLang]=useState((SAVED_STATE&&SAVED_STATE.lang)||'zh');
  const T=I[lang];
  const[outer,setOuter]=useState((SAVED_STATE&&SAVED_STATE.outer)||{L:500,W:400,H:300,tP:0,tM:0,tS:'nominal'});
  const[bts,setBts]=useState(()=>{
    if(SAVED_STATE&&SAVED_STATE.bts&&SAVED_STATE.bts.length)return SAVED_STATE.bts;
    return[
      {id:uid(),name:'Box A',L:120,W:100,H:80,qty:1,color:'#3d7aba',tP:0,tM:0,tS:'nominal',_ori:0,flute:''},
      {id:uid(),name:'Box B',L:150,W:120,H:60,qty:1,color:'#2a9d7c',tP:0,tM:0,tS:'nominal',_ori:0,flute:''},
    ];
  });
  const[placed,setPlaced]=useState((SAVED_STATE&&SAVED_STATE.placed)||[]);
  const[hlId,setHlId]=useState(null);
  const[selId,setSelId]=useState(null);
  const[hovering,setHovering]=useState(false);
  const[showHelp,setShowHelp]=useState(false);
  const[moveMode,setMoveMode]=useState((SAVED_STATE&&SAVED_STATE.moveMode)||'snap');
  const[freeStep,setFreeStep]=useState((SAVED_STATE&&SAVED_STATE.freeStep)||10);
  const[gapMode,setGapMode]=useState((SAVED_STATE&&SAVED_STATE.gapMode)||'total');
  const[showLines,setShowLines]=useState((SAVED_STATE&&SAVED_STATE.showLines)||false);
  const[ortho,setOrtho]=useState((SAVED_STATE&&SAVED_STATE.ortho)||false);
  const[dialOpen,setDialOpen]=useState(false);
  const[saveDone,setSaveDone]=useState(false);

  const outerRef=useRef(outer);
  useEffect(()=>{outerRef.current=outer;},[outer]);

  /* Fix bug1+5: updBt must always use fresh outer and recalculate placed dims correctly.
     Using outerRef avoids stale closure. setPlaced functional form ensures latest placed. */
  const updBt=useCallback(u=>{
    setBts(prev=>prev.map(b=>b.id===u.id?u:b));
    setPlaced(prev=>prev.map(p=>{
      if(p.typeId!==u.id)return p;
      const upd={...p};
      if(u.name)upd.name=u.name;
      const _ue=btEffOuter(u);
      const[nd,nw,nh]=ORI[u._ori??0](_ue.L,_ue.W,_ue.H);
      const oc=outerRef.current;
      upd.w=nw;upd.h=nh;upd.d=nd;
      upd.x=clamp(p.x,0,Math.max(0,oc.W-nw));
      upd.y=clamp(p.y,0,Math.max(0,oc.H-nh));
      upd.z=clamp(p.z,0,Math.max(0,oc.L-nd));
      return upd;
    }));
  },[]);

  /* Effective outer dims considering outer tolerance (fix 4) */
  const effOuter=useMemo(()=>({
    L:effD(outer.L,outer.tP,outer.tM,outer.tS||'nominal'),
    W:effD(outer.W,outer.tP,outer.tM,outer.tS||'nominal'),
    H:effD(outer.H,outer.tP,outer.tM,outer.tS||'nominal'),
  }),[outer]);

  const gaps=useMemo(()=>{
    if(!placed.length)return{L:effOuter.L,W:effOuter.W,H:effOuter.H};
    return{
      L:+(effOuter.L-Math.max(...placed.map(p=>p.z+p.d))).toFixed(1),
      W:+(effOuter.W-Math.max(...placed.map(p=>p.x+p.w))).toFixed(1),
      H:+(effOuter.H-Math.max(...placed.map(p=>p.y+p.h))).toFixed(1),
    };
  },[effOuter,placed]);
  const totalVol=useMemo(()=>placed.reduce((s,p)=>s+p.w*p.h*p.d,0),[placed]);
  const outerVol=effOuter.L*effOuter.W*effOuter.H;
  const utilRate=outerVol>0?Math.round(totalVol/outerVol*100):0;
  const counts=useMemo(()=>{const m={};placed.forEach(p=>{m[p.typeId]=(m[p.typeId]||0)+1;});return m;},[placed]);

  const apRef=useRef(null);
  useEffect(()=>{
    const bt=bts.find(b=>b._ap);if(!bt)return;
    if(apRef.current===bt.id)return;
    apRef.current=bt.id;
    setBts(prev=>prev.map(b=>b._ap?{...b,_ap:false}:b));
    const _ape=btEffOuter(bt);const[d,w,h]=ORI[bt._ori??0](_ape.L,_ape.W,_ape.H);
    setPlaced(prev=>{
      let cur=[...prev];
      for(let i=0;i<bt.qty;i++){const pos=findPos(outer.L,outer.W,outer.H,cur,d,w,h);if(!pos)break;cur=[...cur,{id:uid(),typeId:bt.id,name:bt.name,color:bt.color,...pos,w,h,d}];}
      return cur;
    });
    setTimeout(()=>{apRef.current=null;},100);
  },[bts,outer]);

  useEffect(()=>{setDialOpen(!!selId);},[selId]);

  const handleAutoAll=()=>setPlaced(autoPack(outer.L,outer.W,outer.H,bts));
  const handleClear=()=>{setPlaced([]);setSelId(null);};

  const handleDrop=useCallback(e=>{
    const typeId=e.dataTransfer.getData('boxTypeId');if(!typeId)return;
    const bt=bts.find(b=>b.id===typeId);if(!bt)return;
    const _de=btEffOuter(bt);const[d,w,h]=ORI[bt._ori??0](_de.L,_de.W,_de.H);
    const pos=findPos(outer.L,outer.W,outer.H,placed,d,w,h)||{x:0,y:0,z:0};
    setPlaced(prev=>[...prev,{id:uid(),typeId:bt.id,name:bt.name,color:bt.color,...pos,w,h,d}]);
    setHovering(false);
  },[bts,outer,placed]);

  const handleSnap=useCallback((id,dir)=>{
    if(!id)return;
    const pb=placed.find(p=>p.id===id);if(!pb)return;
    let moved;
    if(moveMode==='snap'){const others=placed.filter(p=>p.id!==id);moved=snapNearest(pb,others,outer.L,outer.W,outer.H,dir);}
    else moved=freeMove(pb,outer.L,outer.W,outer.H,dir,freeStep);
    setPlaced(prev=>prev.map(p=>p.id===id?{...p,...moved}:p));
  },[placed,outer,moveMode,freeStep]);

  const handleRotateBox=useCallback((id,axis,sign)=>{
    if(!id)return;
    const pb=placed.find(p=>p.id===id);if(!pb)return;
    setPlaced(prev=>prev.map(p=>p.id===id?rotatePlaced(pb,axis,sign,outer.L,outer.W,outer.H):p));
  },[placed,outer]);

  const removeP=id=>{setPlaced(prev=>prev.filter(p=>p.id!==id));if(selId===id)setSelId(null);};
  const addBt=()=>{const c=COLORS[bts.length%COLORS.length];setBts(prev=>[...prev,{id:uid(),name:`Box ${String.fromCharCode(65+prev.length%26)}`,L:100,W:80,H:60,qty:1,color:c,tP:0,tM:0,tS:'nominal',_ori:0,flute:''}]);};
  const selBox=placed.find(p=>p.id===selId);

  /* Scene3D に onModeChange / onFreeStepChange を渡す */
  const handleModeChange=useCallback(m=>setMoveMode(m),[]);
  const handleFreeStepChange=useCallback(v=>setFreeStep(v),[]);

  /* ── 儲存檔案 / ファイル保存 ── */
  const handleSave=useCallback(()=>{
    const state={lang,outer,bts,placed,moveMode,freeStep,gapMode,showLines,ortho};
    const stateJson=JSON.stringify(state);
    // 讀取本頁 HTML，把佔位符替換為實際狀態
    const html=document.documentElement.outerHTML;
    // 替換 SAVED_STATE 行：把 null; /* __SAVED_STATE_JSON__ */ 換成實際 JSON
    const saved=html.replace(
      /const SAVED_STATE=null;\s*\/\*\s*__SAVED_STATE_JSON__\s*\*\//,
      `const SAVED_STATE=${stateJson};`
    );
    // 建立 Blob 並觸發下載
    const blob=new Blob([saved],{type:'text/html;charset=utf-8'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    const now=new Date();
    const ts=`${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}${String(now.getDate()).padStart(2,'0')}_${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}`;
    a.href=url;a.download=`ミシン包裝設計_${ts}.html`;
    document.body.appendChild(a);a.click();
    setTimeout(()=>{URL.revokeObjectURL(url);document.body.removeChild(a);},1000);
    setSaveDone(true);setTimeout(()=>setSaveDone(false),2200);
  },[lang,outer,bts,placed,moveMode,freeStep,gapMode,showLines,ortho]);

  return React.createElement('div',{className:'app-root'},
    /* header */
    React.createElement('header',{style:{padding:'7px 16px',borderBottom:'1px solid var(--border)',display:'flex',alignItems:'center',justifyContent:'space-between',background:'linear-gradient(90deg,var(--panel),#f5f2ea)',flexShrink:0,boxShadow:'0 1px 4px var(--shadow)'}},
      React.createElement('div',{style:{display:'flex',alignItems:'center',gap:10}},
        React.createElement('div',{style:{width:26,height:26,background:'linear-gradient(135deg,var(--accent),var(--accent2))',borderRadius:6,display:'flex',alignItems:'center',justifyContent:'center',fontSize:13}},'📦'),
        React.createElement('h1',{style:{fontSize:13,fontWeight:900,lineHeight:1.2}},
          React.createElement('span',{className:'header-accent'},T.title),
          React.createElement('span',{style:{fontSize:11,color:'var(--text3)',fontWeight:400,marginLeft:8}},T.ver)
        )
      ),
      React.createElement('div',{style:{display:'flex',gap:5,flexWrap:'wrap',justifyContent:'flex-end'}},
        React.createElement('button',{className:'btn btn-sm btn-jp',onClick:()=>setLang(l=>l==='zh'?'ja':'zh')},T.jpBtn),
        React.createElement('button',{
          className:`btn btn-sm btn-save${saveDone?' save-pop':''}`,
          onClick:handleSave,
          title:lang==='zh'?'將目前設定另存為 HTML 檔案，共有後可直接載入狀態':'現在の設定をHTMLファイルで保存。共有後に状態を再現できます'
        },saveDone?T.saveDone:T.saveBtn),
        React.createElement('button',{className:'btn btn-sm btn-help',onClick:()=>setShowHelp(true)},T.helpBtn),
        React.createElement('button',{className:'btn btn-primary btn-sm',onClick:handleAutoAll},T.autoBtn),
        React.createElement('button',{className:'btn btn-sm btn-ghost',onClick:handleClear},T.clearBtn)
      )
    ),
    React.createElement('div',{className:'app-body'},
      /* [改善4] LEFT — 紙箱列表填滿頁面高度 */
      React.createElement('div',{className:'app-left',style:{width:'clamp(200px,21vw,260px)'}},
        React.createElement('div',{className:'app-left-inner'},
          /* 外箱 */
          React.createElement('div',{style:{background:'#eff5fb',border:'1px solid #b8d0f0',borderRadius:12,padding:13,flexShrink:0}},
            React.createElement('div',{className:'panel-label',style:{color:'#5080b0'}},T.outerLbl),
            React.createElement('div',{style:{display:'grid',gridTemplateColumns:'1fr 1fr 1fr',gap:5,marginBottom:9}},
              ['L','W','H'].map(d=>React.createElement('div',{key:d},
                React.createElement('div',{style:{fontSize:13,color:'#5080b0',fontWeight:700,marginBottom:2}},{L:T.dimL,W:T.dimW,H:T.dimH}[d]),
                React.createElement('input',{type:'number',min:1,className:'inp inp-sm mono',style:{borderColor:'#b8d0f0',background:'#fff'},value:outer[d],onChange:e=>setOuter(prev=>({...prev,[d]:Math.max(1,+e.target.value)}))})
              ))
            ),
            /* outer tolerance */
            React.createElement('div',{style:{borderTop:'1px solid #c8dcf0',paddingTop:8}},
              React.createElement('div',{style:{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:6}},
                React.createElement('span',{style:{fontSize:11,fontWeight:700,color:'#5080b0'}},T.outerTolTitle),
                React.createElement('span',{style:{
                  fontSize:10,fontWeight:700,padding:'1px 7px',borderRadius:10,
                  background:outer.tS==='max'?'#e8f5ed':outer.tS==='min'?'#fce8e8':'#e8f0fb',
                  color:outer.tS==='max'?'var(--ok)':outer.tS==='min'?'var(--err)':'var(--accent)',
                  border:`1px solid ${outer.tS==='max'?'#b8ddc8':outer.tS==='min'?'#e8c4c4':'#b8d0f0'}`,
                }},T[`tol${outer.tS.charAt(0).toUpperCase()+outer.tS.slice(1)}`])
              ),
              React.createElement('div',{style:{display:'grid',gridTemplateColumns:'1fr 1fr',gap:5,marginBottom:7}},
                React.createElement('div',null,
                  React.createElement('div',{style:{fontSize:10,color:'var(--ok)',fontWeight:700,marginBottom:2}},'+'),
                  React.createElement('input',{type:'number',min:0,step:.5,className:'inp inp-sm mono',style:{borderColor:'#b8ddc8'},value:outer.tP??0,onChange:e=>setOuter(prev=>({...prev,tP:Math.max(0,+e.target.value)}))})
                ),
                React.createElement('div',null,
                  React.createElement('div',{style:{fontSize:10,color:'var(--err)',fontWeight:700,marginBottom:2}},'-'),
                  React.createElement('input',{type:'number',min:0,step:.5,className:'inp inp-sm mono',style:{borderColor:'#e8c4c4'},value:outer.tM??0,onChange:e=>setOuter(prev=>({...prev,tM:Math.max(0,+e.target.value)}))})
                )
              ),
              React.createElement('div',{style:{display:'flex',gap:4}},
                ['nominal','max','min'].map(s=>React.createElement('button',{
                  key:s,
                  className:`tol-btn ${outer.tS===s?`act-${s}`:''}`,
                  onClick:()=>setOuter(prev=>({...prev,tS:s}))
                },{nominal:T.tolNom,max:T.tolMax,min:T.tolMin}[s]))
              )
            )
          ),
          React.createElement('div',{className:'panel-label',style:{flexShrink:0}},T.boxLbl),
          /* [改善4] 紙箱列表：flex:1 撐高，自帶滾動 */
          React.createElement('div',{className:'box-list-wrap'},
            bts.map(bt=>React.createElement(BoxTypeCard,{key:bt.id,bt,lang,onUpdate:updBt,onDelete:()=>{setBts(prev=>prev.filter(b=>b.id!==bt.id));setPlaced(prev=>prev.filter(p=>p.typeId!==bt.id));}}))
          ),
          React.createElement('button',{className:'btn btn-ghost',style:{width:'100%',fontSize:12,padding:'7px',borderRadius:8,flexShrink:0},onClick:addBt},T.addBox)
        )
      ),
      /* MIDDLE */
      React.createElement('div',{
        className:'app-mid',style:{padding:'8px 8px 0'},
        onDragOver:e=>{e.preventDefault();setHovering(true);},
        onDragLeave:e=>{if(!e.currentTarget.contains(e.relatedTarget))setHovering(false);},
        onDrop:e=>{e.stopPropagation();}
      },
        React.createElement(Scene3D,{
          outer:effOuter,placed,hlId,selId,onDrop:handleDrop,hovering,lang,
          onSelect:setSelId,onSnap:handleSnap,onRotateBox:handleRotateBox,
          moveMode,freeStep,gapMode,showLines,ortho,
          onOrthoChange:setOrtho,onGapModeChange:setGapMode,onShowLinesChange:setShowLines,
          dialOpen,onDialClose:()=>{setDialOpen(false);setSelId(null);},selBox,
          onModeChange:handleModeChange,onFreeStepChange:handleFreeStepChange
        }),
        React.createElement(BoxDragPanel,{bts,lang})
      ),
      /* RIGHT */
      React.createElement('div',{className:'app-right',style:{width:'clamp(190px,20vw,250px)'}},
        React.createElement('div',{className:'app-right-inner'},
          React.createElement('div',null,
            React.createElement('div',{className:'panel-label'},T.gapTitle),
            React.createElement(GapBar,{label:T.gapL,value:gaps.L,max:effOuter.L}),
            React.createElement(GapBar,{label:T.gapW,value:gaps.W,max:effOuter.W}),
            React.createElement(GapBar,{label:T.gapH,value:gaps.H,max:effOuter.H}),
            (gaps.L<0||gaps.W<0||gaps.H<0)&&React.createElement('div',{className:'tag tag-err',style:{display:'flex',padding:'5px 10px',borderRadius:7,marginTop:6}},T.over),
            (gaps.L>=0&&gaps.W>=0&&gaps.H>=0&&placed.length>0)&&React.createElement('div',{className:'tag tag-ok',style:{display:'flex',padding:'5px 10px',borderRadius:7,marginTop:6}},T.fitOk)
          ),
          React.createElement('hr',{className:'divider'}),
          React.createElement('div',null,
            React.createElement('div',{className:'panel-label'},T.utilTitle),
            React.createElement('div',{style:{fontSize:26,fontWeight:900,fontFamily:'IBM Plex Mono',color:utilRate>=80?'var(--ok)':utilRate>=60?'var(--warn)':'var(--err)',textAlign:'center',padding:'4px 0'}},`${utilRate}%`),
            React.createElement('div',{style:{background:'var(--panel2)',borderRadius:5,height:7,overflow:'hidden'}},
              React.createElement('div',{style:{width:`${utilRate}%`,height:'100%',borderRadius:5,background:utilRate>=80?'var(--ok)':utilRate>=60?'var(--warn)':'var(--err)',transition:'width .5s'}})
            ),
            React.createElement('div',{style:{fontSize:12,color:'var(--text3)',marginTop:4,textAlign:'center'}},`${(totalVol/1e6).toFixed(2)} / ${(outerVol/1e6).toFixed(2)} dm³`)
          ),
          React.createElement('hr',{className:'divider'}),
          React.createElement('div',null,
            React.createElement('div',{className:'panel-label'},T.qtyTitle),
            bts.map(bt=>{
              const tgt=bt.qty,act=counts[bt.id]||0;
              return React.createElement('div',{key:bt.id,style:{display:'flex',alignItems:'center',gap:6,marginBottom:7}},
                React.createElement('div',{style:{width:8,height:8,borderRadius:2,background:bt.color,flexShrink:0}}),
                React.createElement('span',{style:{fontSize:13,flex:1,overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap',color:'var(--text2)'}},bt.name),
                React.createElement('span',{className:`tag ${act>=tgt?'tag-ok':act>0?'tag-warn':'tag-err'}`,style:{minWidth:38,justifyContent:'center'}},`${act}/${tgt}`)
              );
            })
          ),
          React.createElement('hr',{className:'divider'}),
          React.createElement('div',null,
            React.createElement('div',{className:'panel-label'},T.specTitle),
            ['L','W','H'].map(d=>React.createElement('div',{key:d,style:{display:'flex',justifyContent:'space-between',fontSize:13,marginBottom:5}},
              React.createElement('span',{style:{color:'var(--text2)'}},{L:T.lenL,W:T.lenW,H:T.lenH}[d]),
              React.createElement('div',{style:{display:'flex',alignItems:'center',gap:4}},
                outer.tS!=='nominal'&&React.createElement('span',{style:{fontSize:9,color:outer.tS==='max'?'var(--ok)':'var(--err)',fontWeight:700,opacity:.8}},`(${outer.tS==='max'?'+':'−'}${outer.tS==='max'?(outer.tP||0):(outer.tM||0)})`),
                React.createElement('span',{className:'mono',style:{color:'var(--accent)',fontWeight:700,fontSize:13}},`${effOuter[d]} mm`)
              )
            )),
            React.createElement('div',{style:{display:'flex',justifyContent:'space-between',fontSize:13,paddingTop:6,borderTop:'1px solid var(--border)'}},
              React.createElement('span',{style:{color:'var(--text2)'}},T.volL),
              React.createElement('span',{className:'mono',style:{fontSize:13,color:'var(--text2)'}},`${(outerVol/1e6).toFixed(1)} dm³`)
            )
          ),
          placed.length>0&&React.createElement('div',null,
            React.createElement('hr',{className:'divider',style:{margin:'4px 0 8px'}}),
            React.createElement('div',{style:{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:5}},
              React.createElement('div',{className:'panel-label',style:{margin:0}},T.placedTitle(placed.length)),
              React.createElement('span',{style:{fontSize:13,color:'var(--text3)'}},T.placedHint)
            ),
            selBox&&React.createElement('div',{style:{background:'var(--tinfo)',border:'1.5px solid var(--accent)',borderRadius:9,padding:'7px 10px',marginBottom:7,display:'flex',flexDirection:'column',gap:6}},
              React.createElement('div',{style:{display:'flex',alignItems:'center',justifyContent:'space-between'}},
                React.createElement('span',{style:{fontSize:13,fontWeight:900,color:'var(--accent)'}},`✦ ${selBox.name}`),
                React.createElement('button',{className:'btn btn-xs btn-ghost',style:{fontSize:9},onClick:()=>setSelId(null)},T.deselect)
              ),
              React.createElement('div',{style:{fontSize:12,color:'var(--text3)',fontFamily:'IBM Plex Mono'}},`${selBox.w}×${selBox.h}×${selBox.d} mm`),
              React.createElement('div',{style:{fontSize:11,color:'var(--accent2)',lineHeight:1.5}},lang==='zh'?'💡 使用3D右上角圓形操作盤移動/旋轉':'💡 3D右上角の操作パネルで移動・回転'),
              React.createElement('button',{className:'btn btn-danger btn-xs',style:{width:'100%',fontSize:10},onClick:()=>{removeP(selId);setSelId(null);}},T.removeBtn)
            ),
            React.createElement('div',{style:{maxHeight:160,overflowY:'auto',display:'flex',flexDirection:'column',gap:4}},
              placed.map((pb,i)=>React.createElement('div',{
                key:pb.id,className:`placed-chip${pb.id===selId?' sel':''}`,
                onMouseEnter:()=>setHlId(pb.id),onMouseLeave:()=>setHlId(null),
                onClick:()=>setSelId(id=>id===pb.id?null:pb.id)
              },
                React.createElement('div',{style:{width:9,height:9,borderRadius:2,background:pb.color,flexShrink:0}}),
                React.createElement('span',{style:{color:pb.id===selId?'var(--accent)':'var(--text2)',fontSize:12,flex:1,fontWeight:pb.id===selId?700:400,overflow:'hidden',textOverflow:'ellipsis',whiteSpace:'nowrap'}},`#${i+1} ${pb.name}`),
                React.createElement('span',{className:'mono',style:{fontSize:8,color:'var(--text3)',flexShrink:0}},`${pb.x},${pb.y},${pb.z}`),
                React.createElement('span',{style:{fontSize:12,color:'var(--err)',opacity:.6,cursor:'pointer',paddingLeft:3,flexShrink:0},onClick:e=>{e.stopPropagation();removeP(pb.id);}},'✕')
              ))
            )
          )
        )
      )
    ),
    showHelp&&React.createElement(HelpModal,{onClose:()=>setShowHelp(false),lang})
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
</script>
</body>
