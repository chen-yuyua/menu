    {dir:0,icon:'↑',cls:'mv-pz',angle:270},
    {dir:1,icon:'↓',cls:'mv-nz',angle:90},
    {dir:2,icon:'→',cls:'mv-px',angle:0},
    {dir:3,icon:'←',cls:'mv-nx',angle:180},
    {dir:4,icon:'↑',cls:'mv-py',angle:315},
    {dir:5,icon:'↓',cls:'mv-ny',angle:135},
