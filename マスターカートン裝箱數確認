                        <input type="range" min="0" max={packingResult.packed.length} value={renderStep} onChange={e => setRenderStep(Number(e.target.value))} className="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-blue-600" />
                      </div>
                    </div>
                  )}
                </div>

                {/* 結果說明區塊 */}
                <div className="bg-blue-50/50 p-4 rounded-xl border border-blue-100/60 text-sm text-slate-600 shadow-sm">
