// Returns best fold recommendation for a target face (faceL × faceW mm)
// given sheet (sheetL × sheetW), thickness sheetH, gap to fill, mode
function calcFold({
  faceL,
  faceW,
  sheetL,
  sheetW,
  sheetH,
  gap,
  mode,
  coverThreshold
}) {
  // mode: 'both' = gap/2 per side; 'single' = full gap one side
  const neededThick = mode === 'both' ? gap / 2 : gap;
  const targetArea = faceL * faceW;

  // Fold count for thickness
  let folds = 0;
  let achievedThick = sheetH;
  if (neededThick <= sheetH) {
    folds = 0;
    achievedThick = sheetH;
  } else if (neededThick <= sheetH * 2) {
