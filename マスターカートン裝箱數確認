// Simplified cushion design formula (industry standard approximation)
// T_min(mm) = drop_h(cm) × 10 / ( G_limit / 20 )
// derivation: energy absorption model, G_limit normalized to 20G base
function istaMinThickness(dropCm, gLimit) {
  if (!gLimit || gLimit <= 0) return 999;
  return dropCm * 10 / (gLimit / 20);
}

