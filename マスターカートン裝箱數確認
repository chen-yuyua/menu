                          <div className="bg-white rounded-lg p-2 border border-sky-100/50 shadow-inner">
                            <div className="flex justify-between text-xs mb-1"><span className="text-slate-500">L向 ({packingResult.gaps.L}mm)</span><span className="font-bold text-sky-600">{packingResult.stats.planB.sheetsL} {t.sheets}</span></div>
                            <div className="flex justify-between text-xs mb-1"><span className="text-slate-500">W向 ({packingResult.gaps.W}mm)</span><span className="font-bold text-sky-600">{packingResult.stats.planB.sheetsW} {t.sheets}</span></div>
                            <div className="flex justify-between text-xs mb-2"><span className="text-slate-500">H向 ({packingResult.gaps.H}mm)</span><span className="font-bold text-sky-600">{packingResult.stats.planB.sheetsH} {t.sheets}</span></div>
                            <div className="border-t border-sky-50 pt-2 flex justify-between items-end">
                              <span className="text-[9px] text-slate-400 leading-tight">{t.totalSuggest}<br/>{t.crumpleRate}</span>
                              <span className="text-2xl font-black text-sky-700">{packingResult.stats.planB.total} <span className="text-xs">{t.sheets}</span></span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                <div className="bg-white p-2 rounded-xl shadow-sm border border-slate-200 relative flex-grow min-h-[450px]">
                  <div ref={canvasRef} className="w-full h-full rounded-lg bg-slate-100 overflow-hidden cursor-move"></div>
                  {packingResult.packed.length > 0 && (
                    <div className="absolute bottom-4 left-4 right-4 bg-white/90 p-3 rounded-lg shadow-md flex flex-col sm:flex-row items-center gap-4 z-20 border border-slate-200 backdrop-blur">
                      <div className="flex items-center space-x-4">
                        <span className="text-blue-700 font-bold text-sm bg-blue-50 px-2 py-1 rounded">{renderStep} / {packingResult.packed.length}</span>
                        <label className="flex items-center space-x-2 cursor-pointer text-sm"><input type="checkbox" checked={isTransparent} onChange={e => setIsTransparent(e.target.checked)} /><span>{t.xrayLabel}</span></label>
                      </div>
                      <input type="range" min="0" max={packingResult.packed.length} value={renderStep} onChange={e => setRenderStep(Number(e.target.value))} className="w-full h-2 bg-slate-200 rounded-lg accent-blue-600 cursor-pointer" />
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>

          {/* 懸浮操作說明 Modal 彈窗 */}
          {isHelpModalOpen && (
            <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4 animate-[fadeIn_0.2s_ease-out]">
              <div className="bg-white rounded-2xl shadow-2xl w-full max-w-3xl max-h-[90vh] overflow-y-auto flex flex-col border border-slate-200">
                <div className="flex justify-between items-center p-5 border-b border-slate-100 sticky top-0 bg-white/95 backdrop-blur z-10">
                  <h2 className="text-xl font-black text-slate-800 flex items-center"><InfoIcon className="w-6 h-6 mr-2 text-blue-600" />{t.helpModalTitle}</h2>
                  <button onClick={() => setIsHelpModalOpen(false)} className="text-slate-400 hover:text-red-500 p-1.5 rounded-lg hover:bg-red-50 transition-colors">
                    <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  </button>
                </div>
                <div className="p-6 md:p-8 space-y-8 text-sm text-slate-700">
                  {/* 第1節 */}
                  <div className="flex flex-col md:flex-row gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <div className="flex-shrink-0 bg-blue-100 text-blue-700 w-8 h-8 rounded-full flex items-center justify-center font-bold text-lg">1</div>
                    <div>
                      <h3 className="font-bold text-slate-900 text-base mb-2">{t.helpSec1Title}</h3>
                      <p className="leading-relaxed text-slate-600">{t.helpSec1Desc}</p>
                    </div>
                  </div>
                  {/* 第2節 */}
                  <div className="flex flex-col md:flex-row gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <div className="flex-shrink-0 bg-blue-100 text-blue-700 w-8 h-8 rounded-full flex items-center justify-center font-bold text-lg">2</div>
                    <div>
                      <h3 className="font-bold text-slate-900 text-base mb-2">{t.helpSec2Title}</h3>
                      <p className="leading-relaxed text-slate-600">{t.helpSec2Desc}</p>
                    </div>
                  </div>
                  {/* 第3節 */}
                  <div className="flex flex-col md:flex-row gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <div className="flex-shrink-0 bg-blue-100 text-blue-700 w-8 h-8 rounded-full flex items-center justify-center font-bold text-lg">3</div>
                    <div>
                      <h3 className="font-bold text-slate-900 text-base mb-2">{t.helpSec3Title}</h3>
                      <p className="leading-relaxed text-slate-600">{t.helpSec3Desc}</p>
                    </div>
                  </div>
                  {/* 第4節 */}
                  <div className="flex flex-col md:flex-row gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <div className="flex-shrink-0 bg-blue-100 text-blue-700 w-8 h-8 rounded-full flex items-center justify-center font-bold text-lg">4</div>
                    <div>
                      <h3 className="font-bold text-slate-900 text-base mb-2">{t.helpSec4Title}</h3>
                      <p className="leading-relaxed text-slate-600">{t.helpSec4Desc}</p>
                    </div>
                  </div>
                  
                  {/* ISTA 擴充概念區塊 (Highligt) */}
                  <div className="bg-amber-50 p-5 rounded-xl border border-amber-200 relative overflow-hidden">
                    <div className="absolute top-0 right-0 bg-amber-200 text-amber-800 text-[10px] font-bold px-3 py-1 rounded-bl-lg">進階知識庫</div>
                    <h3 className="font-black text-amber-900 text-base mb-2">{t.helpSec5Title}</h3>
                    <p className="leading-relaxed text-amber-800/90">{t.helpSec5Desc}</p>
                  </div>
                </div>
                <div className="p-5 border-t border-slate-100 bg-white flex justify-end sticky bottom-0 z-10">
                  <button onClick={() => setIsHelpModalOpen(false)} className="px-6 py-2.5 bg-slate-800 hover:bg-slate-900 text-white rounded-lg font-bold transition-all shadow-md hover:shadow-lg">{t.closeBtn}</button>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }
    const root = ReactDOM.createRoot(document.getElementById('root')); root.render(<App />);
  </script>
</body>
</html>
