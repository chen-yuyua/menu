    // ===================================================
    //  MAIN APP
    // ===================================================
    function App() {
      const [lang, setLang] = useState('zh');
      const t = translations[lang];
      const [threeLoaded] = useState(true);
      const [isScreenshotting, setIsScreenshotting] = useState(false);
      const [isHelpModalOpen, setIsHelpModalOpen] = useState(false);

      const [outerCarton, setOuterCarton] = useState({ L: 421, W: 396, H: 353, tolPlus: 5, tolMinus: 5, calcState: 'nominal' });
      const [innerBox, setInnerBox] = useState({ L: 382, W: 378, H: 114, qty: 0, color: '#3b82f6', tolPlus: 3, tolMinus: 3, calcState: 'nominal', qtyL: 0, qtyW: 0, qtyH: 0, bubbleGap: 4, sheetL: 1200, sheetW: 600, sheetH: 4 });
      const [strategy, setStrategy] = useState('auto');
      const [showFilling, setShowFilling] = useState(true);
      const [packingResult, setPackingResult] = useState({ packed: [], gaps: null, stats: null, config: null });
      const [isPending, startTransition] = useTransition();
      const [renderStep, setRenderStep] = useState(0);
      const [isTransparent, setIsTransparent] = useState(false);

      const meshesRef = useRef([]);
      const fillerGroupRef = useRef(null);
      const dimGroupRef = useRef(null);
      const canvasRef = useRef(null);
      const sceneRef = useRef(null);
      const cameraRef = useRef(null);
      const controlsRef = useRef(null);
      const rendererRef = useRef(null);
      const boxGroupRef = useRef(null);
      const animFrameRef = useRef(null);

      const handleScreenshot = async () => {
        setIsScreenshotting(true);
        try {
          const canvas = await window.html2canvas(document.body, { useCORS: true, allowTaint: true, backgroundColor: "#f8fafc" });
          const url = canvas.toDataURL("image/png");
          const a = document.createElement("a"); a.href = url;
          const timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);
          a.download = `GapCalculator_${timestamp}.png`; a.click();
        } catch (err) { console.error("截圖失敗", err); } finally { setIsScreenshotting(false); }
      };

      const exportToDXF = () => {
        if (!packingResult.packed || packingResult.packed.length === 0) return;
        const scale = 1 / 10; const gap = 1000 * scale; const eps = 1e-4;
        const effOuter = packingResult.config ? packingResult.config.effOuter : outerCarton;
        let dxf = `0\nSECTION\n2\nENTITIES\n`;
        const addLine = (x1, y1, x2, y2, layer = "0", color = 256) => { dxf += `0\nLINE\n8\n${layer}\n62\n${color}\n10\n${x1.toFixed(4)}\n20\n${y1.toFixed(4)}\n30\n0.0\n11\n${x2.toFixed(4)}\n21\n${y2.toFixed(4)}\n31\n0.0\n`; };
        const addRect = (x, y, w, h, layer = "0", color = 256) => { addLine(x, y, x+w, y, layer, color); addLine(x+w, y, x+w, y+h, layer, color); addLine(x+w, y+h, x, y+h, layer, color); addLine(x, y+h, x, y, layer, color); };
        const ACI_PALETTE = [5, 3, 4, 2, 6, 30, 40, 50, 140, 170];
        const getACIColor = (i) => ACI_PALETTE[i % ACI_PALETTE.length];
        const cW = effOuter.W*scale, cH = effOuter.H*scale, cD = effOuter.L*scale;
        addRect(0, 0, cW, cH, "CONTAINER", 7);
        addRect(0, cH+gap, cW, cD, "CONTAINER", 7);
        addRect(cW+gap, 0, cD, cH, "CONTAINER", 7);
        const clipSegment = (segs, minV, maxV) => { let r=[]; for (let s of segs) { if (maxV<=s.s+eps||minV>=s.e-eps) r.push(s); else { if (minV>s.s+eps) r.push({s:s.s,e:minV}); if (maxV<s.e-eps) r.push({s:maxV,e:s.e}); } } return r; };
        const processView = (faces, dx, dy) => {
          for (let i=0;i<faces.length;i++) {
            const F=faces[i]; let tS=[{s:F.x,e:F.x+F.w}],bS=[{s:F.x,e:F.x+F.w}],lS=[{s:F.y,e:F.y+F.h}],rS=[{s:F.y,e:F.y+F.h}];
            for (let j=0;j<faces.length;j++) { if (i===j) continue; const O=faces[j]; if (O.depth>F.depth+eps) { if (O.y-eps<=F.y+F.h&&F.y+F.h<=O.y+O.h+eps) tS=clipSegment(tS,O.x,O.x+O.w); if (O.y-eps<=F.y&&F.y<=O.y+O.h+eps) bS=clipSegment(bS,O.x,O.x+O.w); if (O.x-eps<=F.x&&F.x<=O.x+O.w+eps) lS=clipSegment(lS,O.y,O.y+O.h); if (O.x-eps<=F.x+F.w&&F.x+F.w<=O.x+O.w+eps) rS=clipSegment(rS,O.y,O.y+O.h); } }
            tS.forEach(s=>{if(s.e-s.s>eps) addLine(s.s+dx,F.y+F.h+dy,s.e+dx,F.y+F.h+dy,F.layer,F.color);}); bS.forEach(s=>{if(s.e-s.s>eps) addLine(s.s+dx,F.y+dy,s.e+dx,F.y+dy,F.layer,F.color);}); lS.forEach(s=>{if(s.e-s.s>eps) addLine(F.x+dx,s.s+dy,F.x+dx,s.e+dy,F.layer,F.color);}); rS.forEach(s=>{if(s.e-s.s>eps) addLine(F.x+F.w+dx,s.s+dy,F.x+F.w+dx,s.e+dy,F.layer,F.color);});
          }
        };
        processView(packingResult.packed.map((p,i)=>({x:p.x*scale,y:p.y*scale,w:p.w*scale,h:p.h*scale,depth:(p.z+p.d)*scale,color:getACIColor(i),layer:"BOXES_FRONT"})), 0, 0);
        processView(packingResult.packed.map((p,i)=>({x:p.x*scale,y:cD-(p.z+p.d)*scale,w:p.w*scale,h:p.d*scale,depth:(p.y+p.h)*scale,color:getACIColor(i),layer:"BOXES_TOP"})), 0, cH+gap);
        processView(packingResult.packed.map((p,i)=>({x:cD-(p.z+p.d)*scale,y:p.y*scale,w:p.d*scale,h:p.h*scale,depth:(p.x+p.w)*scale,color:getACIColor(i),layer:"BOXES_SIDE"})), cW+gap, 0);
        dxf += `0\nENDSEC\n0\nEOF\n`;
        const blob = new Blob([dxf], {type:'application/dxf'}); const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href=url; a.download='GapCalc_3View.dxf';
        document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
      };

      const runPacking = () => {
        startTransition(() => {
          const getEffDim = (val, plus, minus, state) => {
            if (state==='max') return Math.max(0.1, val+plus);
            if (state==='min') return Math.max(0.1, val-minus);
            return val;
          };
          const effOuter = { L: getEffDim(outerCarton.L,outerCarton.tolPlus,outerCarton.tolMinus,outerCarton.calcState), W: getEffDim(outerCarton.W,outerCarton.tolPlus,outerCarton.tolMinus,outerCarton.calcState), H: getEffDim(outerCarton.H,outerCarton.tolPlus,outerCarton.tolMinus,outerCarton.calcState) };
          const effInner = { L: getEffDim(innerBox.L,innerBox.tolPlus,innerBox.tolMinus,innerBox.calcState), W: getEffDim(innerBox.W,innerBox.tolPlus,innerBox.tolMinus,innerBox.calcState), H: getEffDim(innerBox.H,innerBox.tolPlus,innerBox.tolMinus,innerBox.calcState) };
          const bg = innerBox.bubbleGap;
          const allPerms = [
            {id:'L',dz:effInner.L,dx:effInner.W,dy:effInner.H},{id:'L',dz:effInner.L,dx:effInner.H,dy:effInner.W},
            {id:'W',dz:effInner.W,dx:effInner.L,dy:effInner.H},{id:'W',dz:effInner.W,dx:effInner.H,dy:effInner.L},
            {id:'H',dz:effInner.H,dx:effInner.L,dy:effInner.W},{id:'H',dz:effInner.H,dx:effInner.W,dy:effInner.L},
          ];
          let validPerms = allPerms;
          if (strategy==='alignL') validPerms=allPerms.filter(p=>p.id==='L');
          if (strategy==='alignW') validPerms=allPerms.filter(p=>p.id==='W');
          if (strategy==='alignH') validPerms=allPerms.filter(p=>p.id==='H');

          let bestResult = {count:-1,packed:[],maxX:0,maxY:0,maxZ:0,layersY:0};
          validPerms.forEach(perm => {
            const maxZ_count = innerBox.qtyL>0?innerBox.qtyL:Math.floor((effOuter.L+bg)/(perm.dz+bg));
            const maxX_count = innerBox.qtyW>0?innerBox.qtyW:Math.floor((effOuter.W+bg)/(perm.dx+bg));
            const maxY_count = innerBox.qtyH>0?innerBox.qtyH:Math.floor((effOuter.H+bg)/(perm.dy+bg));
            const maxCapacity = maxZ_count*maxX_count*maxY_count;
            const actualQty = innerBox.qty===0?maxCapacity:Math.min(innerBox.qty,maxCapacity);
            let packed=[],count=0,maxX=0,maxY=0,maxZ=0;
            for (let y=0;y<maxY_count&&count<actualQty;y++) for (let x=0;x<maxX_count&&count<actualQty;x++) for (let z=0;z<maxZ_count&&count<actualQty;z++) {
              const px=x*(perm.dx+bg),py=y*(perm.dy+bg),pz=z*(perm.dz+bg);
              const isInter=(px+perm.dx>effOuter.W+0.1)||(py+perm.dy>effOuter.H+0.1)||(pz+perm.dz>effOuter.L+0.1);
              packed.push({x:px,y:py,z:pz,w:perm.dx,h:perm.dy,d:perm.dz,color:isInter?'#ef4444':innerBox.color});
              if (px+perm.dx>maxX) maxX=px+perm.dx; if (py+perm.dy>maxY) maxY=py+perm.dy; if (pz+perm.dz>maxZ) maxZ=pz+perm.dz; count++;
            }
            if (count>bestResult.count) bestResult={count,packed,maxX,maxY,maxZ,layersY:maxY_count};
          });
          if (bestResult.count===0) { let p=validPerms[0]; bestResult={count:0,packed:[{x:0,y:0,z:0,w:p.dx,h:p.dy,d:p.dz,color:'#ef4444'}],maxX:p.dx,maxY:p.dy,maxZ:p.dz,layersY:1}; }

          const gaps = { L:Number((effOuter.L-bestResult.maxZ).toFixed(2)), W:Number((effOuter.W-bestResult.maxX).toFixed(2)), H:Number((effOuter.H-bestResult.maxY).toFixed(2)) };
          const sL=innerBox.sheetL, sW=innerBox.sheetW;
          const tolFactor=1.05, eff_sW=sW*tolFactor, sheetArea=sL*sW;
          const reqL_A=effOuter.L+2*effOuter.H, reqW_A=effOuter.W+2*effOuter.H;
          const nL_A=Math.min(Math.ceil(reqL_A/sL)*Math.ceil(effOuter.W/eff_sW),Math.ceil(reqL_A/sW)*Math.ceil(effOuter.W/(sL*tolFactor)));
          const nW_A=Math.min(Math.ceil(reqW_A/sL)*Math.ceil(effOuter.L/eff_sW),Math.ceil(reqW_A/sW)*Math.ceil(effOuter.L/(sL*tolFactor)));
          const nTop_A=Math.ceil((effOuter.L*effOuter.W)/(sheetArea*0.9));
          const planA={nL:nL_A,nW:nW_A,nTop:nTop_A,total:nL_A+nW_A+nTop_A};

          const vL=effOuter.W*effOuter.H*Math.max(0,gaps.L);
          const vW=Math.max(0,gaps.W)*effOuter.H*(effOuter.L-Math.max(0,gaps.L));
          const vH=(effOuter.W-Math.max(0,gaps.W))*Math.max(0,gaps.H)*(effOuter.L-Math.max(0,gaps.L));
          const sheetVol=sL*sW*innerBox.sheetH; const crumpleFactor=1.2;
          const getSheets=(v)=>sheetVol>0?Math.ceil((v/sheetVol)/crumpleFactor):0;
          const planB={sheetsL:getSheets(vL),sheetsW:getSheets(vW),sheetsH:getSheets(vH),total:getSheets(vL)+getSheets(vW)+getSheets(vH)};

          const sheetsPerULayer=Math.min(Math.ceil(reqL_A/sL)*Math.ceil(effOuter.W/eff_sW),Math.ceil(reqL_A/sW)*Math.ceil(effOuter.W/(sL*tolFactor)));
          const nBottom_C=sheetsPerULayer*Math.max(1,bestResult.layersY);
          const nTop_C=Math.ceil((effOuter.L*effOuter.W)/(sheetArea*0.9));
          const planC={nBottom:nBottom_C,nTop:nTop_C,total:nBottom_C+nTop_C};

          const innerVol=bestResult.count*effInner.L*effInner.W*effInner.H;
          const outerVol=effOuter.L*effOuter.W*effOuter.H;
          const utilizationRate=outerVol>0?Math.round((innerVol/outerVol)*100):0;

          const gapRatioL=effOuter.L>0?gaps.L/effOuter.L:0;
          const gapRatioW=effOuter.W>0?gaps.W/effOuter.W:0;
          const gapRatioH=effOuter.H>0?gaps.H/effOuter.H:0;
          const maxAbsGap=Math.max(gaps.L,gaps.W,gaps.H);
          const maxGapRatio=Math.max(gapRatioL,gapRatioW,gapRatioH);
          const isMultiLayer=bestResult.layersY>1;
          let recommendedPlan='A';
          if (maxAbsGap>25&&maxGapRatio>0.08) recommendedPlan='B';
          else if (isMultiLayer&&maxAbsGap<=25) recommendedPlan='C';
          else if (isMultiLayer&&maxAbsGap>25) recommendedPlan='B';

          setPackingResult({ packed:bestResult.packed, gaps, stats:{totalPacked:bestResult.count,targetQty:innerBox.qty,planA,planB,planC,recommendedPlan,maxAbsGap,utilizationRate}, config:{effOuter,effInner} });
          setRenderStep(bestResult.packed.length);
        });
      };

      // Three.js scene init (persistent)
      useEffect(() => {
        if (!threeLoaded||!canvasRef.current||!window.THREE) return;
        if (rendererRef.current) return;
        const { THREE } = window;
        const width=canvasRef.current.clientWidth, height=canvasRef.current.clientHeight;
        const scene=new THREE.Scene(); scene.background=new THREE.Color(0xf1f5f9); sceneRef.current=scene;
        const camera=new THREE.PerspectiveCamera(45,width/height,1,10000); cameraRef.current=camera;
        const renderer=new THREE.WebGLRenderer({antialias:true,preserveDrawingBuffer:true});
        renderer.setSize(width,height); canvasRef.current.appendChild(renderer.domElement); rendererRef.current=renderer;
        const controls=new window.THREE.OrbitControls(camera,renderer.domElement); controls.enableDamping=true; controlsRef.current=controls;
        scene.add(new THREE.AmbientLight(0xffffff,0.7));
        const dirLight=new THREE.DirectionalLight(0xffffff,0.5); dirLight.position.set(1000,2000,1000); scene.add(dirLight);
        boxGroupRef.current=new THREE.Group(); scene.add(boxGroupRef.current);
        fillerGroupRef.current=new THREE.Group(); scene.add(fillerGroupRef.current);
        dimGroupRef.current=new THREE.Group(); scene.add(dimGroupRef.current);
        const anim=()=>{ animFrameRef.current=requestAnimationFrame(anim); controls.update(); renderer.render(scene,camera); }; anim();
        return ()=>{ if (animFrameRef.current) cancelAnimationFrame(animFrameRef.current); renderer.dispose(); rendererRef.current=null; };
      }, [threeLoaded]);

      // Update meshes on new result
      useEffect(() => {
        if (!sceneRef.current||!window.THREE||!packingResult.packed) return;
        const { THREE } = window;
        const scene=sceneRef.current;
        const effOuter=packingResult.config?packingResult.config.effOuter:outerCarton;
        meshesRef.current=[];
        [boxGroupRef,fillerGroupRef,dimGroupRef].forEach(ref=>{ while(ref.current.children.length){const m=ref.current.children[0];m.geometry?.dispose();m.material?.dispose();ref.current.remove(m);} });
        scene.children.filter(c=>c.isLineSegments&&c.userData.isContainer).forEach(c=>scene.remove(c));
        const containerEdges=new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.BoxGeometry(effOuter.W,effOuter.H,effOuter.L)),new THREE.LineBasicMaterial({color:0x334155,linewidth:2,transparent:true,opacity:0.8}));
        containerEdges.userData.isContainer=true; scene.add(containerEdges);
        packingResult.packed.forEach(p=>{
          const mesh=new THREE.Mesh(new THREE.BoxGeometry(p.w,p.h,p.d),new THREE.MeshLambertMaterial({color:p.color}));
          mesh.position.set(p.x+p.w/2-effOuter.W/2,p.y+p.h/2-effOuter.H/2,p.z+p.d/2-effOuter.L/2);
          mesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(mesh.geometry),new THREE.LineBasicMaterial({color:0x000000,transparent:true,opacity:0.2})));
          meshesRef.current.push(mesh); boxGroupRef.current.add(mesh);
        });
        if (packingResult.gaps&&packingResult.packed.length>0&&showFilling) {
          const {L:gL,W:gW,H:gH}=packingResult.gaps;
          const fMat=new THREE.MeshLambertMaterial({color:0xbae6fd,transparent:true,opacity:0.4});
          const wMat=new THREE.LineBasicMaterial({color:0x0ea5e9,transparent:true,opacity:0.4});
          const createF=(w,h,d,px,py,pz)=>{
            if(w<=0.1||h<=0.1||d<=0.1) return;
            const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),fMat);
            m.position.set(px+w/2-effOuter.W/2,py+h/2-effOuter.H/2,pz+d/2-effOuter.L/2);
            m.add(new THREE.LineSegments(new THREE.EdgesGeometry(m.geometry),wMat));
            fillerGroupRef.current.add(m);
          };
          if (gL>0) createF(effOuter.W,effOuter.H,gL,0,0,effOuter.L-gL);
          if (gW>0) createF(gW,effOuter.H,effOuter.L-Math.max(0,gL),effOuter.W-gW,0,0);
          if (gH>0) createF(effOuter.W-Math.max(0,gW),gH,effOuter.L-Math.max(0,gL),0,effOuter.H-gH,0);
        }
        if (packingResult.gaps&&packingResult.packed.length>0) {
          const {L:gL,W:gW,H:gH}=packingResult.gaps;
          const mX=effOuter.W/2,mY=effOuter.H/2,mZ=effOuter.L/2;
          const pX=mX-gW,pY=mY-gH,pZ=mZ-gL;
          const addDim=(p1,p2,text,color,ox=0,oy=0,oz=0)=>{
            const dir=new THREE.Vector3().subVectors(p2,p1); const len=dir.length(); if(len>0) dir.normalize();
            if (len>5) dimGroupRef.current.add(new THREE.ArrowHelper(dir,p1,len,color,15,8));
            const mid=new THREE.Vector3().addVectors(p1,p2).multiplyScalar(0.5).add(new THREE.Vector3(ox,oy,oz));
            const c2=document.createElement('canvas'); c2.width=512; c2.height=128;
            const ctx=c2.getContext('2d'); ctx.fillStyle=color; ctx.font='bold 50px sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle'; ctx.strokeStyle='white'; ctx.lineWidth=8; ctx.strokeText(text,256,64); ctx.fillText(text,256,64);
            const sprite=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c2),transparent:true,depthTest:false}));
            sprite.scale.set(200,50,1); sprite.position.copy(mid); dimGroupRef.current.add(sprite);
          };
          addDim(new THREE.Vector3(pX,-mY+10,pZ),new THREE.Vector3(pX,-mY+10,mZ),`${t.gapL}: ${gL}mm`,gL<0?'#ef4444':'#ea580c',50,30,0);
          addDim(new THREE.Vector3(pX,-mY+10,pZ),new THREE.Vector3(mX,-mY+10,pZ),`${t.gapW}: ${gW}mm`,gW<0?'#ef4444':'#2563eb',0,-30,50);
          addDim(new THREE.Vector3(pX,pY,pZ),new THREE.Vector3(pX,mY,pZ),`${t.gapH}: ${gH}mm`,gH<0?'#ef4444':'#16a34a',50,0,50);
        }
        const maxD=Math.max(effOuter.L,effOuter.W,effOuter.H);
        if (cameraRef.current&&controlsRef.current) { cameraRef.current.position.set(maxD*1.2,maxD*0.8,maxD*1.2); controlsRef.current.target.set(0,0,0); controlsRef.current.update(); }
      }, [packingResult,threeLoaded,outerCarton,lang,showFilling]);

      useEffect(() => {
        meshesRef.current.forEach((m,i)=>{ m.visible=i<renderStep; m.material.transparent=isTransparent; m.material.opacity=isTransparent?0.3:1.0; });
        if (fillerGroupRef.current) fillerGroupRef.current.visible=(renderStep===packingResult.packed.length);
      }, [renderStep,isTransparent,packingResult]);

      return (
        <div className="min-h-screen p-4 md:p-6 bg-slate-50 font-sans">
          <div className="max-w-6xl mx-auto space-y-6">
            <header className="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-200">
              <div className="flex items-center space-x-3 mb-4 sm:mb-0">
                <ShieldCheck className="w-8 h-8 text-blue-600"/>
                <h1 className="text-2xl font-bold text-slate-800 flex items-center">
                  {t.appTitle}
                  <span className="ml-3 text-xs font-medium px-2 py-0.5 bg-slate-200 text-slate-600 rounded-md border border-slate-300">Ver. {APP_VERSION} - {APP_UPDATED_DATE} 作成：分室</span>
                </h1>
              </div>
              <div className="flex flex-wrap items-center gap-2">
                <button onClick={()=>setIsHelpModalOpen(true)} className="flex items-center bg-sky-500 hover:bg-sky-600 text-white px-3 py-1.5 rounded-lg text-sm transition-colors shadow-sm hover:shadow-md">
                  <HelpCircle className="w-4 h-4 mr-1.5"/> {t.helpBtn}
                </button>
                <button onClick={exportToDXF} disabled={!packingResult.packed||packingResult.packed.length===0} className="flex items-center bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded-lg text-sm transition-colors shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                  <DownloadIcon className="w-4 h-4 mr-1.5"/> {t.exportDXF}
                </button>
                <button onClick={handleScreenshot} disabled={isScreenshotting} className="flex items-center bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 rounded-lg text-sm transition-colors shadow-sm disabled:opacity-50">
                  {isScreenshotting?<RefreshCw className="w-4 h-4 mr-1.5 animate-spin"/>:<CameraIcon className="w-4 h-4 mr-1.5"/>}
                  {isScreenshotting?t.screenshoting:t.screenshot}
                </button>
                <button onClick={()=>setLang(l=>l==='zh'?'ja':'zh')} className="flex items-center bg-slate-800 hover:bg-slate-700 text-white px-3 py-1.5 rounded-lg text-sm transition-colors shadow-sm">
                  <Globe className="w-4 h-4 mr-1.5"/> {t.langToggle}
                </button>
              </div>
            </header>

            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
              {/* LEFT PANEL */}
              <div className="lg:col-span-4 space-y-5">
                {/* STEP 1 外箱 */}
                <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                  <h2 className="text-md font-semibold text-slate-800 mb-4 flex items-center"><span className="bg-blue-100 text-blue-700 w-6 h-6 rounded-full flex items-center justify-center text-sm mr-2">1</span>{t.step1Title}</h2>
                  <div className="grid grid-cols-3 gap-3">
                    {['L','W','H'].map(dim=>(
                      <div key={'o'+dim}><label className="block text-xs text-slate-500 mb-1">{t['outer'+dim]}</label>
                        <input type="number" value={outerCarton[dim]} onChange={e=>setOuterCarton({...outerCarton,[dim]:Number(e.target.value)})} className="w-full p-2 border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500"/>
                      </div>
                    ))}
                  </div>
                  <div className="grid grid-cols-2 gap-3 mt-4 pt-4 border-t border-slate-100">
                    <div><label className="block text-xs text-slate-500 mb-1">{t.tolPlus} (mm)</label><input type="number" min="0" value={outerCarton.tolPlus} onChange={e=>setOuterCarton({...outerCarton,tolPlus:Number(e.target.value)})} className="w-full p-2 border border-green-300 bg-green-50 rounded-lg text-green-700 outline-none focus:ring-2 focus:ring-green-500"/></div>
                    <div><label className="block text-xs text-slate-500 mb-1">{t.tolMinus} (mm)</label><input type="number" min="0" value={outerCarton.tolMinus} onChange={e=>setOuterCarton({...outerCarton,tolMinus:Number(e.target.value)})} className="w-full p-2 border border-red-300 bg-red-50 rounded-lg text-red-700 outline-none focus:ring-2 focus:ring-red-500"/></div>
                  </div>
                  <div className="mt-4">
                    <label className="block text-xs text-slate-500 mb-1 font-bold">{t.calcState}</label>
                    <select value={outerCarton.calcState} onChange={e=>setOuterCarton({...outerCarton,calcState:e.target.value})} className="w-full p-2 border border-slate-300 rounded-lg text-sm bg-slate-50 outline-none focus:ring-2 focus:ring-blue-500">
                      <option value="nominal">{t.stateNominal}</option>
                      <option value="max">{t.stateMax}</option>
                      <option value="min">{t.stateMin}</option>
                    </select>
                  </div>
                </div>

                {/* STEP 2 製品 */}
                <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                  <h2 className="text-md font-semibold text-slate-800 mb-4 flex items-center"><span className="bg-blue-100 text-blue-700 w-6 h-6 rounded-full flex items-center justify-center text-sm mr-2">2</span>{t.step2Title}</h2>
                  <div className="grid grid-cols-3 gap-3 mb-4">
                    {['L','W','H'].map(dim=>(
                      <div key={'i'+dim}><label className="block text-xs text-slate-500 mb-1">{t['inner'+dim]}</label>
                        <input type="number" value={innerBox[dim]} onChange={e=>setInnerBox({...innerBox,[dim]:Number(e.target.value)})} className="w-full p-2 border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500"/>
                      </div>
                    ))}
                  </div>
                  <div className="grid grid-cols-2 gap-3 mb-4 border-t border-slate-100 pt-4">
                    <div><label className="block text-xs text-slate-500 mb-1">{t.tolPlus} (mm)</label><input type="number" min="0" value={innerBox.tolPlus} onChange={e=>setInnerBox({...innerBox,tolPlus:Number(e.target.value)})} className="w-full p-2 border border-green-300 bg-green-50 rounded-lg text-green-700 outline-none focus:ring-2 focus:ring-green-500"/></div>
                    <div><label className="block text-xs text-slate-500 mb-1">{t.tolMinus} (mm)</label><input type="number" min="0" value={innerBox.tolMinus} onChange={e=>setInnerBox({...innerBox,tolMinus:Number(e.target.value)})} className="w-full p-2 border border-red-300 bg-red-50 rounded-lg text-red-700 outline-none focus:ring-2 focus:ring-red-500"/></div>
                  </div>
                  <div className="mb-4 pb-4 border-b border-slate-100">
                    <label className="block text-xs text-slate-500 mb-1 font-bold">{t.calcState}</label>
                    <select value={innerBox.calcState} onChange={e=>setInnerBox({...innerBox,calcState:e.target.value})} className="w-full p-2 border border-slate-300 rounded-lg text-sm bg-slate-50 outline-none focus:ring-2 focus:ring-blue-500">
                      <option value="nominal">{t.stateNominal}</option>
                      <option value="max">{t.stateMax}</option>
                      <option value="min">{t.stateMin}</option>
                    </select>
                  </div>
                  <div className="space-y-4">
                    <div>
                      <label className="block text-xs text-blue-800 mb-1 font-bold">{t.bubbleGap} (mm)</label>
                      <input type="number" value={innerBox.bubbleGap} onChange={e=>setInnerBox({...innerBox,bubbleGap:Number(e.target.value)})} className="w-full p-2 border border-blue-200 bg-blue-50/30 rounded focus:ring-2 focus:ring-blue-500"/>
                    </div>
                    <div className="bg-slate-50 p-3 rounded-lg border border-slate-200">
                      <label className="block text-xs text-slate-700 mb-2 font-bold flex items-center"><PackageIcon className="w-3.5 h-3.5 mr-1"/>{t.bubbleSheetSet}</label>
                      <div className="grid grid-cols-2 gap-2 mb-2">
                        <div><label className="block text-[10px] text-slate-500">{t.sheetDim}</label>
                          <div className="flex items-center space-x-1">
                            <input type="number" value={innerBox.sheetL} onChange={e=>setInnerBox({...innerBox,sheetL:Number(e.target.value)})} className="w-full p-1 border text-xs rounded"/>
                            <span className="text-slate-400">x</span>
                            <input type="number" value={innerBox.sheetW} onChange={e=>setInnerBox({...innerBox,sheetW:Number(e.target.value)})} className="w-full p-1 border text-xs rounded"/>
                          </div>
                        </div>
                        <div><label className="block text-[10px] text-slate-500">{t.sheetThick}</label>
                          <input type="number" value={innerBox.sheetH} onChange={e=>setInnerBox({...innerBox,sheetH:Number(e.target.value)})} className="w-full p-1 border text-xs rounded"/>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                {/* STEP 3 計算 */}
                <div className="bg-white p-5 rounded-xl shadow-sm border border-slate-200">
                  <h2 className="text-md font-semibold text-slate-800 mb-4 flex items-center"><span className="bg-blue-100 text-blue-700 w-6 h-6 rounded-full flex items-center justify-center text-sm mr-2">3</span>{t.step3Title}</h2>
                  <div className="mb-4">
                    <label className="flex items-center space-x-2 cursor-pointer mb-3 bg-blue-50 p-2 rounded border border-blue-200 hover:bg-blue-100 transition-colors">
                      <input type="checkbox" checked={showFilling} onChange={e=>setShowFilling(e.target.checked)} className="w-4 h-4 text-blue-600 rounded"/>
                      <span className="text-sm font-bold text-blue-800">{t.showFiller}</span>
                    </label>
                    <select value={strategy} onChange={e=>setStrategy(e.target.value)} className="w-full p-2.5 border border-slate-300 rounded-lg text-sm bg-slate-50 outline-none">
                      <option value="auto">{t.strategyAuto}</option>
                      <option value="alignL">{t.strategyAlignL}</option>
                      <option value="alignW">{t.strategyAlignW}</option>
                      <option value="alignH">{t.strategyAlignH}</option>
                    </select>
                  </div>
                  <button onClick={runPacking} disabled={isPending} className="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 rounded-lg flex items-center justify-center shadow-md">
                    {isPending?<RefreshCw className="w-5 h-5 animate-spin mr-2"/>:<Play className="w-5 h-5 mr-2"/>}
                    {isPending?t.calcIng:t.calcBtn}
                  </button>
                </div>
              </div>

              {/* RIGHT PANEL */}
              <div className="lg:col-span-8 flex flex-col space-y-4">
                {packingResult.gaps && (
                  <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-200 space-y-4">
                    <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 pb-4">
                      <div>
                        <h3 className="text-sm font-bold text-slate-500 mb-1">{t.resultTitle}</h3>
                        <p className="text-lg font-bold text-slate-800">{t.packedCount}: <span className={packingResult.stats.totalPacked<packingResult.stats.targetQty?'text-red-500':'text-green-600'}>{packingResult.stats.totalPacked}</span> / {t.targetLabel}: {packingResult.stats.targetQty===0?t.maxAuto:packingResult.stats.targetQty}</p>
                      </div>
                      <div className="flex space-x-6">
                        {['L','W','H'].map(d=>(
                          <div key={d} className="text-center">
                            <p className="text-xs text-slate-500 font-bold mb-1">{t['gap'+d]}</p>
                            <p className={`text-lg font-bold ${packingResult.gaps[d]<0?'text-red-600':'text-slate-800'}`}>{packingResult.gaps[d]}mm</p>
                          </div>
                        ))}
                        <div className="text-center border-l border-slate-200 pl-6">
                          <p className="text-xs text-slate-500 font-bold mb-1">{lang==='zh'?'空間利用率':'空間充填率'}</p>
                          <p className={`text-lg font-bold ${packingResult.stats.utilizationRate>=80?'text-green-600':packingResult.stats.utilizationRate>=60?'text-amber-500':'text-red-500'}`}>{packingResult.stats.utilizationRate}%</p>
                        </div>
                      </div>
                    </div>

                    {/* 包裝方案 — 順序固定為 A → B → C */}
                    <div className="space-y-4 pt-2">
                      <h3 className="text-base font-black text-slate-800">{t.packAdviceTitle}</h3>
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">

                        {/* ===== 方案 A (十字包覆) ===== */}
                        <div className={`col-span-1 border rounded-xl p-4 flex flex-col justify-between ${packingResult.stats.recommendedPlan==='A'?'bg-emerald-50 border-emerald-300 best-plan-glow shadow-md':'bg-slate-50 border-slate-200 opacity-80 hover:opacity-100 transition'}`}>
                          <div>
                            <div className="flex justify-between items-start mb-2">
                              <h4 className="font-bold text-emerald-900 text-sm leading-tight">{t.methodA}</h4>
                              {packingResult.stats.recommendedPlan==='A'&&<span className="bg-emerald-600 text-white text-[10px] px-2 py-0.5 rounded font-bold shrink-0 shadow flex items-center"><StarIcon className="w-3 h-3 mr-0.5"/> {t.recommendBadge}</span>}
                            </div>
                            <div className="w-full h-32 mb-4 bg-white/70 rounded-lg border border-emerald-100/60 flex items-center justify-center text-emerald-400 shadow-sm overflow-hidden">
                              <CrossWrapIcon className="h-full w-full max-w-[80%] text-emerald-500"/>
                            </div>
                            <p className="text-[12px] text-emerald-700/90 leading-relaxed mb-4 font-medium tracking-wide">{t.methodADesc}</p>
                          </div>
                          <div className="bg-white rounded-lg p-2 border border-emerald-100/50 shadow-inner">
                            <div className="flex justify-between text-xs mb-1"><span className="text-slate-500">{t.crossL}</span><span className="font-bold text-emerald-600">{packingResult.stats.planA.nL} {t.sheets}</span></div>
                            <div className="flex justify-between text-xs mb-1"><span className="text-slate-500">{t.crossW}</span><span className="font-bold text-emerald-600">{packingResult.stats.planA.nW} {t.sheets}</span></div>
                            <div className="flex justify-between text-xs mb-2"><span className="text-slate-500">{t.crossTop}</span><span className="font-bold text-emerald-600">{packingResult.stats.planA.nTop} {t.sheets}</span></div>
                            <div className="border-t border-emerald-50 pt-2 flex justify-between items-end">
                              <span className="text-[10px] text-slate-400 font-bold">{t.totalSuggest}</span>
                              <span className="text-2xl font-black text-emerald-700">{packingResult.stats.planA.total} <span className="text-xs">{t.sheets}</span></span>
                            </div>
                          </div>
                        </div>

                        {/* ===== 方案 B (局部填充) ===== */}
                        <div className={`col-span-1 border rounded-xl p-4 flex flex-col justify-between ${packingResult.stats.recommendedPlan==='B'?'bg-sky-50 border-sky-300 best-plan-glow shadow-md':'bg-slate-50 border-slate-200 opacity-80 hover:opacity-100 transition'}`}>
                          <div>
                            <div className="flex justify-between items-start mb-2">
                              <h4 className="font-bold text-sky-900 text-sm leading-tight">{t.methodB}</h4>
                              {packingResult.stats.recommendedPlan==='B'&&<span className="bg-sky-600 text-white text-[10px] px-2 py-0.5 rounded font-bold shrink-0 shadow flex items-center"><StarIcon className="w-3 h-3 mr-0.5"/> {t.recommendBadge}</span>}
                            </div>
                            <div className="w-full h-32 mb-4 bg-white/70 rounded-lg border border-sky-100/60 flex items-center justify-center text-sky-400 shadow-sm overflow-hidden">
                              <VoidFillIcon className="h-full w-full max-w-[80%] text-sky-500"/>
                            </div>
                            <p className="text-[12px] text-sky-700/90 leading-relaxed mb-4 font-medium tracking-wide">{t.methodBDesc}</p>
                          </div>
                          <div className="bg-white rounded-lg p-2 border border-sky-100/50 shadow-inner">
                            <div className="flex justify-between text-xs mb-1"><span className="text-slate-500">L向 ({packingResult.gaps.L}mm)</span><span className="font-bold text-sky-600">{packingResult.stats.planB.sheetsL} {t.sheets}</span></div>
                            <div className="flex justify-between text-xs mb-1"><span className="text-slate-500">W向 ({packingResult.gaps.W}mm)</span><span className="font-bold text-sky-600">{packingResult.stats.planB.sheetsW} {t.sheets}</span></div>
                            <div className="flex justify-between text-xs mb-2"><span className="text-slate-500">H向 ({packingResult.gaps.H}mm)</span><span className="font-bold text-sky-600">{packingResult.stats.planB.sheetsH} {t.sheets}</span></div>
                            <div className="border-t border-sky-50 pt-2 flex justify-between items-end">
                              <span className="text-[9px] text-slate-400 leading-tight">{t.totalSuggest}<br/>{t.crumpleRate}</span>
                              <span className="text-2xl font-black text-sky-700">{packingResult.stats.planB.total} <span className="text-xs">{t.sheets}</span></span>
                            </div>
                          </div>
                        </div>

                        {/* ===== 方案 C (層疊鋪底) ===== */}
                        <div className={`col-span-1 border rounded-xl p-4 flex flex-col justify-between ${packingResult.stats.recommendedPlan==='C'?'bg-indigo-50 border-indigo-300 best-plan-glow shadow-md':'bg-slate-50 border-slate-200 opacity-80 hover:opacity-100 transition'}`}>
                          <div>
                            <div className="flex justify-between items-start mb-2">
                              <h4 className="font-bold text-indigo-900 text-sm leading-tight">{t.methodC}</h4>
                              {packingResult.stats.recommendedPlan==='C'&&<span className="bg-indigo-600 text-white text-[10px] px-2 py-0.5 rounded font-bold shrink-0 shadow flex items-center"><StarIcon className="w-3 h-3 mr-0.5"/> {t.recommendBadge}</span>}
                            </div>
                            <div className="w-full h-32 mb-4 bg-white/70 rounded-lg border border-indigo-100/60 flex items-center justify-center text-indigo-400 shadow-sm overflow-hidden">
                              <LayeredUWrapIcon className="h-full w-full max-w-[80%] text-indigo-500"/>
                            </div>
                            <p className="text-[12px] text-indigo-700/90 leading-relaxed mb-4 font-medium tracking-wide">{t.methodCDesc}</p>
                          </div>
                          <div className="bg-white rounded-lg p-2 border border-indigo-100/50 shadow-inner">
                            <div className="flex justify-between text-xs mb-1"><span className="text-slate-500">{t.methodC_bottom}</span><span className="font-bold text-indigo-600">{packingResult.stats.planC.nBottom} {t.sheets}</span></div>
                            <div className="flex justify-between text-xs mb-2"><span className="text-slate-500">{t.methodC_top}</span><span className="font-bold text-indigo-600">{packingResult.stats.planC.nTop} {t.sheets}</span></div>
                            <div className="border-t border-indigo-50 pt-2 flex justify-between items-end">
                              <span className="text-[10px] text-slate-400 font-bold">{t.totalSuggest}</span>
                              <span className="text-2xl font-black text-indigo-700">{packingResult.stats.planC.total} <span className="text-xs">{t.sheets}</span></span>
                            </div>
                          </div>
                        </div>

                      </div>
                    </div>
                  </div>
                )}

                {/* 3D Canvas */}
                <div className="bg-white p-2 rounded-xl shadow-sm border border-slate-200 relative flex-grow min-h-[450px]">
                  <div ref={canvasRef} className="w-full h-full rounded-lg bg-slate-100 overflow-hidden cursor-move"></div>
                  {packingResult.packed.length>0&&(
                    <div className="absolute bottom-4 left-4 right-4 bg-white/90 p-3 rounded-lg shadow-md flex flex-col sm:flex-row items-center gap-4 z-20 border border-slate-200 backdrop-blur">
                      <div className="flex items-center space-x-4">
                        <span className="text-blue-700 font-bold text-sm bg-blue-50 px-2 py-1 rounded">{renderStep} / {packingResult.packed.length}</span>
                        <label className="flex items-center space-x-2 cursor-pointer text-sm"><input type="checkbox" checked={isTransparent} onChange={e=>setIsTransparent(e.target.checked)}/><span>{t.xrayLabel}</span></label>
                      </div>
                      <input type="range" min="0" max={packingResult.packed.length} value={renderStep} onChange={e=>setRenderStep(Number(e.target.value))} className="w-full h-2 bg-slate-200 rounded-lg accent-blue-600 cursor-pointer"/>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>

          {isHelpModalOpen && <HelpModal t={t} onClose={()=>setIsHelpModalOpen(false)}/>}
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App/>);
  </script>
</body>
</html>
